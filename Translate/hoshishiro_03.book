            },
            {
              "rowIndex": 1551,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "～……。",
                  "",
                  "02_karuha/kar1215.ogg",
                  "MessageWindow",
                  "～……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1552,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　カルハが足を止めた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶停下了脚步。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1553,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　気持ちは分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　能理解她的心情。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1554,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1555,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺も、まだこの駅を出たくない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我也还不想离开这个车站。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1556,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　未知のエリアへ進むよりは、この駅。\n　ねりちゃんがまた現れるかもしれないここに留まりたい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　与前往向未知的地方相比，我更想留在这个车站。\n　留在这个小音可能会再次出现的地方。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1557,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　だからあいつの、お姉さんの幻が現れるかもしれない\n　場所に留まりたい気持ちは分かるが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　所以她大概也在想，\n　如果留在这里也许还能再看到姐姐的幻影吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1558,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
