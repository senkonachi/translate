              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　清爽な風のド真ん中に、弾丸の速度で飛び込んでいる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不如说我正以子弹般的速度在清风里穿梭。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 17,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　夜汽車の旅。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　深夜火车之旅。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 18,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いいもんだな。旅に出るのも。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　旅行着实令人享受。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 19,
