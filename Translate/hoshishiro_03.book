                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3213,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お高い入院費払ってるからって、この階はとくに\n衛生関係がうるさく言われるってお姉ちゃんが言ってた。",
                  "",
                  "02_karuha/kar1133.ogg",
                  "MessageWindow",
                  "姐姐说那些人在这里住院花了很多的钱，\n所以卫生方面的事要求格外严格。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3214,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3215,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それは……衛生関係厳しくしないといけない\n注意の必要な患者が入るから、入院費も高くなるって\nだけなんじゃ？",
                  "",
                  "",
                  "MessageWindow",
                  "应该是……是因为住着对卫生方面需要严格要求的患者，\n所以住院费用才特别高吧？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3216,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "逸らし目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3217,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "MoveBy",
                  "y=-10 time=1.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3218,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あー、かな。",
                  "",
                  "02_karuha/kar1134.ogg",
                  "MessageWindow",
                  "啊，大概吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3219,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お姉さんのほうも微妙にズレてるな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　姐姐的认知也稍微有点偏差啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3220,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3221,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　この階は、とくに衛生管理が徹底されている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这个楼层的卫生管理确实格外严格。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3222,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　見れば他の階とちがって、一部屋一部屋の\n　扉が閉められていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　和其他楼层不一样，\n　这里所有的房间的门都紧紧关闭着。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3223,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いわゆる個室制。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就是所谓的单人病房。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3224,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここか……？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就是这里吗……？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3225,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ひとつひとつ見ていくと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我挨个房间看了过去。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
