              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 834,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだ。\n　なんのことだ。",
                  "",
                  "",
                  "MessageWindowMono",
