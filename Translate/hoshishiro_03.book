            },
            {
              "rowIndex": 230,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "タカセ、どうだ？",
                  "",
                  "",
                  "MessageWindow",
                  "鹰世，你怎么看？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 231,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　知恵役に頼ってみた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　得问问我们的智囊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 232,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 233,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "呆れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そうですね、これはただの予想ですが。",
                  "",
                  "06_takase/tak0605.ogg",
                  "MessageWindow",
                  "这个嘛，根据我的猜测……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 234,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
