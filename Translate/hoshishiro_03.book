            },
            {
              "rowIndex": 454,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "僕の故郷は、小笠原諸島の父島ですので。",
                  "",
                  "06_takase/tak0453.ogg",
                  "MessageWindow",
                  "因为，我的故乡在小笠原群岛的主岛上。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 455,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "え……。",
                  "",
                  "",
                  "MessageWindow",
                  "哎……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 456,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "通常",
                  "",
                  "",
                  "",
                  "",
