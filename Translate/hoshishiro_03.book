              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　生ぬるい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　湿湿热热的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
