              "rowIndex": 1827,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それは消極的な自殺だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　简直就是慢性自杀。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
