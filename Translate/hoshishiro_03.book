            },
            {
              "rowIndex": 9,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うん？",
                  "",
                  "",
                  "MessageWindow",
                  "嗯？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 10,
              "strings": {
                "Array": [
                  "Bgm",
