            },
            {
              "rowIndex": 375,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……まあ。\nだってあたしの声でとったプラネタリウムがあったし。",
                  "",
                  "05_hanae/han0336.ogg",
                  "MessageWindow",
                  "嗯……是吧。\n因为有记录我声音的天象馆在。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 376,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
