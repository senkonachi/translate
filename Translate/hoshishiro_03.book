            },
            {
              "rowIndex": 1736,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お化けが出た。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　妖怪蹿出来了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1737,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それ自体は確かに怖いだろうが、\n　でも『出た』時点で認識はできる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这诚然是件可怕的事情，\n　但至少能在蹿出来的时候知道是怎么回事。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
