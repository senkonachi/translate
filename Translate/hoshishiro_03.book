              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 709,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワールなに食べてるの？",
                  "",
                  "02_karuha/kar0551.ogg",
                  "MessageWindow",
                  "诺瓦，你在吃什么啊？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 710,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "たまねぎです。もくもく。",
                  "",
                  "01_noir/noi0412.ogg",
                  "MessageWindow",
                  "洋葱。嚼嚼。",
                  ""
