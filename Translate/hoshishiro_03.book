                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょうどそこで、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就在这时……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
