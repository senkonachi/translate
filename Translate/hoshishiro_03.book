              "isCommentOut": 0
            },
            {
              "rowIndex": 1498,
              "strings": {
                "Array": [
                  "",
                  "看護師",
                  "<Character=猫村姉>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "真白さん、どうかされましたか。",
                  "",
                  "99_mob/nan/nan0019.ogg",
                  "MessageWindow",
                  "真白小姐，怎么了？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1499,
              "strings": {
                "Array": [
                  "StopSe",
                  "",
                  "",
