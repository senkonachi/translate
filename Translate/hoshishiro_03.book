                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　苦笑するタカセ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世苦笑起来。",
                  ""
