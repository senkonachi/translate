                  "",
                  "",
                  "……なんでしょう。",
                  "",
                  "01_noir/noi0018.ogg",
                  "MessageWindow",
                  "……有什么事吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1351,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そーっと椅子の影からこっちを見てくる彼女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她从座位后面探出头来看着我。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1352,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "困り目逸らし",
                  "",
                  "",
                  "",
