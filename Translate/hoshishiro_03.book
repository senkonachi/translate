            },
            {
              "rowIndex": 2307,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2308,
              "strings": {
                "Array": [
                  "",
                  "真白大",
                  "不満そう",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2309,
              "strings": {
                "Array": [
                  "",
                  "少女",
                  "<Character=真白大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "07_mashiro/mas0002.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2310,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここのプラネタリウムの人、ではないよな。\n　そんな歳じゃない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　应该不是这座天象馆的工作人员吧。\n　年龄还太小。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2311,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ、なんとなく思った。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只是，不知不觉这样想到。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2312,
              "strings": {
                "Array": [
                  "",
                  "真白大",
                  "閉じ目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2313,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　他の客でもない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这里又没有别的客人。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2314,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここの人でも、ここに来た人でもなく、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　既非这里的工作人员，亦非参观的来客，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2315,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺に用があるんだろうって。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　应该是找我有事吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2316,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……つか、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……话说回来，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2317,
              "strings": {
                "Array": [
                  "Tween",
                  "真白大",
                  "MoveBy",
                  "y=-10 time=2",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2318,
              "strings": {
                "Array": [
                  "",
                  "少女",
                  "<Character=真白大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "07_mashiro/mas0003.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2319,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　肌の色は、蝋のように今にも溶け砕けてしまいそうな白。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　肌肤苍白如蜡，随时都可能溶解。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2320,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　合わせて髪の色も白く、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　头发也与肤色相宜，呈现白色，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2321,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも白髪ってやつじゃない。\n　艶っ気はちゃんとあり生命力を感じさせる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但不是褪色造成的白发。\n　从光泽中能感受到生命力。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2322,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　銀髪。というのが近いか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　说是银发可能更贴切一些。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2323,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そしてそこまで色素を否定しておいて、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　以及明明浑身上下都在否定着色素的存在，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2324,
              "strings": {
                "Array": [
                  "",
                  "真白大",
                  "敵対A",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
