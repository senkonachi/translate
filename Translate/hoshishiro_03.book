            },
            {
              "rowIndex": 202,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Character=ねり大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あの子どうなっちゃったんだろ。\nここにはいないみたいだけど。",
                  "",
                  "03_neri/ner0387.ogg",
                  "MessageWindow",
                  "她怎么了呢。\n好像不在这里的样子。"
