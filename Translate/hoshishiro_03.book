              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1048,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "人間ってのは、\n生きてるだけで誰かしらの迷惑になってるものだ。",
                  "",
                  "",
                  "MessageWindow",
                  "人只要活着肯定就会给别人添麻烦。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1049,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "誰にも迷惑かけず生きられる人間なんて１人もいない。",
                  "",
                  "",
                  "MessageWindow",
                  "没有任何人能不给人添麻烦地活在世上。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1050,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "目閉じ悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1051,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
