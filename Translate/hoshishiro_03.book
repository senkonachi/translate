                  "",
                  "",
                  "",
                  "",
                  "",
                  "……です。",
                  "",
                  "01_noir/noi1090.ogg",
                  "MessageWindow",
                  "……是的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2146,
              "strings": {
                "Array": [
