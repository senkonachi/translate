                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　とっくに自覚はある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我早就有所察觉了。"
                ]
              },
              "isEmpty": 0,
