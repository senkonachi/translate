            },
            {
              "rowIndex": 1947,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi0502.ogg",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1948,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ねえ、シロさん？",
                  "",
                  "01_noir/noi0503.ogg",
                  "MessageWindow",
                  "那个，白先生？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1949,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うん？",
                  "",
                  "",
                  "MessageWindow",
                  "嗯？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1950,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "シロさんはどうして、いろいろなことを\nわたしに教えてくれるんですか？",
                  "",
                  "01_noir/noi0504.ogg",
                  "MessageWindow",
                  "白先生为什么要教我各种事情呢？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1951,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……いや。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯……不。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1952,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　教えてるつもりはないんだが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我本没打算教她的，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1953,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも……まあ、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是……嗯，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1954,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント7_b_大",
                  "",
                  "",
                  "",
                  "360",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1955,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そのままだよ。ただ、経験して欲しいんだ。",
                  "",
                  "",
                  "MessageWindow",
                  "没什么啊。只是，想让你也体验看看。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1956,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "けいけん……ですか？",
                  "",
                  "01_noir/noi0505.ogg",
                  "MessageWindow",
                  "体验……吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1957,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そ。",
                  "",
                  "",
                  "MessageWindow",
                  "对。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1958,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "色んなことを経験して欲しい。\n怖がらずに、色んなことを。",
                  "",
                  "",
                  "MessageWindow",
                  "希望你体验各种事情。\n勇于体验各种事情。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1959,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "綺麗なもの。美味しいもの。どきどき、わくわく、\n怖いものも、嫌なものでもいい。",
                  "",
                  "",
                  "MessageWindow",
                  "美丽的，好吃的。令人心动的、令人兴奋的、\n令人害怕的，让人讨厌的也得经历经历。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1960,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お前の心を揺らすものを、たくさん経験してほしい。",
                  "",
                  "",
                  "MessageWindow",
                  "我想让你多多能够体验触动你内心的东西。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1961,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント7_a_大",
                  "",
                  "",
                  "-250",
                  "-200",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1962,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi0506.ogg",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1963,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "よく分かりません。",
                  "",
                  "01_noir/noi0507.ogg",
                  "MessageWindow",
                  "不是很明白。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1964,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それでいいよ。",
                  "",
                  "",
                  "MessageWindow",
                  "这样就好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1965,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント7_a",
                  "",
                  "",
                  "0",
                  "0",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1966,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　言葉で言って分かることじゃないんだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这不是语言能描述清楚的感受。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1967,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　現に俺も、大学のころまでは分からなかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我在上大学之前也不明白。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1968,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　美術の先生が言ってた、感性を磨けとか、\n　たくさんのものに触れろとか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　美术老师曾说为了磨炼感性，\n　让我去接触各种事物。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1969,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　当時はただの教育文句だと思ってたが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　当时我以为那只不过是空谈，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1970,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ大人になるにつれ、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可随着年龄增长，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1971,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　仕事に追われるにつれ、その意味が分かってくる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　又到了开始工作之时，我便明白了其中的含义。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1972,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　大人になると。\n　毎日変わらない仕事に追われるようになると。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　长大成人后。\n　每天都要干着一成不变的工作。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1973,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　新しいことを受け入れる感性が薄れてくる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　接受的新生事物越少，人的感性就越弱。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1974,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　老いというやつだろうか？　分からないけど、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这就是变老吧？　我也不是很明白，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1975,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　新しい景色を見ても、新しいものを食べても、\n　それは過去にあった何に似ているか。みたいな分析を\n　脳が勝手に初めてしまう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就算遇到新生事物，\n　大脑也会悄然运转，\n　分析它与哪些记忆相似。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1976,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　勝手に過去の体験と重ねて、それで納得してしまう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　与过去的经历拟合，再淡然接受。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1977,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント7_b_大",
                  "",
                  "",
                  "",
                  "360",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1978,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　線香花火を見たって、過去への郷愁を感じるだけで\n　純粋にその輝きに感動することもない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看了线香烟花，也只会沉浸在对于过去愁闷的感伤中，\n　而不会心无旁骛地被那光辉感动。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1979,
              "strings": {
                "Array": [
                  "BgEventOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1980,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_空_夜",
                  "",
                  "",
                  "0",
                  "0",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1981,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　世界はキラキラの詰まった宝石箱かもしれないが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这个世界或许就是个装满熠熠生辉的宝石的宝石箱，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1982,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　キラキラに価値を感じられなくなる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我却逐渐感受不到宝石的价值。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1983,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それはもう仕方のないことだ。\n　大人になるってそういうことだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我已成定局。\n　或许这就是成长的代价。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1984,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント7_a",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1985,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でもノワールはちがう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可诺瓦不一样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1986,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なにかを綺麗だと思う。美味しいと思う。",
                  "",
                  "",
                  "MessageWindow",
                  "觉得什么东西美丽，什么食物好吃。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1987,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "出来るだけ経験してほしい。",
                  "",
                  "",
                  "MessageWindow",
                  "我希望你可以尽可能地去体验这些。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1988,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……できなかった子もいるから。",
                  "",
                  "",
                  "MessageWindow",
                  "……因为很多人体验不到。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
