                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1083,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まずはどこからかは……もう決めてるだろ？",
                  "",
                  "",
                  "MessageWindow",
                  "先从哪里开始……已经决定了吧？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1084,
              "strings": {
                "Array": [
