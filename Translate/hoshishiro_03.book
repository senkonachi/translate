            },
            {
              "rowIndex": 1579,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。\nもちろん、前後を暗記しているためですけど。",
                  "",
                  "06_takase/tak0419.ogg",
                  "MessageWindow",
                  "是的。\n当然，我前后文都背下来了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1580,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　また苦笑してみせた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世苦笑道。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1581,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　目線は何度も同じページを追っている。",
                  "",
