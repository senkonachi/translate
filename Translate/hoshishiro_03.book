              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2183,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ケラケラ笑うカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶放声大笑。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2184,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　怒りっぽいやつだけど、単純で素直なので\n　こうして話してる分には楽しかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽说她容易惹人生气，不过本性单纯又率直，\n　跟她聊天出乎意料地开心。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2185,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それに、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　还有一点，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
