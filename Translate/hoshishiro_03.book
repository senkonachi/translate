                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1527,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さらに背中が強ばったような。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　感觉她的后背紧绷了起来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1528,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　緊張してるのかな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是在紧张么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1529,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1530,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "えと……あ、そうそう、それで。",
                  "",
                  "01_noir/noi0984.ogg",
                  "MessageWindow",
                  "那个……啊，对了对了，然后。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1531,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "わたし、は、生まれつきそんなで。\n真白という名前もお母さんがそれでつけてくれて。",
                  "",
                  "01_noir/noi0985.ogg",
                  "MessageWindow",
                  "因为我出生时就这样。\n妈妈就给我取了真白这个名字。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1532,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_b",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1533,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "身体も弱いんです。よく、病院へ。",
                  "",
                  "01_noir/noi0986.ogg",
                  "MessageWindow",
                  "我身体很弱。经常去医院。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1534,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "やっぱアルビノの人ってそうなのか？",
                  "",
                  "",
                  "MessageWindow",
                  "果然白化病患者身体都很虚弱吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1535,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい、紫外線が毒になるとかで。",
                  "",
                  "01_noir/noi0987.ogg",
                  "MessageWindow",
                  "对的。紫外线会伤害我们。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1536,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そのせいか歳があがるにつれて疲れやすくなって、\n息切れや、食べるものもあまり。",
                  "",
                  "01_noir/noi0988.ogg",
                  "MessageWindow",
                  "因此随着年龄增长会变得容易累，喘不过气，食量也小。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1537,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "とくに心臓が悪いとかで、最近はもう\nずっと入院していたんです。",
                  "",
                  "01_noir/noi0989.ogg",
                  "MessageWindow",
                  "特别是心脏好像有点问题，\n最近一直在住院。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1538,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1539,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　心臓……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　心脏……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1540,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "大変だなそれは。",
                  "",
                  "",
                  "MessageWindow",
                  "那很难受吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1541,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_a",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1542,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いえあの、入院自体はそんなに。\nうちのおじいさま、大きな病院のお医者様で、\nそこに入っただけですから。",
                  "",
                  "01_noir/noi0990.ogg",
                  "MessageWindow",
                  "没有的，住院本身没多难受。\n爷爷是一所大医院的医生，我也只是去那住院而已。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1543,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1544,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おじいさまが毎日見に来てくださいますし、\n看護師のみなさんも優しくしてくださって。",
                  "",
                  "01_noir/noi0991.ogg",
                  "MessageWindow",
                  "爷爷每天都会来看我，\n护士姐姐们也都对我很好。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1545,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_b",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
