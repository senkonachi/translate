                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　立ち上がる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我站了起来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 484,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここは第一車両。\n　んであっちが車掌ちゃんの入っていった、ボイラー室。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这是第一节车厢。\n　前面是那位娇小乘务员进入的锅炉室。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
