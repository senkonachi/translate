                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　この旅に出て、俺たち以外で会った人は、\n　２人いる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　当我们启程的时候，除我们以外，\n　还有两个人。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 209,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "敵対A",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
