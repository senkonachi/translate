              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールとカルハは、俺たちよりちょっと前に\n　こっち側へ下りた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　总结一下现状。\n　诺瓦和狩叶先我们一步去了那条路。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 919,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　道は一本。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　在路只有一条且是个环形的情况下，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 920,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どっちへ向かったかは分からないが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　即便不知道她们是朝哪边走的，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
