                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　生きることと、そうでなくなることのどちらがいいか、\n　分からないまま。\n　ただ俺に言われるとおり生きる方へ流された。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她并不知道是活着好，\n　还是不活了比较好。\n　只是按照我说的，偏向了活着的一方。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1028,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　Ｔｏ　ｂｅ，ｏｒ　ｎｏｔ　ｔｏ　ｂｅ．\n　迷ってるままだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　To be or not to be.\n　她还很迷惘。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1029,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1030,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_白",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1031,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それでいい。",
                  "",
                  "",
                  "MessageWindow",
                  "这样就好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1032,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それが普通。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这很正常。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1033,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　普通の大人だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一般大人也这样。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
