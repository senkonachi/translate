            },
            {
              "rowIndex": 718,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
