            },
            {
              "rowIndex": 698,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "スウェーデン。",
                  "",
                  "04_jibie/jib0046.ogg",
                  "MessageWindow",
                  "瑞典。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 699,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だいぶ北の方ですね。",
                  "",
                  "",
                  "MessageWindow",
                  "真靠北呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 700,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　北海道よりさらに北。\n　日本人としてはピンと来ない地形だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　比北海道还要偏北。\n　日本人很难对那类地区有概念。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 701,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 702,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも話は聞いたことある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过听人提起过。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 703,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 704,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あっちは、アレですよね。空気が乾燥してて。",
                  "",
                  "",
                  "MessageWindow",
                  "那边是不是，空气很干燥来着？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 705,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ",
                  "PunchPosition",
                  "y=30 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 706,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ハイ、カサカサなので、よく火事になりマス。",
                  "",
                  "04_jibie/jib0047.ogg",
                  "MessageWindow",
                  "是的，干燥得很，经常会发火灾。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 707,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　聞いたことがある。\n　北国と日本の最大のちがいは、湿度だと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我听说过。\n　北地与日本最大的区别，就是湿度。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 708,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "目閉じ悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 709,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 710,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　湿度がちがうから、例えば気温が３０度といっても\n　日本とでは全然違うらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　由于湿度差异，\n　哪怕气温都是30℃两地的情况也完全不一样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 711,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 712,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　日本の３０度はもう汗が吹き出しクーラーがいる温度だが、\n　湿度の低い地方では風にあたる程度でいいそうな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　30℃的情况下日本已经热得人满头大汗了，室内还得开空调，\n　但在湿度低的地方靠自然风就能有效降温了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 713,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 714,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただしその分、乾燥しすぎて肌には悪いし\n　木々は限界まで水気を失って\n　風で葉がこすれる静電気だけで山火事になるとか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过空气太干对皮肤很不好，\n　而且树木的含水量会降到最低，\n　甚至树叶在风中摩擦产生的静电都有可能酿成火灾。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 715,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それでも、日本人としちゃ羨ましいけどな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然而身为日本人的我依旧很羡慕。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 716,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "北欧からだと、日本の夏は厳しいんじゃないですか？",
                  "",
                  "",
                  "MessageWindow",
                  "既然是北欧人，来日本度夏会不会很煎熬？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 717,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "目閉じ悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 718,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ",
                  "PunchPosition",
                  "x=30 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
