              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 711,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "かへっ、けふんっ。",
                  "",
                  "01_noir/noi0413.ogg",
                  "MessageWindow",
                  "嘎呼，咳咳。",
