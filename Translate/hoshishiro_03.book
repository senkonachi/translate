                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああそうそう。\n汽車のなか見て回って来たんだけどさ。",
                  "",
                  "",
                  "MessageWindow",
                  "啊，说起来，\n我刚在车里兜了一圈。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1003,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "このツアーって……人数かなり少なくない？",
                  "",
                  "",
                  "MessageWindow",
                  "这趟旅行……旅客是不是太少了？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
