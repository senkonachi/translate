            },
            {
              "rowIndex": 751,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "やはり大勢で乗り合わせる仕組み……。ふむ。",
                  "",
                  "06_takase/tak0014.ogg",
                  "MessageWindow",
                  "看来同乘者还挺多的……嗯。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 752,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 753,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　タカセは知らない模様。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看来鹰世并不知道详情。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 754,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人数はともかく、少ないのは間違いなさそうだな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不管总人数有多少，反正多不过我刚刚提到的数了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 755,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 756,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
