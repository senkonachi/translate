                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 960,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんとなく前へ進んだだけなのだが、\n　すごいものを見つけてしまった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我本是随意逛悠，\n　没想到竟能碰见这么个不得了的东西。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 961,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ボイラーだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是锅炉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
