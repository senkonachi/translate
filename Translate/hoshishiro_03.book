              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "こんなに楽しいの、生まれて初めてです。",
                  "",
                  "01_noir/noi1032.ogg",
                  "MessageWindow",
                  "这还是我生下来头一回这么开心。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1740,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そか。",
                  "",
                  "",
                  "MessageWindow",
                  "是么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1741,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　言えない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是说不出口。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1742,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　不安にさせることなんて何も言いたくない。\n　このまま楽しんで欲しい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我不想说这些话让她不安。\n　想让她就这样开开心心地继续旅行。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
