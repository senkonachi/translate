            },
            {
              "rowIndex": 1960,
              "strings": {
                "Array": [
                  "",
                  "アナウンス",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ようこそみなさん、お星様の世界へ。",
                  "",
                  "05_hanae/han0204.ogg",
                  "MessageWindow",
                  "欢迎各位来到星空的世界。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1961,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　アナウンスが入る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　开始广播了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1962,
              "strings": {
