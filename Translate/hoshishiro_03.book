                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それに……あ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而且……啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
