              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2234,
              "strings": {
                "Array": [
                  "Tween",
                  "Graphics",
                  "PunchPosition",
                  "y=-15 time=2",
                  "easeInQuad",
