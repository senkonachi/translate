                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ、でもしばらく無理そう。",
                  "",
                  "02_karuha/kar0326.ogg",
                  "MessageWindow",
                  "啊，不过一会可能就没法画了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1444,
              "strings": {
                "Array": [
                  "",
