              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ねりちゃんの声を聞いたのは……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那是我最后一次听到……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 220,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あれが最後だった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　小音的声音。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 221,
              "strings": {
                "Array": [
                  "",
                  "大家さん",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だから、ね？\n警察からおかしな電話がかかってきてね。",
                  "",
                  "99_mob/ooy/ooy0001.ogg",
                  "MessageWindow",
                  "所以说啊？\n警察给我打了个奇怪的电话。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 222,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はあ。",
                  "",
                  "",
                  "MessageWindow",
                  "是吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 223,
              "strings": {
                "Array": [
                  "",
                  "大家さん",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ねりが……あの子が事故にあったって。",
                  "",
                  "99_mob/ooy/ooy0002.ogg",
                  "MessageWindow",
                  "说音理……那孩子遭遇事故了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 224,
              "strings": {
                "Array": [
                  "",
