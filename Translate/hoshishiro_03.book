                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1529,
              "strings": {
                "Array": [
                  "Se",
                  "SE014",
                  "TRUE",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1530,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　生きてる最中も思ってたな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　越是活着越是觉得痛苦。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1531,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あのうだるような暑さ。\n　あれが毎日の繰り返しだった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　闷热的天气令人怠惰。\n　每天每天都是如此。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1532,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　毎日必ずどこかが痛くて。\n　気温が変わればすぐにくしゃみやせきが出て。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　每天身体总会有某些部位感到疼痛。\n　气温一变化就容易打喷嚏或咳嗽。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1533,
              "strings": {
                "Array": [
                  "StopSe",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1534,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント1_b",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1535,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あんなに快適だったのはいつぐらいぶりだったろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　身体感到舒适，到底是多久之前的事呢。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1536,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　生まれて初めてだったかもしれない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　也许那是我生来第一次。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
