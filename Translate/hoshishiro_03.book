              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "見てて辛いから変わろうか？",
                  "",
                  "",
                  "MessageWindow",
                  "都不忍心看了，要我替你讲吗？",
