            },
            {
              "rowIndex": 1851,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ああ、そうだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1852,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここはあの子の世界。\n　拒否されたらもう辿りつけない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这里是她的世界。\n　被拒绝意味着已经无法到达。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1853,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でもそんな心配はなかったな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是我原先并不担心。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1854,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　拒絶反応で苦しんでいるのは知ってる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我知道她正因为排异反应而痛苦。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1855,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でもあいつが、俺たちを拒否するなんて。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是没想到她居然会拒绝我们啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1856,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1857,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワール。",
                  "",
                  "",
                  "MessageWindow",
                  "诺瓦。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1858,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　問題は、たどり着くのに必要な駅が、線路がないこと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　问题是，能让我到达的车站和铁路都不存在。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1859,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　道がないことだけど、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　既然没有道路，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1860,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　道を教えてもらうなら、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那就让她给我们指明道路，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
