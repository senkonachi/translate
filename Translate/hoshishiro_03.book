                  "01_noir/noi0516.ogg",
                  "MessageWindow",
                  "没有那种事情。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2173,
              "strings": {
