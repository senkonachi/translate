                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1205,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　と……下のほう。なんだあれ？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然后我注意到……山上的那是什么？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1206,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　建物がある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是一座建筑。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1207,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そんなに大きくはないけど、\n　家、っていうか、施設って感じの大きさ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　体量并不大，\n　与其说是民居，不如说更像养老院之类的设施。"
                ]
