                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　やれやれ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真是的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
