                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ところで、だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　话说回来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1855,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺が連れ立ったこの風景。\n　この風景は自信をもってよいものだと胸を張れるながら、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我是很有信心\n　将这幅美景分享与她的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1856,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
