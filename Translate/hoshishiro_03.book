                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ……。",
                  "",
                  "02_karuha/kar0719.ogg",
                  "MessageWindow",
                  "啊……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1051,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
