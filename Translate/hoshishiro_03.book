                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 960,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>少し驚き",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おや。",
                  "",
                  "06_takase/tak0219.ogg",
                  "MessageWindow",
                  "哦呀。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 961,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "っと……。",
                  "",
                  "",
                  "MessageWindow",
                  "不好意思……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 962,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　つい湿っぽいものが漏れてしまった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我又不小心吐苦水了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 963,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "目開き真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 964,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　会ったばかりのやつに愚痴る内容じゃない。\n　俺としたことが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不应该对刚认识不久的人说这种牢骚话。\n　真是失败。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 965,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 966,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
