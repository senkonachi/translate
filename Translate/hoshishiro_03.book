              "rowIndex": 703,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　異様だ。\n　森や海ならともかく、街中では完全にホラーだな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不对劲。\n　森林和海边没人还好说，镇子空无一人实在是很惊悚。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
