                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　喔，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 851,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっき渡したスケブが置いてある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚才送人的写生本搁在了这里。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 852,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ガタガタ揺れる車内では書きにくかったんだろう。\n　ヘンテコな円が描かれて、\n　数字がいくつか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　在晃来晃去的车里估计也不好写字。\n　上面画了奇怪的圆，\n　还写了几个数字。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 853,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　文字はガタついててよく読めない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　文字歪七扭八的，根本看不懂。",
                  ""
