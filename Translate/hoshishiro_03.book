            },
            {
              "rowIndex": 2574,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　気に入ってる模様。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看样子她很中意。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2575,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お上品な舌の持ち主のようだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　舌尖一定非常雅致。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2576,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "y=10 time=1",
