              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　近くに座るカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶坐在我身旁。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1476,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　２人、なんとなく光源となるボイラーへ目が向く。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我们的视线不由自主地朝向了唯一的光源——锅炉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
