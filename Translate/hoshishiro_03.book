                  "",
                  "",
                  "",
                  "",
                  "",
                  "そ、それもすごいことですよ。",
                  "",
                  "01_noir/noi1151.ogg",
                  "MessageWindow",
                  "但、但这也很了不起的。"
                ]
              },
