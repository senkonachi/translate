            },
            {
              "rowIndex": 3205,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ、ここガチで近づいちゃいけないって\nお姉ちゃんに念押しされた階だわ。",
                  "",
                  "02_karuha/kar1131.ogg",
                  "MessageWindow",
                  "啊，这里是姐姐反复强调过千万不能随便接近的楼层。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3206,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3207,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なにかあるのか？",
                  "",
                  "",
                  "MessageWindow",
                  "这层是做什么用的？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3208,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "この階の入院患者さんは、全部ＶＩＰ待遇なんだって。",
                  "",
                  "02_karuha/kar1132.ogg",
                  "MessageWindow",
                  "听说在这层住院的患者，全都是VIP待遇。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3209,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3210,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "入院に……ＶＩＰ？",
                  "",
                  "",
                  "MessageWindow",
                  "住院……VIP？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
