            },
            {
              "rowIndex": 2109,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "わたしもあんなふうになれたらなあ。",
                  "",
                  "01_noir/noi1082.ogg",
                  "MessageWindow",
                  "要是我也能像那样就好了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2110,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　目を細めてるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦眯上眼睛。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2111,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あんなふうに……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　像那样……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2112,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あんまりオススメしないけどな。\n　いきなり首しめられたり。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过我可不怎么推荐。\n　会被突然勒脖子的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2113,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "幸せ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2114,
