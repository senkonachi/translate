                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2399,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi0701.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2400,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どのくらいなら怒らない。どのくらいなら笑い話になる。\nそこらへんの線引きは、まあ個人によりけりだけど。",
                  "",
                  "",
                  "MessageWindow",
                  "做到哪个程度不会惹对方生气。\n做到哪个程度会被别人当成开玩笑来对待。\n具体如何区分还是要看个人。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2401,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いまのでカルハがそんなに怒ると思うか？",
                  "",
                  "",
                  "MessageWindow",
                  "狩叶刚刚在怒吼，你觉得她非常生气吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2402,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目「えっと…」",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2403,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール",
                  "PunchPosition",
                  "x=30 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2404,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いいえ。",
                  "",
                  "01_noir/noi0702.ogg",
                  "MessageWindow",
                  "不。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2405,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し驚き",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2406,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2407,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そう。それは、カルハへの信頼があるからだ。",
                  "",
                  "",
                  "MessageWindow",
                  "没错。那是因为你信赖狩叶。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2408,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2409,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　笑って済ませられる線引きは、お互いの信頼感で変わる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　做到什么程度能够一笑而过，会根据彼此的信赖度不同而变化。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2410,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールはそれを知らない。\n　だから前は、俺とカルハのやりとりを見て\n　怯えてしまった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　之前诺瓦对此拿捏不准。\n　当看我和狩叶拌嘴之时，\n　便产生了害怕的感觉。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2411,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いまなら分かるだろう。あれは笑い話だったと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　若是现在她就可以明白了吧。完全可以一笑带过。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2412,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだかんだ年の頃が近いってのは強いな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不管怎么说，年龄相仿的魔力真的挺大。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2413,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2414,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2415,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここにねりちゃんがいれば、もっとスムーズだったろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　若是小音在场应该会更热闹的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2416,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_列車内",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2417,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　花江さんの見たっていうのが何者なのかは\n　結局分からなかったが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　结果还是没有搞清楚，\n　花江小姐看到的人到底是谁。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2418,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールにとってはいい時間だった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过对于诺瓦来说算是一段不错的消遣。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2419,
              "strings": {
