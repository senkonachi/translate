                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1045,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワール！　カルハ！",
                  "",
                  "",
                  "MessageWindow",
                  "诺瓦！　狩叶！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1046,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　大声で呼びながら、奥へ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我边喊边走。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1047,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　木々は鬱蒼と生い茂り、歩くだけでかなり不便だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　树木生长得非常茂密，成为了前进的一大阻碍。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1048,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールは軽装だった。\n　あの格好じゃ歩くだけで怪我するぞ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦的衣服那么薄。\n　在这种林子里很容易被刮伤。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
