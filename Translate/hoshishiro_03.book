              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　目指すべき場所は汽車だけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我的目的地只有火车。",
