                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　他３人とは質がちがう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可是她与其他3人的性质不同。",
                  ""
                ]
