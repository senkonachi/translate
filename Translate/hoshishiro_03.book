                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 200,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あのころはまだちょっと警戒されてたっけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那时候诺瓦还对我抱有一点戒心。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 201,
              "strings": {
