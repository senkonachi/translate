                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　黒い猫。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　黑猫。",
                  ""
                ]
              },
              "isEmpty": 0,
