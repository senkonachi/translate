                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　身体を起こす。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我坐起身来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 698,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっきまでと、肌に触れる空気の感じが変わっている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　肌肤感觉到的气氛变得和刚才不一样了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
