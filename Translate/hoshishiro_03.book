              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1815,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そんなあの子に、俺は何て呼びかけるつもりだ？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我该怎么向一直忍耐痛苦的她搭话？",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1816,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　諦めるな。がんばって生きよう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　别放弃。加油活下去。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1817,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そんなことが言えるのか？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我能说出这种话吗？",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1818,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　無責任に言えるのか？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　能不负责任地说出来吗？",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
