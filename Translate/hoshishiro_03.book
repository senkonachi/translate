              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1266,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ジビエさんとノワールは、しばらくお休みだ。\n　ノワールはもちろんジビエさんも動きたくなさそう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐和诺瓦要稍作休息。\n　二人好像都不想动的样子。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1267,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　で、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那么，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
