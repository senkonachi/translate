            },
            {
              "rowIndex": 1365,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "フフ、そう言われると悪い気はしません。",
                  "",
                  "06_takase/tak0534.ogg",
                  "MessageWindow",
                  "哈哈，被你这么一说确实感觉不错。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1366,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　沈みかけていた表情が戻った。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　消沉的表情消失了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1367,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　落ち込むのはごまかせたか？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　成功让他打起精神来了吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1368,
