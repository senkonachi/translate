            },
            {
              "rowIndex": 3011,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi0357.ogg",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3012,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ……まいったな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过……真头疼啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3013,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールにはノワールの事情がある。\n　親が止めてるなら、安易に口を出すべきじゃないが……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦也有自己的情况。\n　倘若她母亲禁止她吃肉，我也不好随意开口……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3014,
              "strings": {
