              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2581,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なんか意外。\nこの辺だと、おばあちゃんち行くとすぐ出るわよね。",
                  "",
                  "02_karuha/kar0191.ogg",
                  "MessageWindow",
                  "有点意外呢。\n要是去了这一带的老奶奶家，一般都会端这个出来的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2582,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あー、確かにばあちゃんの家には、いつも\n一定数ストックがあるイメージ。",
                  "",
                  "",
                  "MessageWindow",
                  "啊，这么一说，\n我奶奶家里总是会存一些。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2583,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　古い。味が薄い。割高。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　传统。味道清淡。价格虚高。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2584,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　年寄りが進めてくる条件を全てクリアしてる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　满足了老人家把它当块宝的全部条件。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2585,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　かくいうウチの親戚の家にも、行くといつもあった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　同样每次去亲戚家也能看到。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2586,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2587,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　と言ってもそもそもノワール、この辺の子なのか\n　わかんないしな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这么说来，\n　我都不知道诺瓦究竟是不是住这一带的孩子。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2588,
              "strings": {
