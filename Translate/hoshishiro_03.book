                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　猫？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　猫？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
