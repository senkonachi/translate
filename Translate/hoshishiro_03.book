                  "",
                  "",
                  "",
                  "",
                  "",
                  "　<dash=2>タッ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　<dash=2>嗒。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
