                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　照れちゃったらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　令她感到害羞了吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 392,
              "strings": {
