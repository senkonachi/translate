                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　生きてるうちはなかったかもしれない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　也许在我生命中就不曾感到过。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
