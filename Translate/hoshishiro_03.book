              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2961,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "呆れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……言わないでください。",
                  "",
                  "06_takase/tak0065.ogg",
                  "MessageWindow",
                  "……快别提了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2962,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "さっきの話がしたい。",
                  "",
                  "",
                  "MessageWindow",
                  "我想聊聊之前那件事。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2963,
              "strings": {
