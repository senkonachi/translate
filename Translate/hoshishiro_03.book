                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1194,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ていうかあたしも知らないのよね。\n汽車の中でやることを言われてるだけで、\nどこに行くのかとか。",
                  "",
                  "02_karuha/kar1022.ogg",
                  "MessageWindow",
                  "不如说我也不知道啊。顶多跟我说了该在车里干什么，\n到哪去而已。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1195,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1196,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1197,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　だろうな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　也是啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1198,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつ、次の駅がどんな感じかとかすら知らなかったし、\n　このツアーの内約は全然知らないっぽい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这家伙连下个车站是怎样的都不知道，\n　看来也不知道这趟旅行隐藏着什么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1199,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "逸らし目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1200,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　つまりいまどこを走ってるかも知らないだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　换句话说，她连列车现在正往哪行驶都不清楚吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1201,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつだけ立ち位置が特殊なのは間違いないが、\n　といって俺たちの疑問に答えてくれそうでもなかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她所处的立场毫无疑问是特殊的，\n　不过想让她解答我们的疑问是不可能了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
