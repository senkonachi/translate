                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　静かだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　好安静。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
