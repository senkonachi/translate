                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こくりと頭をさげてみせた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　轻轻把头朝我探了过来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
