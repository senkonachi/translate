                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 93,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……はあ。",
                  "",
                  "",
                  "MessageWindow",
                  "……呼。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 94,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　クーラーもない部屋だけど、\n　日差しを避けて、扇風機を回してるだけでだいぶマシだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　屋里没有空调，\n　不过好歹能遮阳，还能吹吹风扇，也算不错了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 95,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ポケットから汗でちょっと湿った携帯を取り出す。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我从口袋里掏出了被汗液略微沾湿的手机。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 96,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "げっ。",
                  "",
                  "",
                  "MessageWindow",
                  "唉呀。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 97,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　仕事先から大量のメッセージが届いていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　委托方发来了一大串消息。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 98,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちらっと見て、最初に届いたメッセージは\n『申し訳ありません』",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我瞥了一眼，第一条就写着：\n　 \"非常抱歉\"",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 99,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　見ないでも内容は分かったけど、一応確認。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　剩余内容不用看也知道写了什么，姑且确认一下。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 100,
              "strings": {
                "Array": [
                  "",
                  "女の声",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "コンテ作業一時ストップとの監督の指示です。",
                  "",
                  "99_mob/ona/ona0001.ogg",
                  "MessageWindow",
                  "导演吩咐，分镜制作要暂停。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 101,
              "strings": {
                "Array": [
                  "",
                  "女の声",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "仕様が変更になります。確認をお願いします。",
                  "",
                  "99_mob/ona/ona0002.ogg",
                  "MessageWindow",
                  "制作流程有变，请确认。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 102,
              "strings": {
                "Array": [
                  "",
                  "女の声",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "指示があるまで待機してください。",
                  "",
                  "99_mob/ona/ona0003.ogg",
                  "MessageWindow",
                  "请在下一个指示到来前待命。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 103,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はいはい。",
                  "",
                  "",
                  "MessageWindow",
                  "我可谢谢你了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 104,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　携帯を放り投げた。",
                  "",
                  "",
                  "MessageWindowMono",
