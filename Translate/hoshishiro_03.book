            },
            {
              "rowIndex": 3033,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "にーん。",
                  "",
                  "02_karuha/kar1106.ogg",
                  "MessageWindow",
                  "嗯。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3034,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　戻ってきた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　回来了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3035,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　手にニャクルトを持って。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　手上还拿着一瓶妙乐多。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3036,
              "strings": {
