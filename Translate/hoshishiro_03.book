            },
            {
              "rowIndex": 1099,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi0829.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1100,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "昔、わたしが元気のないとき、\nお母さんがこうしてくれました。",
                  "",
                  "01_noir/noi0830.ogg",
                  "MessageWindow",
                  "以前呢，我没精神的时候，\n妈妈会这样做。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1101,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1102,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だからわたしも、したいんです。誰かに。",
                  "",
                  "01_noir/noi0831.ogg",
                  "MessageWindow",
                  "所以我也想为别人这样做。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1103,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……そう。",
                  "",
                  "",
                  "MessageWindow",
                  "……是么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1104,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　花江さんに充てられて……かな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　被花江小姐所影响……么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1105,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こっちとしては、ちょっと恥ずかしい。\n　大の大人が子供に甘やかされるみたいで。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我这边还有点不好意思。\n　就像大人对着小孩撒娇一样。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1106,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント9_a",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
