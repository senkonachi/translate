                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　言葉を失っていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她静静地注视着。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1879,
              "strings": {
