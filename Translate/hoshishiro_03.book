            },
            {
              "rowIndex": 953,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はうう。",
                  "",
                  "01_noir/noi0442.ogg",
                  "MessageWindow",
                  "啊呜呜。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 954,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　胸元を押さえてるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦压着胸口。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 955,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "元気出せ。\nほら、ニャクルト飲むか、冷たくて落ち着くぞ。",
                  "",
                  "",
                  "MessageWindow",
                  "振作一点。\n来，要不要喝妙乐多，冰冰凉凉的很舒服哦。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 956,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "様子を窺う",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 957,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あうあ、ありがとうございます。",
                  "",
                  "01_noir/noi0443.ogg",
                  "MessageWindow",
                  "啊呜啊，非常感谢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 958,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール大",
                  "MoveBy",
                  "y=10 time=0.8",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 959,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　弱々しく手を伸ばしてくる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦费力地伸出手来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 960,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール大",
                  "MoveBy",
                  "y=-10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 961,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　胸焼けに乳酸菌が効くかはしらないが、\n　こういうとき冷たい飲み物は単純に気持ちがいい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然不知道乳酸菌对消化不良是否奏效，\n　但这种时候，喝点冰的东西应该会舒服很多。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 962,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール大",
                  "PunchPosition",
                  "y=-10 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 963,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　くぴくぴとゆっくり飲んでいく。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她小口啜饮着。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 964,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺はそれを見守りながら、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我在一旁静静守望，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 965,
              "strings": {
                "Array": [
                  "CharacterOff",
