            },
            {
              "rowIndex": 772,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ大",
                  "MoveBy",
                  "y=-10 time=2",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
