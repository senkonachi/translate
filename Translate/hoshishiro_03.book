            },
            {
              "rowIndex": 1252,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いまこそこの名探偵カルハ・ラムコネが、\nこの夜行列車ミルキィウェイ花江さん連続殺人事件を\n解決するときよ！",
                  "",
                  "02_karuha/kar0729.ogg",
                  "MessageWindow",
                  "现在正是在下名侦探狩叶・朗姆柯\n妮来解决发生在这辆夜行列车银河号上的花江小姐\n连续杀人事件了！"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1253,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "閉じ目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1254,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "様子を窺う",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1255,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール",
                  "PunchPosition",
                  "x=15 time=2",
                  "easeInQuad",
                  "",
