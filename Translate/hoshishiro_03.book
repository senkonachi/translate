            },
            {
              "rowIndex": 1448,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "またトンネルに入るわ。\nトンネルの中だと、ここ真っ暗になるのよ。",
                  "",
                  "02_karuha/kar0327.ogg",
                  "MessageWindow",
                  "又要进隧道了。\n进隧道后这里就漆黑一片了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1449,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そうなんだ。",
                  "",
                  "",
                  "MessageWindow",
                  "这样啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1450,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　外はもう暗いし、ここは明かりも少ない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　天色已经比较暗了，车内照明也不多。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1451,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1452,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　燃えてるボイラーが光源になったら、\n　手元が見えなくなるからスケブは使いにくい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　若是只剩下锅炉一个光源，\n　采光不够自然没法继续写生了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1453,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1454,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1455,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いいさ別に、急いでるわけでもない。",
                  "",
                  "",
                  "MessageWindow",
                  "没什么关系，我本来也不急着画完。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1456,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　完成させなきゃいけないわけでもないしな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而且也不一定非要画完。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1457,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　スケブを伏せた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我把写生本扣了过来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1458,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1459,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　自分が描きたいから描き、そうでもなきゃやめる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　想画的时候就画，不打算画了就停笔。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1460,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それもいいところだと思う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这也是绘画的乐趣所在。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1461,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　仕事とちがうのは。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　跟工作有天壤之别。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
