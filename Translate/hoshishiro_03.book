                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールが目を輝かせていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦双眼放光。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1998,
              "strings": {
