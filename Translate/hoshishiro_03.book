              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2707,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "探すか。",
                  "",
                  "",
                  "MessageWindow",
                  "去找吗。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
