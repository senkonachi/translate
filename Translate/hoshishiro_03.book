              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 925,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そうして、自分が大人であることを\n　自分自身に言い聞かせてるんだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　像这样做，是为了让自己明白\n　自己身为大人吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
