              "isCommentOut": 0
            },
            {
              "rowIndex": 1039,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ガサガサと道を外れて森の奥へ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我踩在沙沙作响的树叶上朝着森林深处走去。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1040,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　道が見えなくなりそうな地点で、\n　近くの木をライターであぶった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　在快要看不见道路的地方，\n　我拿出打火机灼烧着身边的树干，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1041,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　幹に矢印の焼きあとをつける。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　造出一个箭头形状的标记。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1042,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　木には悪いが、自然保護なんて気にしてられない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　有悖保护自然，但现在也顾不上那么多了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1043,
              "strings": {
                "Array": [
                  "Shake",
                  "Graphics",
                  "",
                  "x=8 time=0.6",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1044,
              "strings": {
