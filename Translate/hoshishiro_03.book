                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 71,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　えと、昨日は確か……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我记得昨天好像……",
