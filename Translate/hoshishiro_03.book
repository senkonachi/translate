            },
            {
              "rowIndex": 1828,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　びくっとして身を引いた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　又紧张地缩回身子。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1829,
              "strings": {
                "Array": [
