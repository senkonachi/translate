                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 717,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ……やめてくれ。\nノワールのことはこっちも落ち込んでるから。",
                  "",
                  "",
                  "MessageWindow",
                  "啊……还是饶了我吧。\n我也正因为诺瓦的事而消沉着呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 718,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっきは冷静じゃなかった。それは分かってる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚才的我太不冷静了。这我也明白。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 719,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　とにかく落ち着かなきゃ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　总之得先冷静下来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
