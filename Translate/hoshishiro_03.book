              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あの拒絶反応……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那排异反应……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1805,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　思い出しただけで気分の悪さがぶり返す。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　光是回想起来都感到难受。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1806,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　息も吸えない痛み。吐くだけで全身がヒリついて。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　伴随呼吸而来的疼痛。令全身发抖的呕吐。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1807,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あの苦しさ……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那种痛苦……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1808,
              "strings": {
                "Array": [
                  "",
                  "真白大",
                  "涙伏せ目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1809,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あの子はずっとあれに耐えてきた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是她一直忍耐着那种痛苦。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
