            },
            {
              "rowIndex": 1004,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "仕事のことは忘れさせてください。\nいま、僕は夢の時間にいるんですから。",
                  "",
                  "06_takase/tak0222.ogg",
                  "MessageWindow",
                  "就把工作的事情忘了吧。\n现在正是我享受清梦的时候。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1005,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だな。正しい。",
                  "",
                  "",
                  "MessageWindow",
                  "也是啊。你说的没错。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1006,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
