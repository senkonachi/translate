              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2393,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　怒鳴るのと怒るのは別物だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　怒吼和生气不一样。"
