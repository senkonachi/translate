              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 21,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　広げて見てるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚好挡住了房间入口的门帘。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 22,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　桜模様の、明るくて女の子っぽい柄。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　上面画着樱花的纹样，非常少女。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 23,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　下の方がちょっと汚れてる。\n　お茶かなにかでもこぼしたんだろうか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　下方稍微有点脏。\n　是不小心把茶水泼在上面了吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 24,
              "strings": {
                "Array": [
