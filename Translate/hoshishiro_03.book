              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さわやかな風が吹いている。\n　吹いているというか……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　清风吹拂。\n　与其说是风在吹。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 14,
