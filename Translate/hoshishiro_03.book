                  "",
                  "",
                  "",
                  "",
                  "",
                  "あと２人いるのですね。\n僕が乗り込んだときは１人だけでした。",
                  "",
                  "06_takase/tak0013.ogg",
                  "MessageWindow",
                  "原来还有两个人啊。\n我上车的时候可一个人都没有。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 749,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
