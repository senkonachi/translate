                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　<dash=2>ぎゅっ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　<dash=2>（握）。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 854,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ねりちゃんの手を掴む。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　握住了小音的手。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 855,
              "strings": {
                "Array": [
                  "",
                  "ねり大",
                  "微笑",
