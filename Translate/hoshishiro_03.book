            },
            {
              "rowIndex": 2358,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なんか流行ってるみたいだし。\nあたしもやってみようかな。",
                  "",
                  "02_karuha/kar0181.ogg",
                  "MessageWindow",
                  "最近好像还挺流行的。\n要不我也试试看吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2359,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん、やってみるかヴィーガン？",
                  "",
                  "",
                  "MessageWindow",
                  "嗯，你要试试维根主义吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2360,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "y=30 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
