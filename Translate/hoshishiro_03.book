            {
              "rowIndex": 714,
              "strings": {
                "Array": [
                  "",
                  "男",
                  "<Character=タカセ>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "かもですね。",
                  "",
                  "06_takase/tak0009.ogg",
                  "MessageWindow",
                  "或许吧。",
                  ""
                ]
