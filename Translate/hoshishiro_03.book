              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1003,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　娘から愛される、立派な母親なんだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她是一位深爱女儿的，了不起的母亲。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1004,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　２人、歩いて行くと、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我们俩走着走着，"
                ]
              },
              "isEmpty": 0,
