                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2668,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　猫村秋穂。って人を指さした。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她指着一个名叫“猫村秋穗”的人。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2669,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　カルハのお姉さん……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶的姐姐……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2670,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これまでも何度か話には出ていたな。\n　あの大事にしてる懐中時計をくれたとか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　之前也曾经提到过好几次。\n　她视若珍宝的怀表似乎就是姐姐送给她的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2671,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
