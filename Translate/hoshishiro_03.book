            },
            {
              "rowIndex": 2709,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……。",
                  "",
                  "02_karuha/kar1082.ogg",
                  "MessageWindow",
                  "嗯……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2710,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お姉さん、探すか。\n俺もちょうどここの中を調べたかった。",
                  "",
                  "",
                  "MessageWindow",
                  "那就去找你姐姐吧。\n我也刚好打算调查一下这里面。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
