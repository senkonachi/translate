            },
            {
              "rowIndex": 289,
              "strings": {
                "Array": [
                  "",
                  "車掌さん？",
                  "<Character=カルハ>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "星空のツアーにご予約のお客様はお乗りくださーい。",
                  "",
                  "02_karuha/kar0005.ogg",
                  "MessageWindow",
                  "预定了星空旅行的乘客请上车。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 290,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "閉じ目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
