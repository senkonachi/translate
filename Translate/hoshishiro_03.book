                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ら、すんなり答えが出てくる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看吧，他马上就回答了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 236,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
