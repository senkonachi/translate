                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1709,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　海外の森林になんて馴染みはないが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然不熟悉外国的森林，",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1710,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　スウェーデンの森の空気、なんとなく分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但我大概知道，这是瑞典森林的空气。",
                  "",
                  ""
