                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "すみません……。",
                  "",
                  "01_noir/noi0876.ogg",
                  "MessageWindow",
                  "非常抱歉……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
