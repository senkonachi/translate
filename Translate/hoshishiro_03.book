                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それはつまりそういうことなんだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就很可能会成真。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1163,
              "strings": {
                "Array": [
