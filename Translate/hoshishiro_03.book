              "rowIndex": 944,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　注意するようにだけ言って、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只能说句小心点，"
                ]
