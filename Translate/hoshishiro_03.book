            },
            {
              "rowIndex": 1164,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "すまん、暗くなったな。",
                  "",
                  "",
                  "MessageWindow",
                  "对不起，我太阴沉了对吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1165,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "不満そう",
                  "",
                  "",
                  "",
                  "",
                  "",
