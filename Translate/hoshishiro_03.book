            },
            {
              "rowIndex": 1937,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……まあ、髪の色がちがうってのは\n目立っちゃうよな。とくに日本では。",
                  "",
                  "",
                  "MessageWindow",
                  "……不过，发色与众不同的确很显眼。特别是在日本。"
                ]
              },
              "isEmpty": 0,
