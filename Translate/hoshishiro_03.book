            },
            {
              "rowIndex": 353,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……襲われた現場で寝てたのか。我ながら迂闊だ。",
                  "",
                  "",
                  "MessageWindowMono",
