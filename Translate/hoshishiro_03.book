              "isCommentOut": 0
            },
            {
              "rowIndex": 866,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はあ……話してたラお腹すいてきマシタ。",
                  "",
                  "04_jibie/jib0081.ogg",
                  "MessageWindow",
                  "哈……说着说着就饿了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 867,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そすね……メシ食うところくらいないかな。",
                  "",
                  "",
                  "MessageWindow",
                  "也是……有没有什么地方能吃饭呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 868,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ツアーに食事は含まれてなかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这次的旅行不含餐饮。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 869,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　つまり途中の駅で食事は出来るはずだが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　按理说应该在车站附近解决吃饭问题的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 870,
