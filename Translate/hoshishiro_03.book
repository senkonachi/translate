              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　話を振り直す。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我将话题抛给了她。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
