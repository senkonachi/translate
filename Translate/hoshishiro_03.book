                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 175,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　行っちゃった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　跑掉了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 176,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんていうか……綺麗な猫だったな。\n　しゅっとしてるというか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　怎么说呢……还真是只漂亮的猫啊。\n　给我种高贵，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 177,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人を寄せ付けない感じ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　又不易亲近的感觉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 178,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　猫は結構好きな方なんだけど、近づいていけなかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我相当喜欢猫，却也没能靠近它。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 179,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　にしても、黒猫か。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过，遇见的是黑猫吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 180,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 181,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょっと不吉なものを感じてしまうのは、\n　人間様の身勝手かな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我不禁感觉不太吉利。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 182,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　と……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这时……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 183,
              "strings": {
                "Array": [
                  "",
                  "院長",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "MessageWindow",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 184,
              "strings": {
                "Array": [
                  "",
                  "駅員",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "列車が到着します。\n白線より離れてお待ち下さい。",
                  "",
                  "99_mob/inc/inc0001.ogg",
                  "MessageWindow",
                  "列车即将到站。请在白线内等候。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 185,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　駅員さんが線路の彼方へ目を向ける。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　站务员望向铁轨的远方。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
