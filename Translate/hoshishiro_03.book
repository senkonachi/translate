            {
              "rowIndex": 1948,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "食べられるのは怖いです。",
                  "",
                  "01_noir/noi0184.ogg",
                  "MessageWindow",
                  "怕被吃掉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1949,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それは分かるけど。",
                  "",
                  "",
                  "MessageWindow",
                  "这我倒是知道。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1950,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お前自身が猫のお化けっぽい外見なのに。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　明明你自己就跟猫化身一样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
