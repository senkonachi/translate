                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　カゴを漁ったカルハが首を横に振る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶又翻了一遍篮子后摇了摇头。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
