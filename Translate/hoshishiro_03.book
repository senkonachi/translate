                  "花江大",
                  "無愛想+",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "え……普通に吸えるって聞いてるけど。\nそれで申し込んだんだし。",
                  "",
                  "05_hanae/han0012.ogg",
                  "MessageWindow",
                  "哎……宣传里说是能抽我才参加的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2231,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　え、そうなん？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　什么，真的吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2232,
