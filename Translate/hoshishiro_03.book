            },
            {
              "rowIndex": 1832,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　湖は夜空だけを反射して、\n　まるで下も空になっているようだった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　湖中倒映着漫漫星空，\n　仿佛脚下也闪耀着星光。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1833,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　夜空の中を走っているような。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　感觉就像在繁星间疾驰。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1834,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　改めて、今度は上を眺める。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她再次望向头顶。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
