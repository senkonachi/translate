            },
            {
              "rowIndex": 2978,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "とくには。\nあなたもぼんやりと立っていましたし。",
                  "",
                  "06_takase/tak0070.ogg",
                  "MessageWindow",
                  "也没有。\n不过看你呆站在那里。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2979,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=15 time=1",
                  "easeInQuad",
                  "",
