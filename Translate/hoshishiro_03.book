                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1685,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　猫の耳としっぽが生えて、アルビノではなくなった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　长出猫耳和尾巴后，她不再是白化病患者了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1686,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　不思議な話だが……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一切过于不可思议……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1687,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　２０年前にタイムスリップするよりは\n　大したことないかな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可比起时间回溯到二十年前来说，\n　这倒不是什么大事。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1688,
              "strings": {
                "Array": [
