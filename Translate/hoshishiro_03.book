              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1400,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だから直した……ずいぶんと楽になりましたよ。",
                  "",
                  "06_takase/tak0541.ogg",
                  "MessageWindow",
                  "所以才修掉了……之后工作就变得轻松了不少。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1401,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1402,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1403,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ大",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
