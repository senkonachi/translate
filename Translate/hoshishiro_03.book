            },
            {
              "rowIndex": 1481,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ですね。",
                  "",
                  "06_takase/tak0401.ogg",
                  "MessageWindow",
                  "是啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1482,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ライ麦畑でつかまえて。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　《麦田的守望者》"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1483,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　原題、キャッチャー・イン・ザ・ライ。\n　Ｊ・Ｄ・サリンジャー著。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　英文标题《Catcher in the Rye》\n　杰罗姆·大卫·塞林格著。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1484,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1485,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　刊行は戦後すぐだっけな。\n　シェイクスピアほどじゃないが、日本でも古典に入る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　记得是战后就出版了吧。\n　虽然没莎士比亚的著作这么久远，但在日本，《麦田的守望者》也够老了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1486,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1487,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-10 time=2",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1488,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "個人的には、\n人生で一番影響をうけた図書やもしれません。",
                  "",
                  "06_takase/tak0402.ogg",
                  "MessageWindow",
                  "就我个人来说，\n说是影响我人生的书也不为过。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1489,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1490,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　愛しそうに表紙を撫でる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世怜爱地抚摸着封面。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1491,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1492,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "これって鉄道出てきたっけ？",
                  "",
                  "",
                  "MessageWindow",
                  "这本书里有铁路吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1493,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1494,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1495,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……あまり出てきません。\n一応、鉄道以外の人生もおくっていましたので。",
                  "",
                  "06_takase/tak0403.ogg",
                  "MessageWindow",
                  "……几乎没出现。\n姑且我还是有铁路宅以外的生活的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1496,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1497,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ、すまん。",
                  "",
                  "",
                  "MessageWindow",
                  "这样啊，抱歉。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1498,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　何でもかんでも鉄オタとつなげるのは失礼か。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　什么都和铁道宅挂钩也不太好啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1499,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "x=15 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1500,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "中学のころね、クラスで鉄っちゃんとからかわれたので、\n衒いの意味で読み始めたのです。",
                  "",
                  "06_takase/tak0404.ogg",
                  "MessageWindow",
                  "中学的时候，因为被同学戏称阿铁，\n然后为了显摆，我就读了这本书。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1501,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "結局鉄道きっかけかよ。",
                  "",
                  "",
                  "MessageWindow",
                  "原来还是因为铁路才读的这本书啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1502,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1503,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まあ……でもちょっと分かるわ。\n中学生くらいでクラスに何人かはいるよな。\nサリンジャー読んでるやつ。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯……我也能稍微明白一点。\n中学生的话，差不多每个班上都有几个读塞林格的人。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1504,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1505,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1506,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ええ。僕の学校にも数名。その１人が僕です。",
                  "",
                  "06_takase/tak0405.ogg",
                  "MessageWindow",
                  "是啊。我们学校也有几个。其中包括我。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1507,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1508,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　嬉しそうに言う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世一脸兴奋地说道。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1509,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1510,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　Ｊ・Ｄ・サリンジャーという作家は、\n　日本の中学生にとって\n　非常に『ちょうどいい』存在である。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对日本的中学生而言，\n　杰罗姆·大卫·塞林格这位作家\n　是个非常“刚刚好”的定位。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1511,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "x=15 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1512,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1513,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　海外の作家であるため、読んでるだけで\n『洋書を読んでる俺』に浸れるし。\n　本は数冊しか出してないから読破するのも容易い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一个是他是外国作家，在读他的著作的时候\n　能沉浸在“自己在读国外书籍”这一状态。\n　而且，他也只出过几本书，想通读也很容易。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1514,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1515,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　中２病、って言葉は、いまじゃ包帯巻いて眼帯つけての\n　痛いやつを指す言葉になっちゃったが、\n　本来は『サリンジャーにかぶれる』くらいの意味だと思う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　中二病，现在虽然已经变成了\n　缠绷带戴眼罩这种看着丢人的行为，\n　感觉本来顶多只是“将塞林格与自己重合”一样的意思。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1516,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1517,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1518,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1519,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ちなみにそちらは……。",
                  "",
                  "06_takase/tak0406.ogg",
                  "MessageWindow",
                  "顺便问一下，你……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1520,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "読んだことない。あらすじくらい。",
                  "",
                  "",
                  "MessageWindow",
                  "我没看过。顶多看了梗概。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1521,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1522,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1523,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ですか。残念。",
                  "",
                  "06_takase/tak0407.ogg",
                  "MessageWindow",
                  "这样啊，可惜了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1524,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　苦笑するタカセ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世苦笑道。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1525,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　美大生だぞ。活字には自信ない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我可是美术生啊。应付不来书本的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1526,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1527,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でも色々と豆知識は知ってるぞ。\nこのサリンジャーって人、２１世紀まで生きてたんだよな。",
                  "",
                  "",
                  "MessageWindow",
                  "不过，我可知道不少小知识呢。\n塞林格活到二十一世纪了吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1528,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1529,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1530,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そうですね。\nこの本の刊行は１９５０年代。その後６０年代を最後に\n断筆したので、過去の人という印象ですが。",
                  "",
                  "06_takase/tak0408.ogg",
                  "MessageWindow",
                  "是啊。\n虽然这书是在二十世纪五十年代出版的，\n不过，他在六十年代末期就绝笔了，给人以过往之物的印象。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1531,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　亡くなったのはつい最近。\n　９０歳越えの大往生だったんだとか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　其实，去世还是在最近的事。\n　好像是活过九十岁后，就安然离世了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1532,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1533,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あとは……なんだっけ。\nこのタイトルってちょっと意訳になってて、\n本編とはそぐわないんだっけ？",
                  "",
                  "",
                  "MessageWindow",
                  "还有……啥来着。\n这标题有点意译，\n和原版的意思有出入来着？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1534,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1535,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1536,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おや。",
                  "",
                  "06_takase/tak0409.ogg",
                  "MessageWindow",
                  "哎呀。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1537,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1538,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　クスリと笑うタカセ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世轻笑着。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1539,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これもどっかで聞いた話だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这也是我道听途说的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1540,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "『ライ麦畑でつかまえて』は、原題からすると\n　ちょっと意味が外れてしまうんだとか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　说是《麦田的守望者》这标题，按原文来看\n　意思有点偏差。（日文标题直译中文是《在麦田中接住》）"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1541,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1542,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "確かにそう見る向きはありますね。",
                  "",
                  "06_takase/tak0410.ogg",
                  "MessageWindow",
                  "确实有这么种说法呢。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1543,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1544,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1545,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "原題は『キャッチャー・イン・ザ・ライ』。\nこれは本編中の、主人公のセリフから来ています。",
                  "",
                  "06_takase/tak0411.ogg",
                  "MessageWindow",
                  "原文是《Catcher in the Rye》，\n这是原文里主人公说的一句话。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1546,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そのシーンでのこの言葉は、\nライ麦畑で、転びそうな子供を、受けとめてあげる人。\nそんな意味合いで語られている。",
                  "",
                  "06_takase/tak0412.ogg",
                  "MessageWindow",
                  "说是在那个场景时说的这句话，\n是将在麦田里摔倒的小孩子接住的意思。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1547,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "つまり『キャッチャー・イン・ザ・ライ』とは、\nライ麦畑でつかまえる人。という意味です。",
                  "",
                  "06_takase/tak0413.ogg",
                  "MessageWindow",
                  "也就是说，“Catcher in the Rye”\n是在麦田中的守望者。这个意思。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1548,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1549,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1550,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "キャッチャーって野球のポジションと同じ意味の\nキャッチャーだったんだ。",
                  "",
                  "",
                  "MessageWindow",
                  "Catcher和棒球那个Catcher是同一个意思啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1551,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "呆れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "このためより厳密に原題を訳すなら、\n本のタイトルは『ライ麦畑でつかまえる人』となる。",
                  "",
                  "06_takase/tak0414.ogg",
                  "MessageWindow",
                  "因此，要严格遵从原文的意思的话，\n那就会变成《在麦田的扶起小孩子的人》。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1552,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "つかまえて。では視点が受動的に映ります。\nやや意訳に走りすぎている向きは否定できません。",
                  "",
                  "06_takase/tak0415.ogg",
                  "MessageWindow",
                  "“接住”的视角是被动的。\n但也不否定这里有过度意译的成分。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1553,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1554,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……うーん、でもつかまえての方が良い気がする。\n慣れてるからかな。",
                  "",
                  "",
                  "MessageWindow",
                  "……嗯～但是接住的话感觉更好。\n习惯了嘛。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1555,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1556,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1557,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まあそこは個々の価値観でしょう。\nつかまえる人、よりは、つかまえて、のほうが\n詩的という意味で本作の語り口にも合っていますしね。",
                  "",
                  "06_takase/tak0416.ogg",
                  "MessageWindow",
                  "不过这里是各人的价值观的体现吧。\n扶起的人与接住，\n后者要更有诗意一些。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1558,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1559,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ぱらぱらとページをめくっていくタカセ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世不停地翻着书页。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1560,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1561,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1562,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ある地点でページを止めた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "然后在某个地方停了下来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1563,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1564,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "目開き真剣",
                  "",
                  "",
