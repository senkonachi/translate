              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 565,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "結局何がおかしかったんだ？　そこの……その筒は？",
                  "",
                  "",
                  "MessageWindow",
                  "说到底是出了什么问题？　那根……管子一样的？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
