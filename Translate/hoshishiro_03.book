              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1755,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんか、灯台を中心に海を描こうって思って、",
                  "",
