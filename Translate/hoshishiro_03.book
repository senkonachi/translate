                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1095,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただジビエさんは迷わず駆け出すので\n　俺もついていかざるを得ない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐果敢地冲了出去，\n　我也赶忙跟上。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1096,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　声なんて……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　到底是哪来的声音……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1097,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ひぐっ、ひうっ。",
                  "",
                  "02_karuha/kar0109.ogg",
                  "MessageWindow",
                  "呜呜，呜呜。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1098,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あ、聞こえた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　啊，听到了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1099,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　近づいてみると分かる。森の環境音とはちがう生き物。\n　それも、人と分かる音がある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　在附近终于听见了与死气沉沉的森林不同的活物声响，\n　而且像是人声。\n",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1100,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　カルハの声だ……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是狩叶的声音啊……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1101,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
