              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1017,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ……誰も来てないな。",
                  "",
                  "",
                  "MessageWindow",
