                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 33,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺を一瞥して、通り過ぎていく。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　它看了我一眼便走掉了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 34,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだよ、縁起が悪いな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　什么嘛，怪不吉利的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 35,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いや、黒猫は幸運の象徴だっけ？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不对，黑猫好像象征幸运来着？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 36,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　タカセの話じゃ、確か……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世好像是这么说的……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 37,
              "strings": {
