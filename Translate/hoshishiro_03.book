            {
              "rowIndex": 1682,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "灯台もあってちょうどいい。",
                  "",
                  "",
                  "MessageWindow",
                  "正好这里有灯塔。",
                  ""
                ]
              },
