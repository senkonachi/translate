                  "280",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1192,
              "strings": {
                "Array": [
                  "Wait",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1193,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "x=30 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
