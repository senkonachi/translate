            },
            {
              "rowIndex": 1412,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1413,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　夜逃げに、心中。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　夜里逃跑，自寻短见。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1414,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　土木関係じゃいまでもよくある話だそうだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　在土木工程的业界，这种事似乎不少见。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1415,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　アニメーターも薄給って意味じゃ同じようなもんだし。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　从收入微薄这一点来说，动画师其实也差不多。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1416,
              "strings": {
                "Array": [
