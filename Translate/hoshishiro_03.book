                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1202,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なにも描かれてないそれを、しげしげと眺める彼女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　反复浏览着空白的纸张。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1203,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "目逸らし_困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "この大きさをうっかり見落とす、ってのも、\nイマイチ考えられないねえ。",
                  "",
                  "05_hanae/han0056.ogg",
                  "MessageWindow",
                  "这么大的东西会不小心看丢，\n感觉有点不合常理。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1204,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……はは。",
                  "",
                  "",
                  "MessageWindow",
                  "……哈哈。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1205,
