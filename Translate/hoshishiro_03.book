                "Array": [
                  "",
                  "ジビエ",
                  "悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "せんきゅ。",
                  "",
                  "04_jibie/jib0460.ogg",
                  "MessageWindow",
                  "谢了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1032,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　近くの自販機で買ってきたらしい。\n　コーンスープの缶を渡してる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她从花江小姐手中接过玉米浓汤。\n　似乎是从附近的自动售货机上买来的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1033,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "目逸らし_困り",
                  "",
