                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　３人が目を開ける。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　三个人睁开眼。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
