              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 145,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これは、夢だ。",
                  "",
                  "",
                  "MessageWindowMono",
