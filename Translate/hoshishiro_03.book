                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 386,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　３人目だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　第三个了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 387,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こうなると、あの子よりも\n　夢のシステムのほうが気になってくるのだが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　现如今，比起那个女孩\n　我更在意这梦是怎么来的了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 388,
