            },
            {
              "rowIndex": 1922,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　走る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　奔跑。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1923,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　線路に沿って、まっすぐに走る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我们沿着铁路笔直奔跑。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1924,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どれくらい離されてる？\n　最後に駅を出てからずいぶんと走ったから、\n　人の足で追いつける距離か？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　到底有多远？\n　离开车站已经跑了很久，\n　这距离是跑步能追上的吗？",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1925,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　考えても無駄だ。とにかく走ろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　想多无益。总之跑吧。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1926,
              "strings": {
                "Array": [
                  "Tween",
                  "Graphics",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1927,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はあ、はあ。",
                  "",
                  "",
                  "MessageWindow",
                  "哈，哈。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1928,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　運動不足のせいですぐに息が切れるけど、\n　自分に出来る限りで。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　因为平常不怎么运动，我的呼吸很快就变得急促，\n　但还是在全力奔跑。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1929,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1930,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こうしてると、さっき、病院でのことがウソみたいだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　现在这样跑着，仿佛刚才在医院的一切都是骗人的。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1931,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　動くだけで辛い。息するだけで苦しい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　连移动都艰难。连呼吸都痛苦。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
