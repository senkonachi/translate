              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　走れる。歩ける。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　奔跑。走动。",
                  "",
                  ""
