            },
            {
              "rowIndex": 269,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "犬もいいけどね。\n今日は猫ちゃん見たから猫派。",
                  "",
                  "03_neri/ner0092.ogg",
                  "MessageWindow",
                  "狗也不错。\n可今天我看到了小猫，更喜欢猫。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 270,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "閉じ目甘え",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "飼えないのは分かってるけどねー。",
                  "",
                  "03_neri/ner0093.ogg",
                  "MessageWindow",
                  "不过我知道自己养不了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 271,
              "strings": {
                "Array": [
                  "",
                  "ねり",
