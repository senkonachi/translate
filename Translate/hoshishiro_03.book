                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 98,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "函館は、観光の街で。\n観光客のお相手をしてれば家が困ることはなくて。",
                  "",
                  "03_neri/ner0166.ogg",
                  "MessageWindow",
                  "函馆是个旅游景点。\n只要照顾好游客，家里就能过得殷实。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 99,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でもそれで養える子供は１人までなの。\nお店を２個持てるほど恵まれた家はそんなにないの。",
                  "",
                  "03_neri/ner0167.ogg",
                  "MessageWindow",
                  "但这么做只能养一个孩子。\n不是每个家庭都能有两家店铺的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 100,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_d",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 101,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 102,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_c",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 103,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "女の子は、その家の次女でね。\n昔から実家の小料理屋を手伝ってきて。",
                  "",
                  "03_neri/ner0168.ogg",
                  "MessageWindow",
                  "女孩子是家里的老二。\n小时候就在帮家里店铺打下手。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 104,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_b",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 105,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "楽しんでたんだよそこでの生活は。\n美人で評判で、お店じゃお客さんにちやほやされるし、\n学校の部活でも主役ばっかり。",
                  "",
                  "03_neri/ner0169.ogg",
                  "MessageWindow",
                  "在那里生活还是挺开心的。\n又漂亮，在店里也受客人们欢迎，\n学校的社团活动里也是焦点。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 106,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_f",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 107,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でも高校生の時に、お姉ちゃんが結婚して、\nお店はその旦那さんが継ぐことになって。",
                  "",
                  "03_neri/ner0170.ogg",
                  "MessageWindow",
                  "但是那女孩高中的时候，姐姐结婚了，\n店铺也就过渡到了男方手里。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 108,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
