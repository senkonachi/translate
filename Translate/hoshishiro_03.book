                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　すぐにいなくなってしまう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　转眼间就消失了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
