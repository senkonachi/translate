                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 719,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "目閉じ悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ソーデスネー、べたべたしマス。",
                  "",
                  "04_jibie/jib0048.ogg",
                  "MessageWindow",
                  "是啊，身上会黏糊糊的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 720,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　湿度のちがいには苦しんでいるようだった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看来湿度差异对她而言确实是一种折磨。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 721,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "虚ろ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はー。",
                  "",
                  "04_jibie/jib0049.ogg",
                  "MessageWindow",
                  "哈。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 722,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "森の香りも日本はずいぶん違う気がしたケド……。\nここはスウェーデンの森と同じ感じ。",
                  "",
                  "04_jibie/jib0050.ogg",
                  "MessageWindow",
                  "日本的森林其实气味也挺不一样的……\n可这里就像瑞典一样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 723,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ",
                  "PunchPosition",
