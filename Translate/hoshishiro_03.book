            },
            {
              "rowIndex": 954,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なるほど。つまり共同作業というわけですね。",
                  "",
                  "06_takase/tak0218.ogg",
                  "MessageWindow",
                  "原来如此。也就是说这是合作作业啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 955,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ま、そうだな。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯，算是吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 956,
              "strings": {
                "Array": [
                  "",
                  "暁",
