                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1487,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こんなにも絵が描きたいと思ったのは、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　能产生如此之强的绘画欲望，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1488,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いつくらいぶりだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　已经是多久以前的事了呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
