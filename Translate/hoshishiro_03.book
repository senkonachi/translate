                  "MessageWindowMono",
                  "　……嗯？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1963,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おや。",
