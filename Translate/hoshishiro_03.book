            },
            {
              "rowIndex": 781,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　鍵をあけるカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶打开了门锁。",
                  ""
                ]
              },
              "isEmpty": 0,
