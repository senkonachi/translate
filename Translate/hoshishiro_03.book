            {
              "rowIndex": 1680,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょっと離れて見る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　稍微拉开了点距离看了看。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1681,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　髪の色合いや肌の質感に、とくに違和感はない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　头发的颜色与皮肤的质感，都没有不对劲的地方。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1682,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　色白ではあるが、アルビノって感じはしない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然皮肤发白，但也没到白化病那程度。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1683,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し緊張",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1684,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
