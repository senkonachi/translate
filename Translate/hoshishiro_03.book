                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1151,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>通常目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "小学生のときなんて大変だったのよ。\nそのときお姉ちゃん高校生だったんだけど、\nクラスの男子がみんなお姉ちゃんに一目惚れしちゃって。",
                  "",
                  "02_karuha/kar1192.ogg",
                  "MessageWindow",
                  "小学时候我可辛苦了。\n那时候姐姐还在读高中，\n班上那些男生对姐姐都一见钟情。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1152,
              "strings": {
                "Array": [
