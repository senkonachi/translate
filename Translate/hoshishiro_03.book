            },
            {
              "rowIndex": 867,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Character=ねり大>微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "これが最後のお話。",
                  "",
                  "03_neri/ner0318.ogg",
                  "MessageWindow",
                  "这是最后一个故事。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 868,
              "strings": {
                "Array": [
                  "Tween",
                  "ねり大",
                  "PunchPosition",
                  "y=-10 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 869,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Character=ねり大>閉じ目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "可哀想な男の子のお話。",
                  "",
                  "03_neri/ner0319.ogg",
                  "MessageWindow",
                  "一个可怜的男生的故事。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 870,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 871,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　前に夢で見たときも聞かせてくれた、話の続き。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　之前在梦中遇到时说给我听的故事的延续。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 872,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　可哀想な女の子が２人と、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　故事中有两个可怜的女孩子……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 873,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　最後は、男の子？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　最后又出现了个男生？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 874,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 875,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_f",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 876,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "その子が生まれたのは、海の真ん中にある小さな島でね。",
                  "",
                  "03_neri/ner0320.ogg",
                  "MessageWindow",
                  "那孩子出生于大海正中央的一个小岛。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 877,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "賑わってるけど静かで、住み心地はいいんだけど。",
                  "",
                  "03_neri/ner0321.ogg",
                  "MessageWindow",
                  "那是个热闹又安静的地方，住起来很舒服。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 878,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_c",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 879,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でも周りの大人やテレビの人は、本州とはちがう。\n不便だって口癖のように言ってて。",
                  "",
                  "03_neri/ner0322.ogg",
                  "MessageWindow",
                  "但周围的大人和电视里的人，\n总是把“这里和本州不一样”“真不方便啊”挂在嘴边。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 880,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だからその子はずっと本州に憧れてたの。\n大学は絶対に本州、できれば東京に通おうって。",
                  "",
                  "03_neri/ner0323.ogg",
                  "MessageWindow",
                  "所以那孩子一直憧憬着本州。\n想着一定要去本州，最好能到东京去上大学。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 881,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_b",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 882,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "とくにその子は汽車が好きで、島の中にはなかったから、\n線路の上を走る電車に憧れてた。",
                  "",
                  "03_neri/ner0324.ogg",
                  "MessageWindow",
                  "他非常喜欢火车。憧憬着岛上所没有的，\n在铁轨上疾驰的电车。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 883,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 884,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　今回は、誰のことだか分かりやすい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　很容易就能猜出这次的主人公是谁。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 885,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_c",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 886,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "大人になって憧れの東京に住みだしたけど、でも、\nそこにその子の憧れはなかった。",
                  "",
                  "03_neri/ner0325.ogg",
                  "MessageWindow",
                  "长大成人之后，他如愿以偿来到了东京生活。但是，\n那里并没有他所憧憬的那些东西。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 887,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "東京の生活は息苦しくて。仕事も辛くて。",
                  "",
                  "03_neri/ner0326.ogg",
                  "MessageWindow",
                  "东京的生活过得很憋屈。工作也很艰难。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 888,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "その子は必死で適応しようと言葉の訛りを直したり。\n顔を整形までしたんだけど。",
                  "",
                  "03_neri/ner0327.ogg",
                  "MessageWindow",
                  "为了适应东京的生活，他拼命改掉了自己的乡音，\n甚至还去做了整容。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 889,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_f",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 890,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でもやっぱり島の、のんびりした暮らしはそこになかった。",
                  "",
                  "03_neri/ner0328.ogg",
                  "MessageWindow",
                  "但那里的生活始终无法像小岛上那样悠闲舒适。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 891,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "とくに辛いのは仕事。\n仕事の、人間関係。",
                  "",
                  "03_neri/ner0329.ogg",
                  "MessageWindow",
                  "最辛苦的是工作。\n工作方面的人际关系。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 892,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "現場と役所の間をつなぐ仕事だから、\nどちらからも文句ばかり言われて、傷ついて。",
                  "",
                  "03_neri/ner0330.ogg",
                  "MessageWindow",
                  "因为是充当现场和办公室沟通窗口的工作，\n所以总是被双方责备个不停，因此而受伤。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 893,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント21_d",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 894,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……ゼネコンはメンタルやられやすいって聞くな。",
                  "",
                  "",
                  "MessageWindow",
                  "……我也听说承建商的工作特别容易精神崩溃。"
                ]
              },
              "isEmpty": 0,
