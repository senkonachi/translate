              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　周りを見てる彼女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她环视着四周。",
                  ""
                ]
              },
              "isEmpty": 0,
