              "rowIndex": 776,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ大",
                  "MoveBy",
                  "y=10 time=1",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 777,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……だいじょぶ。ワタシも聞きたいデスカラ。",
                  "",
                  "04_jibie/jib0418.ogg",
                  "MessageWindow",
                  "嗯……没事。我也想继续听。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 778,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ怯えながらも引かなかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她虽然害怕，但是没有逃避。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 779,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　話は１人でも多い方が円滑ではある。\n　本人が言うなら続けよう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　哪怕只是多一个人，讨论都会更顺畅些。\n　既然她都这么说了，那就继续吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
