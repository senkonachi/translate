              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 923,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　頭を撫でる。\n　大人が子供にすること。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　摸脑袋。\n　是大人对小孩子所做的事。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 924,
              "strings": {
                "Array": [
