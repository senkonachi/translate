                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 964,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "？",
                  "",
                  "",
                  "MessageWindow",
                  "？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 965,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 966,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-10 time=0.4",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 967,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "この汽車、いまどこを走っているか分かりますか？",
                  "",
                  "06_takase/tak0300.ogg",
                  "MessageWindow",
                  "你知道这辆火车现在跑在哪里吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 968,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 969,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "え……どこだろ。",
                  "",
                  "",
                  "MessageWindow",
                  "哎……是哪里啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 970,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ずっと山の中だけど。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一直都在山里吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 971,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ツアーはあくまで『夜汽車の旅』で、どこを目指すかとかは\n　一切告げられていない、一種のミステリーツアーである。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　旅行是“夜晚的火车之旅”，\n　不告知目的地的神秘之旅。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 972,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　昨日タカセの故郷だっていう駅を通った。\n　都内らしいから、南に向かってるのは間違いない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　昨天鹰世说列车路过了他的故乡。\n　他的故乡好像在都内，所以，列车应该是向南方行进的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 973,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "山梨とか長野あたり？",
                  "",
                  "",
                  "MessageWindow",
                  "山梨或是长野附近？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 974,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き気だるい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 975,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
                  "",
