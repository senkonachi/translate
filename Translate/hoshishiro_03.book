            },
            {
              "rowIndex": 93,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おうちには仲良しの家族が住んでいて。\nみんな幸せにくらしていてね。",
                  "",
                  "03_neri/ner0122.ogg",
                  "MessageWindow",
                  "家里住着关系很和睦的一家人。\n大家都幸福地生活在那里。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 94,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "心配",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でもそこの女の子は、ずっと病気がちなの。",
                  "",
                  "03_neri/ner0123.ogg",
                  "MessageWindow",
                  "可那里的女孩，体弱多病。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 95,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "女の子……？",
                  "",
                  "",
                  "MessageWindow",
                  "女孩……？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 96,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "甘え",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "身体が弱くてね。外を出歩くのも苦労するくらいで。",
                  "",
                  "03_neri/ner0124.ogg",
                  "MessageWindow",
                  "身体很柔弱，连出门走动都要大费周折。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 97,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "閉じ目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 98,
              "strings": {
                "Array": [
                  "Tween",
                  "ねり",
                  "PunchPosition",
                  "y=-10 time=2",
                  "easeInQuad",
                  "",
