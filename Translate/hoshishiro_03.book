            {
              "rowIndex": 2364,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "ギャグ「やばっ！！」",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なぬ！？",
                  "",
                  "02_karuha/kar0183.ogg",
                  "MessageWindow",
                  "啥！？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2365,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "乳酸菌は生き物にカテゴライズされるらしい。",
                  "",
                  "",
                  "MessageWindow",
                  "听说乳酸菌也是分类到生物里的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2366,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "MoveBy",
                  "y=-10 time=0.5",
