                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "は、はあ。",
                  "",
                  "01_noir/noi0625.ogg",
                  "MessageWindow",
                  "是、是吗。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1264,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "困り目逸らし",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
