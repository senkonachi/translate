            {
              "rowIndex": 2693,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……ほんと？　",
                  "",
                  "02_karuha/kar1080.ogg",
                  "MessageWindow",
                  "……真的吗？　"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2694,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2695,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2696,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　確定を求めるなよ。\n　こっちだって全部のルールが分かってるわけじゃない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　别找我确认真伪啊。\n　我也还没完全掌握所有的规则。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2697,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "とにかく、戻らないか？\nみんな心配する。",
                  "",
                  "",
                  "MessageWindow",
                  "总之先回去吧？\n大家都可担心了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2698,
              "strings": {
