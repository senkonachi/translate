              "strings": {
                "Array": [
                  "",
                  "花江",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……おかしいな。入り口は開いてるのに。",
                  "",
                  "05_hanae/han0196.ogg",
                  "MessageWindow",
                  "嗯……好怪啊。明明入口打开着的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1851,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……？",
                  "",
                  "",
                  "MessageWindow",
                  "……？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1852,
              "strings": {
                "Array": [
