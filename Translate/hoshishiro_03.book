              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "化け物なんて描いてねーわよ！",
                  "",
                  "02_karuha/kar1086.ogg",
                  "MessageWindow",
                  "才没画什么怪物呢！"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2732,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ぷーっと頬を膨らせるカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶嘟起了脸。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2733,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目少し膨れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2734,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "x=15 time=1",
                  "easeInQuad",
