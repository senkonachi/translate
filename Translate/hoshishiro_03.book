            },
            {
              "rowIndex": 1974,
              "strings": {
                "Array": [
                  "",
                  "アナウンス",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "不安ですか？",
                  "",
                  "05_hanae/han0208.ogg",
                  "MessageWindow",
                  "您害怕吗？"
                ]
              },
              "isEmpty": 0,
