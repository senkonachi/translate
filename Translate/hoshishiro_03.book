                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　小さく頷くノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦轻轻点了点头。"
