                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2283,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　戻った。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　回到了大厅。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2284,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ハンカチとか持ってないので、\n　手は洗ったけどびしょびしょだ。\n　カルハのことからかえないな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　因为没带手帕，\n　所以洗完后手湿漉漉的。\n　就我这样，也没资格教训狩叶呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2285,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　適当にぷらぷらさせて乾かせつつ、ホールへ戻る……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我随意把手甩干，然后回到了大厅。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2286,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2287,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "っ。",
                  "",
                  "",
                  "MessageWindow",
                  "唔。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2288,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_プラネタリウム",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2289,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　またも違和感。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　又感觉不太对劲。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2290,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっきのとはちがう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　与之前的不同。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2291,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっきの、どこか安堵感のある。\n　なにかを思い出したような違和感とはちがう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚才莫名让人安心。\n　这次不同于刚才呼之欲出的氛围。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2292,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　悪い意味の違和感……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而是不好的感觉……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2293,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2294,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "誰かいます？",
                  "",
                  "",
                  "MessageWindow",
                  "有人在吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2295,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人の気配。だよな、たぶん。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是人的气息吧，应该。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2296,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　鍵が開いてたんだ。誰もいないわけがない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　门是开着的。不可能没人。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2297,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　金は払ってるんだ。\n　勝手に入った、みたく思われるのもナンだし、\n　話をつけておこう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我们是付了钱的。\n　我可不想被当作擅闯，\n　还是攀谈几句为好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2298,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　フロントは……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　前台……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2299,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "諦観",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
