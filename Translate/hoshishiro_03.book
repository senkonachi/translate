              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ほ、北海道すか？",
                  "",
                  "",
                  "MessageWindow",
                  "北、北海道吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1176,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　岩手発進で東京へいったはずなのに、\n　北へ折り返してたらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　明明应该是从岩手出发开往东京的，\n　看来是往北方折返了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1177,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "函館か～初めてだな。",
                  "",
                  "",
                  "MessageWindow",
                  "函馆么~，头一回来啊。"
                ]
