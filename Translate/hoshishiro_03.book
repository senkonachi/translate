                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　テンション上がってるカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶一脸兴奋。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
