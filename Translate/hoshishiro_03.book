                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1512,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ぽふ、と髪に手をやる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我轻轻用手抚摸着她的头发。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1513,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その話が、この黒髪にどう繋がるのかは\n　気になるところだが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而这事是怎么和现在的黑发接上的，\n　这点让我很在意，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1514,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_b_大",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1515,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いまはノワールのペースにあわせよう。\n　くしくしと撫でてやる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　现在还是配合诺瓦的节奏来吧。\n　我轻轻抚摸着她。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1516,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はうう。",
                  "",
                  "01_noir/noi0979.ogg",
                  "MessageWindow",
                  "哈呜呜。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
