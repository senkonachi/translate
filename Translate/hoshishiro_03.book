                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2367,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "閉じ目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ＯＫ、抜けた。",
                  "",
                  "02_karuha/kar0184.ogg",
                  "MessageWindow",
                  "OK，当我没说。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2368,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　潔い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　干脆至极。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2369,
              "strings": {
                "Array": [
                  "StopBgm",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "2",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2370,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まあ自発的に、生き物を思いやって始めるのはいいけど、\n流行だからって始めるのはどうかと思うぞ。",
                  "",
                  "",
                  "MessageWindow",
                  "倘若是发自内心的为生物着想打算当个维根主义者倒也没啥，\n但仅仅是随大流还是免了吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2371,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2372,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2373,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "『発想』はいいけど、\n　じゃあ明日からヴィーガンになったとして",
                  "",
                  "",
                  "MessageWindowMono",
                  "　有这种“意识”是好的，\n　但假设从明天起人人都宣布成为维根主义者，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2374,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それは動物のためになるか？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这对动物有益处吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2375,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　答えはノーだ。捨てられる動物の肉が増えるだけだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　答案是否定的。反倒会令现成的肉制品被无端浪费。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2376,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　万が一にもその流行が世界中に広がって、\n　世界中の人がヴィーガンになったとして、\n　それは動物のためになるか？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　再假设万一维根主义席卷了全球，\n　使所有人都变成了维根主义者。\n　这又对动物有什么益处吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2377,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これもノー。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　答案依然是否定的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2378,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　この地球上に動物さんたちが平和に暮らせる環境なんて\n　存在しない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只要有人类，\n　地球上就不会出现动物能和平生存的环境。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2379,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　つまり『発想』としてのヴィーガンはいいけど、\n『流行』としてのヴィーガンは意味がない。\n　と、俺は思ってる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　换言之个人“意识”到的维根主义是有意义的，\n　但“跟风”的维根主义就毫无意义了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2380,
              "strings": {
                "Array": [
                  "Bgm",
                  "BGM02",
                  "",
                  "",
                  "",
                  "",
