            },
            {
              "rowIndex": 29,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ひゃんっ。",
                  "",
                  "03_neri/ner0008.ogg",
                  "MessageWindow",
                  "呀。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 30,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも下りられた途端、飛ぶように彼女の手を逃れて、\n　そのままどこかへ逃げていってしまった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可是一下来就从她的怀中跳开，\n　跑得不知踪影了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 31,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お礼も言わねーでやんの。",
                  "",
                  "",
                  "MessageWindow",
                  "连一点谢意都没有么。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 32,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "猫ちゃんなんだからしょうがないよ。",
                  "",
                  "03_neri/ner0009.ogg",
                  "MessageWindow",
                  "小猫又不会道谢，没办法的啦。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 33,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "にしてもあの態度って、助け損じゃないか？",
                  "",
                  "",
                  "MessageWindow",
                  "可是看它那副态度，不觉得白救了吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 34,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そんなこと言わない。\n放っておけないでしょ。",
                  "",
                  "03_neri/ner0010.ogg",
                  "MessageWindow",
                  "别这么说呀。\n怎么能放任不管呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 35,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　放っておけない……ね。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不能放任不管……么。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
