            },
            {
              "rowIndex": 3269,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "歳はあたしと同じくらいなんだけど、\n難病のせいでもう長いこと外にも出られないとかで。",
                  "",
                  "02_karuha/kar1141.ogg",
                  "MessageWindow",
                  "岁数和我差不多吧，\n但因为得了疑难杂症，已经很久没法外出了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3270,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……そうか。",
                  "",
                  "",
                  "MessageWindow",
                  "……是吗。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3271,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　歳は同じくらい、か。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　差不多岁数……吗。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
