            },
            {
              "rowIndex": 1548,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お母さんとおじいさまが、ケンカになって。",
                  "",
                  "01_noir/noi0993.ogg",
                  "MessageWindow",
                  "妈妈和爷爷吵架了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1549,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1550,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　またか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　又是这样么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1551,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　肉を食わせる食わせないでケンカしてた。ってのは\n　前に聞いてるけど、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然之前曾听说过\n　两人因为是否要给诺瓦吃肉而争执不休，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1552,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　仲が悪いのかこの親子？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　难道他们关系很差么？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1553,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……いや、ちがう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……不对，不是这样。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1554,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
