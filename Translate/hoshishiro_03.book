                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　しばらく目を通して、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我看了会儿，"
                ]
              },
              "isEmpty": 0,
