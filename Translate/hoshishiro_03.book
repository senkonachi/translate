            {
              "rowIndex": 2666,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "この人、この名前、あたしのお姉ちゃん。",
                  "",
                  "02_karuha/kar1078.ogg",
                  "MessageWindow",
                  "这个人，这个名字，就是我姐姐。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2667,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "困り",
                  "",
                  "",
                  "",
                  "",
