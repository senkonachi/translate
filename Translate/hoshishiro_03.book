                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　上京して、大学を卒業して、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　来到东京，接着大学毕业，"
                ]
              },
