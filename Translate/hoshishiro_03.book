                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ。",
                  "",
                  "",
                  "MessageWindow",
                  "没错。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
