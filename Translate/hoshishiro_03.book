                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ねりちゃんなら……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　小音的话……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 529,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　分からなかっただろうな。\n　こんな時間があれば退屈だーって騒いでたと思う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　应该不会懂吧。\n　她肯定会觉得这种时光非常无聊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 530,
              "strings": {
                "Array": [
                  "Tween",
                  "ねり",
                  "PunchPosition",
                  "x=30 time=1",
                  "easeInQuad",
