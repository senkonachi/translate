            {
              "rowIndex": 2153,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi1092.ogg",
                  "MessageWindow",
                  "好的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2154,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "よし。",
                  "",
                  "",
                  "MessageWindow",
                  "这就对了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2155,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2156,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　自信なさげな『はい』だった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是句没什么自信的“好的”。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2157,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　できるかどうかは微妙だな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　能不能做到，那还得打个问号。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2158,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　けどいいさ。約束は約束だ。\n　ノワールなら、覚えてて無視することもあるまい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过也行。　约定本身不会变。\n　诺瓦也肯定不会无视这条约定。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2159,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　臆病な甘えん坊さんの、背中をおす\n　ほんの一助にでもなったなら、充分だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　若能推这个胆小的撒娇鬼一把，\n　助她一臂之力，那就足够了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2160,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_c",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2161,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "出来たらなんかご褒美をやるよ。なにがいい？",
                  "",
                  "",
                  "MessageWindow",
                  "等你做到了就给你奖励。想要什么吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2162,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ご、ご褒美ですか？",
                  "",
                  "01_noir/noi1093.ogg",
                  "MessageWindow",
                  "奖、奖励吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2163,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2164,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ。俺にできることならなんでも。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯。只要我能做到的随便提。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2165,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_a",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2166,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ……。",
                  "",
                  "01_noir/noi1094.ogg",
                  "MessageWindow",
                  "啊……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2167,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi1095.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2168,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_c",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2169,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "じゃ、じゃあわたし、似顔絵がいいです。",
                  "",
                  "01_noir/noi1096.ogg",
                  "MessageWindow",
                  "那、那我想要自己的肖像画。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2170,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "似顔絵？",
                  "",
                  "",
                  "MessageWindow",
                  "肖像画？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2171,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2172,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。\nシロさんに描いて欲しいなって。",
                  "",
                  "01_noir/noi1097.ogg",
                  "MessageWindow",
                  "对的。\n就想让白先生画。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2173,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "カルハさんのあの絵……すごくステキだったから。",
                  "",
                  "01_noir/noi1098.ogg",
                  "MessageWindow",
                  "因为白先生为狩叶小姐画的那张画……实在很棒"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2174,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "シロさんに、わたしの似顔絵を描いて欲しいです。",
                  "",
                  "01_noir/noi1099.ogg",
                  "MessageWindow",
                  "我想让白先生画我的肖像画。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2175,
              "strings": {
