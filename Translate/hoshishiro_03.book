              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1754,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ジビエさんの場所や、タカセの場所。\n　花江さんの場所。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐的地方，鹰世的地方。\n　花江小姐的地方。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1755,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　この先はどうなる？　また俺の街に戻るか？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　接下来会怎么样？　又回到我的城市吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1756,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　汽車にたどり着けない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我到不了火车那里。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
