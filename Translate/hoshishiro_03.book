            },
            {
              "rowIndex": 518,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあ……心配しすぎか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　哎……可能是我多虑了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 519,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　子供とみるとどうも……なのは\n　年取った証拠かね。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一看见小孩子就不由自主地……\n　这就是上了岁数的证据吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 520,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あまり心配しすぎたり、構い過ぎたりすると\n　ウザがられる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　要是频繁地唠叨或管教，\n　容易让对方生厌。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
