            {
              "rowIndex": 1010,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "逸らし目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ちょっと待って予定表……んと。",
                  "",
                  "02_karuha/kar0026.ogg",
                  "MessageWindow",
                  "稍等我找一下登记表……在这。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1011,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ボイラー室との境になっているドアに貼り付けてある\n　古くさいわら半紙を取る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她将手伸向了锅炉室的隔离门，\n　拿起贴在上面的一张陈旧的绵纸。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1012,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "y=-10 time=1.5",
                  "easeInQuad",
                  "",
