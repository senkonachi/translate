                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まだ自己紹介もしてなかったっけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我都忘记自我介绍了。",
                  ""
                ]
