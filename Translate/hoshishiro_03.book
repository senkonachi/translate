              "rowIndex": 971,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人間ってなんだかんだ火が好きだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　火焰总是能鼓动人心。",
