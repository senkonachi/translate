            },
            {
              "rowIndex": 189,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　<dash=2>来た。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　<dash=2>来了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 190,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どこか懐かしさを感じる汽笛の音。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　远处响起了令人怀念的汽笛声。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 191,
              "strings": {
                "Array": [
                  "StopSe",
