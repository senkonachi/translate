            },
            {
              "rowIndex": 1699,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あの白の少女とノワールが、他人じゃないのは分かった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　算是明白那名纯白的少女和诺瓦是同一个人了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
