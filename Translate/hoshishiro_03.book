                  "ギャグ（ボケ2）",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そうなの？",
                  "",
                  "02_karuha/kar1128.ogg",
                  "MessageWindow",
                  "是吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3185,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "ギャグ照れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
