              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 70,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　てかここはどこだ。\n　エンジン室か？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　话说这是哪。\n　发动机房吗？",
