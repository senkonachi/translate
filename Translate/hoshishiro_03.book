            },
            {
              "rowIndex": 2075,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "閉じ目悩み",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "楽しい旅でした。",
                  "",
                  "07_mashiro/mas0090.ogg",
                  "MessageWindow",
                  "真是个开心的旅途。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2076,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ぽつりとつぶやいた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "她轻声细语了一句。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2077,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "悲しみ伏目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "シロさんと出会えて本当によかった。\n最後にこんな楽しい思いが出来るなんて。",
                  "",
                  "07_mashiro/mas0091.ogg",
                  "MessageWindow",
                  "能与白先生相遇真是太好了。\n没想到我最后还能留下这么美好的回忆。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2078,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "閉じ目悩み",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だから、お願いです。",
                  "",
                  "07_mashiro/mas0092.ogg",
                  "MessageWindow",
                  "所以，拜托你了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2079,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "困り目逸らし",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2080,
              "strings": {
                "Array": [
                  "Tween",
                  "真白",
                  "PunchPosition",
                  "x=15 time=1.5",
