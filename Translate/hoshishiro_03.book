                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2282,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "やっぱゆくゆくはジプリみたいの作るの？",
                  "",
                  "02_karuha/kar0474.ogg",
                  "MessageWindow",
                  "是不是慢慢就能画出吉卜力那样的动画呢？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2283,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2284,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2285,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2286,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　無理だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　怎么可能。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2287,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　別にこの仕事に、大望を抱いてはいったわけじゃない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我并非怀着多远大的抱负从事这份工作。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2288,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2289,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　仕事のクチに迷っているときツテを得て、\n　絵でメシが食えるってのに憧れて入った世界だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　仅仅是当年择业犹豫不决之时遇到了这方面的机会，\n　而我正好又憧憬着靠画画吃饭的生活，便踏入了这个世界。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2290,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それでも別にアニメが嫌いなわけじゃない。\n　いつかは大きな仕事を、\n　誰もが見てくれるような作品をって思ってたけど。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我不讨厌动画。\n　也想过未来要把事业做大，\n　还想过做出家喻户晓的作品。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2291,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_海岸_昼",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2292,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……そんな野望はもう消えた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……可惜这份野心早已被磨灭了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2293,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2294,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いまやアニメ業界も下火で、底が見えてきた。\nこっちは食いっぱぐれないので必死だよ。",
                  "",
                  "",
                  "MessageWindow",
                  "现在业界不景气，差不多能看到头了。\n我仅仅是谋生就已经很吃力了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2295,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2296,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "x=15 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2297,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あー、聞いたことある。\nソシャゲにお金がいってて、アニメは不況なのよね。",
                  "",
                  "02_karuha/kar0475.ogg",
                  "MessageWindow",
                  "啊<dash=2>我也听说过。\n大家都把钱花在手游上，动画很不景气吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2298,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "言うほど単純じゃないが、\nこっちに金が下りてこないのは事実だ。",
                  "",
                  "",
                  "MessageWindow",
                  "没你说得那么简单，\n不过，赚不到钱倒是真的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2299,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2300,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ネットで言われてるほど極貧ではないが、\n　いつまでも食っていけるかといわれれば不安な程度。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然没有网上说的那样穷得揭不开锅，\n　但指着动画能活多久着实令我有几分忐忑。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2301,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2302,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2303,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そんな時代に世界に名だたるようなもの作りたがる野望は\n持ってられない。",
                  "",
                  "",
                  "MessageWindow",
                  "在这样的时代里，\n我完全不奢望能够创作出震惊世界的作品。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2304,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "逸らし目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2305,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "y=-10 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2306,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ふーん。\n現実的というか、夢がないというか。",
                  "",
                  "02_karuha/kar0476.ogg",
                  "MessageWindow",
                  "是吗——\n该说你现实呢，还是没有梦想呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2307,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2308,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お前も大人になりゃ分かる。",
                  "",
                  "",
                  "MessageWindow",
                  "等你长大以后就明白了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2309,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "Bgm",
                  "BGM03",
                  "",
                  "",
                  "",
                  "2",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2310,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_空_昼",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2311,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　すごいものが作りたいという夢がある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我曾把创作出神作视为梦想。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2312,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それはいいことだ。\n　たぶんみんなが思っているだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这是件好事，\n　或许大家都有过这个梦想。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2313,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも、じゃあどうやって？\n　と聞かれれば。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可现实很残酷，\n　究竟该如何实现呢？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2314,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まず大多数の人間には、そのきっかけが手に入らない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　首先大多数人都没有良好的机遇。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2315,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　チャンスは逃しちゃダメだ。\n　自分で掴みにいけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　“不可以放过机会”。\n　“要去主动把握机会”。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2316,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　よく言われるが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这是人们常常挂在嘴边的话。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2317,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　１回のチャンスでなにもかも上手くいくほど\n　世の中は簡単に出来てない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然而现实并非如此简单。\n　没有简单到仅凭一次机会就能一帆风顺。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2318,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　とすると当然、大切なのはチャンスの回数なわけだが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　按照这个理论，抓住机会的次数是相当重要的指标。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2319,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その個人差は大きすぎる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　况且人和人之间有天壤之别。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2320,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　チャンスを与えられる人間は無限に与えられるけど\n　与えられない人間は１回か２回がせいぜい。\n　それが人生だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　被上天所眷顾的人会轻易坐拥无数的机遇，\n　而没被上天所眷顾的人能有一两次机遇就很不错了。\n　这就是人生啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2321,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その１、２回で奇跡を起こせるほど、\n　俺という人間は優れてない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我并没有优秀到，\n　能够把握住寥寥可数的机遇创造奇迹。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2322,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2323,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あれは……、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那是……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2324,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そう、小学生のときだったか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对，是小学的时候吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2325,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　世界は大きな宝石箱だと教えられた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　有人曾告诉我，世界就像是个巨大的宝石箱。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2326,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　キラキラと光り輝くもので満ちた宝石箱だと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　里面塞满了熠熠生辉的宝石。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2327,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その意味は、大人になったいまようやく分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我长大成人后，终于明白了这句话的意思。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2328,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　世界は確かにキラキラで満ちた宝石箱で、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　世界确实是装满了熠熠生辉的宝石的宝石箱，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2329,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　大人ってのはそのキラキラを奪い合う生き物だって。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　成年人对这些事物趋之若鹜。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2330,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　他人を蹴落として奪い合う。\n　奪えなきゃ置いていかれる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　人人都勾心斗角、暗中倾轧。\n　若不如此便会被社会所抛弃。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
