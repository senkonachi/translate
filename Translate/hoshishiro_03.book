                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そしてもうひとつ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　以及另外一点。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
