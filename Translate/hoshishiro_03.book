              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その瞳は怖いくらいキツい真紅を帯びている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但她的瞳孔却是可怕的深红色。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2328,
