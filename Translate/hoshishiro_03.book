            },
            {
              "rowIndex": 3144,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "縁がないほうが幸せな場所だよな。",
                  "",
                  "",
                  "MessageWindow",
                  "与这里无缘的人才更幸福。"
