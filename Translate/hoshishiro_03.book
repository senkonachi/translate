            },
            {
              "rowIndex": 2191,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi1101.ogg",
                  "MessageWindow",
                  "嗯。"
