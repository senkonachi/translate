              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ベンチに腰を下ろした。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　说着，我坐了下去。"
