              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　仕方ない。気持ちは分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这也没办法。可以理解。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2705,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なら、２番目の提案。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那就做出第二个提议吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2706,
              "strings": {
                "Array": [
