                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "戻って来ちゃいましたね。",
                  "",
                  "01_noir/noi0821.ogg",
                  "MessageWindow",
                  "又回来了呢。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1016,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し困り",
