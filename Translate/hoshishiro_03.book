                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1256,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "殺人事件はおきてないです。\nあと連続だと花江さんが２人以上いることになります。",
                  "",
                  "01_noir/noi0624.ogg",
                  "MessageWindow",
                  "没有发生杀人事件。\n如果连续杀人的话花江小姐就要变成两个人了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1257,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "不満そう",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
