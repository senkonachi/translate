              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 303,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　クスクス笑いながらジビエさんが追いかけていった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐笑嘻嘻地追了过去。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 304,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あとのフォローは彼女に任せよう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　之后就交给她来照顾。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 305,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺はのんびり出発を待つ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我就悠闲地坐等发车吧。",
                  ""
                ]
              },
              "isEmpty": 0,
