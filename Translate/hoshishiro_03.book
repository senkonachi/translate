                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そうですね。",
                  "",
                  "01_noir/noi0501.ogg",
                  "MessageWindow",
                  "是啊。",
                  ""
                ]
