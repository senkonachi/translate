              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "チョトしたお散歩デショ？",
                  "",
                  "04_jibie/jib0055.ogg",
                  "MessageWindow",
                  "不就是随便散散步吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 755,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……スウェーデンと日本だと、スケールがちがいますね。",
                  "",
                  "",
                  "MessageWindow",
                  "……瑞典和日本不是一个概念啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
