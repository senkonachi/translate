                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1418,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1419,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　絶対にこちらを見ないように。\n　顔色を隠しながら言い、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他从头到尾都没有看我的脸。\n　始终都没让我看到他的表情。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1420,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1421,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まあもうどうでもいいことです。",
                  "",
                  "06_takase/tak0547.ogg",
                  "MessageWindow",
                  "不过，这些事现在都不重要了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1422,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　やがて何かを吹っ切ったようにこちらを向いた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然后仿佛想通了什么事一般，转头看向我。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1423,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1424,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "呆れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それで？\n話というのは、これだけ？",
                  "",
                  "06_takase/tak0548.ogg",
                  "MessageWindow",
                  "那么？\n要和我说的就是这件事吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1425,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1426,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "や……ここからなんだが。",
                  "",
                  "",
                  "MessageWindow",
                  "不……其实还没进入正题。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1427,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　今の話は、ねりちゃんが言ってたのが\n　こいつのことなのか確かめたかっただけだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚才的话题，只是为了确认小音所说的\n　故事主人公究竟是不是他。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1428,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだが……思ったより深い傷を抉ってしまった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　结果……似乎意外地揭开了他的伤疤。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1429,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょっと踏み込みづらいが、一番聞きたかったのは、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　事到如今变得有点难说出口，但其实我想问的是……，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1430,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1431,
              "strings": {
                "Array": [
                  "",
                  "暁",
