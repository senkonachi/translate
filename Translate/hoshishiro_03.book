              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 754,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ……ハイ。だいじょぶです。",
                  "",
                  "04_jibie/jib0414.ogg",
                  "MessageWindow",
                  "啊……嗯。没事的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 755,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "怖がってるワケでハ。\nその、ちょと、寒くなってキテ。",
                  "",
                  "04_jibie/jib0415.ogg",
                  "MessageWindow",
                  "并不是在害怕。\n那个，只是稍微有点冷。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 756,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　高原はもう下りたはずだが、風が吹き込んで\n　少々肌寒くは感じる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然已经从高原上下来了，但是扑面而来的风，\n　还是稍微有点冷。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 757,
              "strings": {
                "Array": [
                  "",
                  "ジビエ大",
                  "目閉じ悲しい",
                  "",
                  "",
                  "",
