              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2066,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　タバコを手に、最後にホールから出てくる花江さん。",
                  "",
                  "",
                  "MessageWindowMono",
