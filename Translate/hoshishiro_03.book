              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1849,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺やカルハと２人のときは普通なんだけどな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　跟我或狩叶二人独处时还挺正常。"
