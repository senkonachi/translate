                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2361,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いいかも。\nお肉、別にいうほど好きじゃないしぃ。",
                  "",
                  "02_karuha/kar0182.ogg",
                  "MessageWindow",
                  "试试呗。\n本来我也没那么喜欢吃肉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2362,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "じゃあそのニャクルトは捨てろ。\nそれアウトだから。",
                  "",
                  "",
                  "MessageWindow",
                  "那就把你手里的妙乐多扔掉。\n那个也不能喝。",
