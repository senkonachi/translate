            {
              "rowIndex": 2333,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し驚き",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ふええ。",
                  "",
                  "01_noir/noi0205.ogg",
                  "MessageWindow",
                  "是吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2334,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
