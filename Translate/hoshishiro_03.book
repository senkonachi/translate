                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 252,
              "strings": {
                "Array": [
