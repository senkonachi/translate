            },
            {
              "rowIndex": 272,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "このアパートがペット禁止なんだから、大家の娘が\nワガママ言えないわな。",
                  "",
                  "",
                  "MessageWindow",
                  "公寓里禁止养宠物，\n身为房东的女儿也不能任性呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 273,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "甘え",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はあ。\nでもさ、猫ちゃん助けてるとき、ちょっと期待しちゃった。",
                  "",
                  "03_neri/ner0094.ogg",
                  "MessageWindow",
                  "唉。\n不过呢，救下小猫的时候，我稍微期待了一下。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 274,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 275,
              "strings": {
                "Array": [
                  "Tween",
                  "ねり",
                  "PunchPosition",
                  "y=15 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
