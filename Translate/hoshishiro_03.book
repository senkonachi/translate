              "rowIndex": 1008,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　しれっと首を縦に振る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她淡定地点了点头。",
                  ""
                ]
              },
              "isEmpty": 0,
