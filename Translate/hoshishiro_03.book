                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1124,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　首を横に振る花江さん。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　花江小姐摇了摇头。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1125,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　申し訳ないが現状、これが一番しっくり来る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这样的说法最有说服力。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1126,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1127,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　一列につながってる列車の、第一と第四に人がいて、\n　第三の人が見た人影がいなくなる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　排成一列的列车中，第一节和第四节都有人，\n　身处第三车厢的人看到的人影消失了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1128,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　走行中の列車から飛び降りた。\n　とかでない限り、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　倘若，\n　不是在行驶途中跳车了，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1129,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　彼女の見間違い。がしっくり来るだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那她看错就是最容易让人接受的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
