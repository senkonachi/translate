                  "イベント10_e_大",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1118,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "え……約束？",
                  "",
                  "07_mashiro/mas0219.ogg",
                  "MessageWindow",
                  "哎……约定？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1119,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "言ったろ……今度歳の近い子と会ったら、\n自分から話しかける、友達になりに行くって。",
                  "",
                  "",
                  "MessageWindow",
                  "你说了吧……下次如果遇到年龄相仿的孩子，\n想要自己向他搭话，交朋友。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1120,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "さっき……できてなかったぞ、ねりちゃんに。",
                  "",
                  "",
                  "MessageWindow",
                  "刚刚……你对小音她没有做到喔。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1121,
              "strings": {
                "Array": [
                  "",
                  "",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　歳の近い子だったのに。",
                  "",
                  "",
                  "MessageWindow",
                  "　明明你们年龄相仿啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
