            },
            {
              "rowIndex": 1842,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あは、そういうことでは。",
                  "",
                  "01_noir/noi1046.ogg",
                  "MessageWindow",
                  "啊哈，不是这回事啦。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1843,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それくらい……すごく、近い感じというか。\n気兼ねなく接してくれるというか。",
                  "",
                  "01_noir/noi1047.ogg",
                  "MessageWindow",
                  "该怎么说……她非常容易亲近。\n能毫无顾忌地和人交流。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1844,
              "strings": {
                "Array": [
                  "",
