              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1005,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
