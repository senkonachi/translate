                  "ジビエ",
                  "微笑2",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "疑ってるワケデハ。",
                  "",
                  "04_jibie/jib0401.ogg",
                  "MessageWindow",
                  "我也不是在怀疑。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 230,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　苦笑するジビエさん。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐苦笑着说道。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 231,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあ、実際に見た人間でなければ\n　いきなりこんな話されても困るわな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过，若不是亲见那名少女，\n　这种事和谁说也会令人怀疑。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
