                  "",
                  "",
                  "",
                  "",
                  "　<dash=2>ぎゅっ",
                  "",
                  "",
                  "MessageWindowMono",
                  "　<dash=2>抱"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2317,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "<Character=真白大>涙",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ。",
                  "",
                  "07_mashiro/mas0119.ogg",
                  "MessageWindow",
                  "啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2318,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "行こう。",
                  "",
                  "",
                  "MessageWindow",
                  "走吧。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2319,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　逆にもう、抱きしめてやった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我反而紧紧抱起了她。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2320,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どうせ触れてるだけで倒れそうなんだ。\n　どれだけくっついても同じだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　反正只要碰到就仿佛要昏倒一般。\n　那无论贴得多紧都是一样的。",
                  "",
                  ""
                ]
