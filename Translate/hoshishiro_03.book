                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 976,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ずいぶんと蛇行していると見れば、\nそれもありえます。",
                  "",
                  "06_takase/tak0301.ogg",
                  "MessageWindow",
                  "从火车一直蜿蜒前进来看，\n也是有可能的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
