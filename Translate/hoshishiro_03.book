                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1018,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんとなく道なりにきたので、駅についてしまった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我们随便转转，发现回到了车站。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1019,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　みんなは他の場所を探索してるのだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　大家应该是在探索别的地方吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1020,
