              "rowIndex": 1784,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　上手いこと言うな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　话说得真讨喜啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1785,
              "strings": {
