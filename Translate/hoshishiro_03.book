            },
            {
              "rowIndex": 2475,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "くはっっ！",
                  "",
                  "",
                  "MessageWindow",
                  "咕哈！"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2476,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はーっ、はーっ。",
                  "",
                  "",
                  "MessageWindow",
                  "哈～哈～"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2477,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　急激に身体が戻る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　身体的感觉突然恢复了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2478,
              "strings": {
                "Array": [
                  "Se",
                  "SE036",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2479,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　心臓……動いてる。\n　息が吸える。吐ける。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　心脏……还在跳动。\n　吸气。吐气。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2480,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はあっ、はあっ、はあっ。",
                  "",
                  "",
                  "MessageWindow",
                  "哈啊、哈啊、哈啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2481,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　短い時間、溺れてたような状態だ。\n　死にものぐるいで酸素を貪った。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然时间短暂，但我仿佛溺水了一样。\n　拼命地索求着氧气。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2482,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　掴まれていた手が離れている……たぶんこのためだろう。\n　全身に急激に血の気が戻り……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　抓着我的手松开了……应该是这个原因吧。\n　全身上下迅速恢复了血色。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2483,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ああ、でもダメだ。動けない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不，但是还不行。全身动弹不得。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2484,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_白",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2485,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その場に倒れ込むしかできない……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只得躺倒在原地……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2486,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2487,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あれ、でも、なんだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　咦，但是，为什么。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2488,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　心地良い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　好舒适。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2489,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　頭の下に……なにか柔らかいものが……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　脑袋下面……好像有什么柔软的……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
