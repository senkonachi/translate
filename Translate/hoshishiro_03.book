                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2500,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そうそう、煎餅って感じはしないよな。",
                  "",
                  "",
                  "MessageWindow",
                  "对吧，是不是吃起来不像煎饼。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2501,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "MoveBy",
                  "x=10 time=0.5",
                  "",
                  "",
