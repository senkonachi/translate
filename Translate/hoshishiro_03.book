            },
            {
              "rowIndex": 1270,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だーいじょぶだいじょぶ。\n花江さんがいうにはあたしらと同い年くらいらしいし。",
                  "",
                  "02_karuha/kar0731.ogg",
                  "MessageWindow",
                  "没事的没事的。\n花江小姐说和我们年纪相仿。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1271,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し困り",
