            {
              "rowIndex": 1856,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "アンタやジビエさんはうまくやれてるわよね。",
                  "",
                  "02_karuha/kar0407.ogg",
                  "MessageWindow",
                  "你和野鸟小姐都能处好呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1857,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1858,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "大人だからな。",
                  "",
                  "",
                  "MessageWindow",
                  "毕竟我们是大人。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1859,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "MoveBy",
                  "y=-10 time=0.4",
