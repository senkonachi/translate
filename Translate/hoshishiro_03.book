              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1888,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そこにあいつはいた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　它在那里。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1889,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "来いっ！　受けとめるから。",
                  "",
                  "",
                  "MessageWindow",
                  "来吧！　我会接住你的。",
                  "",
                  ""
