                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1008,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "で、そのメラニンがすんごい少ない。\nつまりジビエさんみたいな人が、アルビノ。",
                  "",
                  "02_karuha/kar0715.ogg",
                  "MessageWindow",
                  "然后，黑色素少之又少，\n也就是像野鸟小姐这样的人就是白化。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1009,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
