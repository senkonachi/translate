              "isCommentOut": 0
            },
            {
              "rowIndex": 4,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　猫と聞いて思い出すのは……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一说到猫，我最先想到的是……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 5,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お兄ちゃんいまパンツ見たでしょ！",
                  "",
                  "03_neri/ner0002.ogg",
                  "MessageWindow",
                  "哥哥刚才是不是看到内裤了！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 6,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "見『え』た、\nな。\n見ようとして見たわけじゃない。",
                  "",
                  "",
                  "MessageWindow",
                  "是露出来了。\n我可不是特意看的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 7,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "んもー、エッチねえ。",
                  "",
                  "03_neri/ner0003.ogg",
                  "MessageWindow",
                  "讨厌～，大色狼。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 8,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "エッチなのは否定しない。\nだがエッチだからこそ、そんなお子ちゃまパンツには\n興味がない。",
                  "",
                  "",
                  "MessageWindow",
                  "色我不否定。\n但就是因为好色，\n所以对小孩的内裤不感兴趣。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 9,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なんですってえ！",
                  "",
                  "03_neri/ner0004.ogg",
                  "MessageWindow",
                  "你说什么！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 10,
              "strings": {
