            {
              "rowIndex": 32,
              "strings": {
                "Array": [
                  "",
                  "黒猫",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ふに。",
                  "",
                  "99_mob/kur/kur0002.ogg",
                  "MessageWindow",
                  "呼哧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 33,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　旅の仲間が、遠慮なくヒザの上へあがりこんだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这位旅伴毫不客气地跳上了我的大腿。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 34,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　少し重たくて温かい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　沉甸甸又暖洋洋的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 35,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お前はいつも神出鬼没だな。",
                  "",
                  "",
                  "MessageWindow",
                  "你总是这么神出鬼没的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 36,
              "strings": {
                "Array": [
                  "",
                  "黒猫",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ニィ。",
                  "",
                  "99_mob/kur/kur0003.ogg",
                  "MessageWindow",
                  "咪。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 37,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント1_c2",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
