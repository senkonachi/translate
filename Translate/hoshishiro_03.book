            {
              "rowIndex": 2931,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　<dash=2>きゅっ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　<dash=2>（抓紧）"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2932,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺の袖をつかむカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶紧紧抓住了我的袖子。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2933,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……あっちが道案内で、前に立つはずなんだけどな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……她身为引路人，应该走在前面才对吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2934,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあいいか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　算了。"
                ]
              },
              "isEmpty": 0,
