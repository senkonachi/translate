              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お前ってさ。",
                  "",
                  "",
                  "MessageWindow",
                  "你啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 671,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>通常目少し困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい……？",
                  "",
                  "01_noir/noi0539.ogg",
                  "MessageWindow",
                  "什么……？",
                  ""
                ]
              },
