              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あの女の子に触れられて、\n　急に気分が悪くなったのを覚えてる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　记得碰了那个女孩子后，\n　全身变得难受起来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 121,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだったんだアレは？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　到底怎么了啊那是？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 122,
              "strings": {
