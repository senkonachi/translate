              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1122,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつがこんな声を出すなんてな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　没想到她也会发出这种声音。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1123,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これはもう、家庭内の誰かにしか解決できないことだ。\n　俺が何を言ったって慰めにはならない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这个问题，只有她的家人才解决得了了。\n　不管我说什么都起不到安慰作用。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1124,
              "strings": {
                "Array": [
                  "",
                  "暁",
