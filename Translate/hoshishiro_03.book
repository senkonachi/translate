            },
            {
              "rowIndex": 650,
              "strings": {
                "Array": [
                  "",
                  "男",
                  "<Character=タカセ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "こんばんは。\nあなたもこのツアーに？",
                  "",
                  "06_takase/tak0002.ogg",
                  "MessageWindow",
                  "晚上好。您也是来旅行的？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 651,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ、ども。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯，你好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 652,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　しかもフレンドリーな感じで声を掛けてくる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他友好地向我搭话道。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 653,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こう来られると助かる。\n　こっちも笑顔で返した。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这样一来就放心了。\n　我也笑着回应了他。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 654,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 655,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　イケメンだな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真是个帅哥。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 656,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ髪型がちょっとルーズで、軽そうに見える。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过发型乱蓬蓬的，一幅轻浮的外表。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 657,
              "strings": {
                "Array": [
