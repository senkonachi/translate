                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 724,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ大",
                  "PunchPosition",
                  "y=-15 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 725,
              "strings": {
                "Array": [
                  "",
                  "男",
                  "<Character=タカセ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おっと。\n初めまして、鷹世市蔵といいます。タカセと呼んで下さい。",
                  "",
                  "06_takase/tak0011.ogg",
                  "MessageWindow",
                  "差点忘了。\n初次见面，我叫鹰世市藏。叫我鹰世就好了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 726,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ、どもです。\n鐘城暁。",
                  "",
                  "",
                  "MessageWindow",
                  "啊，好的。\n我叫钟城晓。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 727,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 728,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ大",
                  "PunchPosition",
                  "y=-10 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 729,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "よろしく、鐘城さん。",
                  "",
                  "06_takase/tak0012.ogg",
                  "MessageWindow",
                  "请多关照，钟城先生。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 730,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そこでようやく自己紹介した。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　闲聊了半天，我们才想起来做自我介绍。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 731,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　すんごいふわっとした感じの人だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真是位随和的人啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 732,
              "strings": {
