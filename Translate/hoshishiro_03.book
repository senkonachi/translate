                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　令我疑惑的是，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 379,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　汽車と、内装、中の雰囲気に文句はないのだが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　明明整列火车，及其内部装潢营造的氛围都很让人满意。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 380,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　誰もいないぞ？",
                  "",
                  "",
                  "MessageWindowMono",
