                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2613,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　てことは祖母がいないってのは、\n　単純に早く亡くしたとかか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　没有祖母的原因，\n　估计只是过世得比较早吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2614,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　複雑な家庭事情がなければ、こっちも受けとめやすい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只要家庭背景没那么复杂，我们的话就比较好接。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2615,
              "strings": {
