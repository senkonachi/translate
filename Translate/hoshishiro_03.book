            },
            {
              "rowIndex": 265,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ちょ、え？",
                  "",
                  "02_karuha/kar1164.ogg",
                  "MessageWindow",
                  "喂，哎？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 266,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "涙C",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 267,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "落ちつけ。害はなさそうだ。",
                  "",
                  "",
                  "MessageWindow",
                  "冷静点。应该无害的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 268,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 269,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人の気配ではあるが、人ではないみたいだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　确实有人的气息，但似乎不是真的有人。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 270,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　見える。でも触れない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看得见。却摸不着。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 271,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これくらいならもう驚くほどじゃない。\n　……慣れはしないけどな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这种事我已经见怪不怪了。\n　…… 不过还是不太习惯。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 272,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　女の人は、部屋から少し離れたところで、\n　また別の人物へ駆け寄る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　女人在离房间很近的地方，\n　正在走向另一个人身边。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 273,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　高齢の……白衣を着た老人。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一个高龄的……身穿白衣的老人。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 274,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　医院長と呼ばれたが……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她刚才似乎叫他院长……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 275,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……？",
                  "",
                  "",
                  "MessageWindow",
                  "……？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 276,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あのジイさん、どっかで……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那个老爷子，好像在哪见过……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 277,
              "strings": {
                "Array": [
                  "",
                  "院長",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もう決まったことだ。変更はない。",
                  "",
                  "99_mob/inc/inc0025.ogg",
                  "MessageWindow",
                  "这是决定事项。没有改变的余地。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 278,
              "strings": {
                "Array": [
                  "",
                  "看護師",
                  "<Character=猫村姉>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でも、でもこんなこと。",
                  "",
                  "99_mob/nan/nan0010.ogg",
                  "MessageWindow",
                  "可、可这种事……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 279,
              "strings": {
                "Array": [
                  "",
                  "看護師",
                  "<Character=猫村姉>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "これは違法行為ですよ！",
                  "",
                  "99_mob/nan/nan0011.ogg",
                  "MessageWindow",
                  "是违法的啊！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 280,
              "strings": {
                "Array": [
                  "",
                  "院長",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ならば告発したまえ。\n手術はいまから行う。警察が来るのもそのあとだ。",
                  "",
                  "99_mob/inc/inc0026.ogg",
                  "MessageWindow",
                  "那你就去报警吧。\n手术很快就要开始，即使警察要来也是完成之后的事了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 281,
              "strings": {
