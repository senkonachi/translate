                  "07_mashiro/mas0216.ogg",
                  "MessageWindow",
                  "……知道了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1091,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　強く頷くノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦用力点头。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1092,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　すべて言うとおりにしなくていい。\n　グレーでいい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　也并不一定所有事都要和说的完全一致。\n　不置可否也行。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1093,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ、俺たちの心がノワールの中に残るなら、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只要我们的心留在诺瓦心中，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1094,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺たちのキラキラがノワールの中に残るなら、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只要我们的光芒留在诺瓦心中，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
