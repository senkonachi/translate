                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1875,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　暗闇に浮かぶ、鈍い飴色の炎。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　淡淡的米黄色火焰浮现在黑暗之中，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
