            },
            {
              "rowIndex": 705,
              "strings": {
                "Array": [
                  "",
                  "男",
                  "<Character=タカセ>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "面白そうだと思い申し込みましたが、\nまさかこんな形とは。応募してよかった。",
                  "",
                  "06_takase/tak0008.ogg",
                  "MessageWindow",
                  "一开始觉得蛮有趣的就报名了，\n没想到能有这种体验，真是赚到了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 706,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
