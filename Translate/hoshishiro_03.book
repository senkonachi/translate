            },
            {
              "rowIndex": 1778,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "え、え、わたし？",
                  "",
                  "01_noir/noi0653.ogg",
                  "MessageWindow",
                  "哎，哎，问我吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1779,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し緊張",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1780,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ほっとくとすぐ蚊帳の外なノワールに振る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我转头询问被排除在外的诺瓦。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1781,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺が否定するのは簡単だが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我想否定很容易，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1782,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "閉じ目悩み",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
