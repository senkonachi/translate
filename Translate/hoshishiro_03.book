              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "先に言っておくと、十中八九いない。",
                  "",
                  "",
                  "MessageWindow",
                  "先提醒你一句，十有八九是不在的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2716,
              "strings": {
