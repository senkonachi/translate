              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 192,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺の考えを挟む必要はあるまい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　还是不要考虑多余的事情了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 193,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お化けの声の通りの場所にありました。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　要是说这里正好符合妖怪说的话会让大家害怕的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 194,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　無駄に怖がらせる意味なんてないんだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　没必要制造无端的恐慌。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 195,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "少し驚き",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どこから来たのかはともかく。",
                  "",
                  "06_takase/tak0127.ogg",
                  "MessageWindow",
                  "先不说是从哪来的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 196,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 197,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-15 time=0.8",
