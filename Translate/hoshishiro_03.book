              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 837,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　戸惑うノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦一脸困惑。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 838,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺も困惑だ。こんな反応になるとは。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我也很困惑。没想到会是这样的反应。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 839,
              "strings": {
                "Array": [
