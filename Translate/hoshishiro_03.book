              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1355,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "わたしです。",
                  "",
                  "01_noir/noi0947.ogg",
                  "MessageWindow",
                  "是我。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1356,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "へ？",
                  "",
                  "",
                  "MessageWindow",
                  "哎？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1357,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し緊張",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1358,
              "strings": {
