            },
            {
              "rowIndex": 2189,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　笑顔が可愛い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她笑起来特别可爱。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2190,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それは、顔を描いている側としては、最上級の魅力だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对于正在画肖像的我来说，她的笑容极具魅力。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2191,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　自然と筆が乗った。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我理所当然地将这幅笑容描绘了下来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
