            {
              "rowIndex": 1022,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うん？",
                  "",
                  "",
                  "MessageWindow",
                  "嗯？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
