                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1935,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "眠たいとかじゃなくて、頭ははっきりしてるけれど、\nでも夢の中にいるみたいな。",
                  "",
                  "01_noir/noi0499.ogg",
                  "MessageWindow",
                  "我不是犯困，虽然脑袋很清晰，\n但就好像在梦中一样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1936,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "世界にこんなきれいなものがあるなんて知らなかった。",
                  "",
                  "01_noir/noi0500.ogg",
                  "MessageWindow",
                  "我不知道世界上竟然会有如此美丽的事物。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1937,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1938,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それは、わりと不幸なコトだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这算非常不幸的事情吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1939,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　綺麗なものを知りもしない人生は、不幸だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不知晓美丽事物的人生是不幸的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1940,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……なんて考えちゃうのは、美大卒だからかな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……我会有这样的想法，是因为我是从艺校毕业的吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1941,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　綺麗なものに出会えた人生が幸せであることは\n　間違いないと思うけど。",
                  "",
                  "",
                  "MessageWindowMono",
