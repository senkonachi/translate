                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "は、はい。",
                  "",
                  "01_noir/noi1191.ogg",
                  "MessageWindow",
                  "好、好的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2535,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "不満そう",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
