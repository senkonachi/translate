                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ。",
                  "",
                  "",
                  "MessageWindow",
                  "是啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2087,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　プラネタリウムの主役は言うまでもなく星空だが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然天象馆的主角是星空这点无需多言，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2088,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "目閉じ_喫煙時など",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2089,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　もうひとつ。人の主役とよべる、\n　天体展示の説明役を務めたアナウンスの声。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但还是有一个，由人来担任的主角，\n　那就是负责对天体进行讲解的播音员。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2090,
              "strings": {
                "Array": [
