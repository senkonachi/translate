            },
            {
              "rowIndex": 1932,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いま寝るなよ。火傷するから。",
                  "",
                  "",
                  "MessageWindow",
                  "现在可别睡着。不然会烧伤的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1933,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "分かってますよぅ。",
                  "",
                  "01_noir/noi0498.ogg",
                  "MessageWindow",
                  "我知道的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1934,
              "strings": {
