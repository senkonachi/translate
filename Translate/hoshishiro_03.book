            },
            {
              "rowIndex": 1089,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目「えっと…」",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1090,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
