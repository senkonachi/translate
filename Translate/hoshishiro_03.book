                  "03_neri/ner0260.ogg",
                  "MessageWindow",
                  "我认识……不，这个说法不对。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2153,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "理解してる。あの子のことは。",
                  "",
                  "03_neri/ner0261.ogg",
                  "MessageWindow",
                  "我理解她。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2154,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　微妙にポイントを外したような言い方。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她用微妙的表达否定了我的说法。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2155,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　知らないけど、理解してる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不认识，可是理解。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2156,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どういうことだ？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这是怎么回事？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
