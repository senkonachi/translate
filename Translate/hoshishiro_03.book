              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　花火に戻る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　重新把注意力移向烟花。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2198,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールは……何と言ったらいいか分からないんだろう。\n　さっきまでより集中できてなかったけど、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦……一副欲言又止的表情。\n　精神已不似之前那般集中，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2199,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも花火は気に入ってる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过她还是挺中意烟花的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
