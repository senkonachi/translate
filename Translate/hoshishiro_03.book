              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1368,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ううん、というか、わたしはノワールなのかもしれなくて。\nただわたしのなかには夜羽真白の記憶がある状態で。",
                  "",
                  "01_noir/noi0951.ogg",
                  "MessageWindow",
                  "不对，不如说我可能就是诺瓦。\n只是在我的脑海里有夜羽真白的记忆存在。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1369,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "様子を窺う",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "えっと、えっと。",
                  "",
                  "01_noir/noi0952.ogg",
                  "MessageWindow",
                  "那个，那个。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1370,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お、落ちつけノワール。大丈夫だから。",
                  "",
                  "",
                  "MessageWindow",
                  "冷、冷静一点诺瓦。没事的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1371,
              "strings": {
