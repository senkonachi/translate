            },
            {
              "rowIndex": 2661,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ大",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
