                  "06_takase/tak0164.ogg",
                  "MessageWindow",
                  "你居然还有这本事。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1286,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "美大の出なんでね。",
                  "",
                  "",
                  "MessageWindow",
                  "我是艺校出来的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1287,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　話ながらもペン先を滑らせていく。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我边应和边让笔尖飞舞。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1288,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ラフなスケッチなら、集中せずとも\n　線を乱すことはない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这种简易的素描，\n　不需要太集中的线条也不会画乱。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
