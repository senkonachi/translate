            {
              "rowIndex": 2525,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>ギャグ＞＜",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ぐびぐびぐびぷはー。",
                  "",
                  "04_jibie/jib0147.ogg",
                  "MessageWindow",
                  "咕咚咕咚咕咚噗哈。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2526,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　やっぱりビールはこっちのほうが進むな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　果然花生配酒，越喝越有。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2527,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あとはコレ。チェイサーも置いておくんで、\n交互に飲んで下さいね。",
                  "",
                  "",
                  "MessageWindow",
                  "还有这个。清口水也给你放在这了，\n记得轮着喝。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2528,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ大",
                  "PunchPosition",
