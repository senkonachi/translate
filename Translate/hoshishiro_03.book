            },
            {
              "rowIndex": 1092,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "は！？",
                  "",
                  "",
                  "MessageWindow",
                  "啥！？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1093,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　何も聞こえなかったぞ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我什么都没听到。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
