              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1470,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……探して。",
                  "",
                  "03_neri/ner0208.ogg",
                  "MessageWindow",
                  "……去找出来吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1471,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺にも声が聞こえた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我也听到了声音。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1472,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールたちが見たお化けとはちがう。\n　聞き覚えのある声が、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不同于诺瓦她们看到的妖怪。\n　那声音仿佛在哪里听过……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1473,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "心臓の中に……私が隠してある。探して。",
                  "",
                  "03_neri/ner0209.ogg",
                  "MessageWindow",
                  "我就藏在……心脏之中。找出来吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
