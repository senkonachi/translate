              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　しれっと話題を移す。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　话题转移得僵硬至极。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1263,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつ、だんだん俺にだけは\n　ノリで怒鳴るようになってきてるな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这家伙怎么光针对我，\n　没事就朝我撒火泄愤啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1264,
              "strings": {
                "Array": [
