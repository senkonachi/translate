                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あいつが何か知ってる？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他究竟知道些什么？"
                ]
