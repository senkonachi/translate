                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "夢の方を。",
                  "",
                  "06_takase/tak0328.ogg",
                  "MessageWindow",
                  "在梦里。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 385,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
