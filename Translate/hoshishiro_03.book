                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 856,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "君が望むなら。",
                  "",
                  "",
                  "MessageWindow",
                  "若是你希望，我会做到的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 857,
              "strings": {
                "Array": [
