              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "焼き肉系はいいのよソレ。\n自分の前に置いておけば。",
                  "",
                  "02_karuha/kar0553.ogg",
                  "MessageWindow",
                  "烤肉没事的。\n放在自己面前就可以了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 718,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あう、そ、そうなんですか。",
                  "",
                  "01_noir/noi0417.ogg",
                  "MessageWindow",
                  "啊呜，是、是这样的吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 719,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　確認をとるよう俺を見てくるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦不知道真假，就望向了我。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 720,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあお上品な席でもなし。『焼き直し』はありだ。\n　頷いてみせた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这个场合没那么正式。“重烤”也没问题。\n　我点了点头。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 721,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールは『いいのかな』って顔で、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦露出“可以吗”的表情，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 722,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　歯の形にくぼんだタマネギを網に戻す。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　把印有齿形的洋葱放回网上。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 723,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント5_b",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 724,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そもそもノワール、このタイミングでタマネギ行くなんて\n早い早い。",
                  "",
                  "02_karuha/kar0554.ogg",
                  "MessageWindow",
                  "说到底，诺瓦，在这时候就吃洋葱太早了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 725,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "バベキュは肉！\n肉食べてこそバベキュ！",
                  "",
                  "02_karuha/kar0555.ogg",
                  "MessageWindow",
                  "烤肉就该吃肉！\n吃肉才是烤肉的重点！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 726,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "は、はい。",
                  "",
                  "01_noir/noi0418.ogg",
                  "MessageWindow",
                  "嗯、嗯。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 727,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ほら肉食べてじゃんじゃん食べて。\nここカルビ！　これロース！",
                  "",
                  "02_karuha/kar0556.ogg",
                  "MessageWindow",
                  "来，放开肚子多多吃。\n这是牛排！　这是里脊！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 728,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どっちもミノだよ。",
                  "",
                  "05_hanae/han0121.ogg",
                  "MessageWindow",
                  "你挑的这些全是牛胃肉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 729,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "い、いただきます。",
                  "",
                  "01_noir/noi0419.ogg",
                  "MessageWindow",
                  "我、我开动了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 730,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もむもむ……あちち。",
                  "",
                  "01_noir/noi0420.ogg",
                  "MessageWindow",
                  "嚼嚼……烫烫。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 731,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ど？　ど？　肉でしょ。",
                  "",
                  "02_karuha/kar0557.ogg",
                  "MessageWindow",
                  "怎么样？　怎么样？　果然要吃肉吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 732,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どういう感想だよ。",
                  "",
                  "",
                  "MessageWindow",
                  "那是什么感想啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 733,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もむもむ。",
                  "",
                  "01_noir/noi0421.ogg",
                  "MessageWindow",
                  "嚼嚼。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 734,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どうよノワール。どうよ。",
                  "",
                  "02_karuha/kar0558.ogg",
                  "MessageWindow",
                  "怎么样啊诺瓦。怎么样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 735,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もむもむもむもむ。",
                  "",
                  "01_noir/noi0422.ogg",
                  "MessageWindow",
                  "嚼嚼嚼。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 736,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワールってば。",
                  "",
                  "02_karuha/kar0559.ogg",
                  "MessageWindow",
                  "我说诺瓦啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 737,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ミノは時間かかるんだって。",
                  "",
                  "05_hanae/han0122.ogg",
                  "MessageWindow",
                  "牛胃肉要多烤一会儿。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 738,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　よく噛んで食べてる。良い子だな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　细嚼慢咽。真是个乖孩子。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 739,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "んくんっ。",
                  "",
                  "01_noir/noi0423.ogg",
                  "MessageWindow",
                  "嗯咕。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 740,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "美味しいです。",
                  "",
                  "01_noir/noi0424.ogg",
                  "MessageWindow",
                  "很美味。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 741,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でっしょー！？\nそうなのよそうなのよ。バベキュは肉なのよ。",
                  "",
                  "02_karuha/kar0560.ogg",
                  "MessageWindow",
                  "我就说吧！？\n就是要这样啊。烤肉就是要吃肉啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 742,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい次食べて。どんどん食べて。",
                  "",
                  "02_karuha/kar0561.ogg",
                  "MessageWindow",
                  "来，接着吃。尽管吃。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 743,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ、ありがとうございます。",
                  "",
                  "01_noir/noi0425.ogg",
                  "MessageWindow",
                  "谢、谢谢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 744,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ひょいひょい皿に乗せられる肉を、\n　マイペースにふーふーして食べていくノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦照着自己的节奏夹起堆在盘子上的肉，\n　先呼呼吹凉再吃下肚。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 745,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺がいなくても大丈夫そうだな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看来我不看着也没问题了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 746,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こっちは焼くのに集中しよう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　来集中精力烤肉吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 747,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それでね、塩で食べるのが通だっていうんだけど、\n結局ニンニクどっさりのタレが一番でね。",
                  "",
                  "02_karuha/kar0562.ogg",
                  "MessageWindow",
                  "然后啊，大家都说撒盐吃是最好的，\n但实际上混着大蒜的调料才是最香的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 748,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi0426.ogg",
                  "MessageWindow",
                  "好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 749,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "これちょっとニンニク足りてないわね。",
                  "",
                  "02_karuha/kar0563.ogg",
                  "MessageWindow",
                  "大蒜不太够呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 750,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そこそこ上質な品ですので、味を足す必要はないとの判断かと。",
                  "",
                  "06_takase/tak0259.ogg",
                  "MessageWindow",
                  "肉也挺高级的，应该没什么放调料的必要吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 751,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そのままでおいしーデス。",
                  "",
                  "04_jibie/jib0246.ogg",
                  "MessageWindow",
                  "直接吃就已经很香了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 752,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だね。",
                  "",
                  "05_hanae/han0123.ogg",
                  "MessageWindow",
                  "是的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 753,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　みんな和気藹々と食べてて、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　大家其乐融融地吃着饭，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 754,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント5_b_大",
                  "",
                  "",
                  "-645",
                  "-138",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 755,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "（ひょい、ひょい）",
                  "",
                  "05_hanae/han0124.ogg",
                  "MessageWindow",
                  "（轻轻地、轻轻地）",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 756,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん？　花江さんなにしてんの？",
                  "",
                  "",
                  "MessageWindow",
                  "嗯？　花江小姐在干什么啊？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 757,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ひとり食べるペースが変なのに気付いた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我注意到有个人吃肉的速度很奇怪。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 758,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　自分の前に来た肉を、自分でも食べてるけど、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然她也在吃放到自己面前的肉，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 759,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ひょいひょいと左右に取り分けてる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但却摆到旁边。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 760,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "や、別に。",
                  "",
                  "05_hanae/han0125.ogg",
                  "MessageWindow",
                  "不，没什么。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 761,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もう焼けたやつがあの子にも取りやすいように、\nあと猫舌みたいだから、熱くならないとこにって。",
                  "",
                  "05_hanae/han0126.ogg",
                  "MessageWindow",
                  "就是方便她夹烤好的东西，还有她好像很怕烫的样子，\n所以先晾一会不让她烫到。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 762,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……ああ。",
                  "",
                  "",
                  "MessageWindow",
                  "……这样啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 763,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　見れば肉は火力のこない網の端。\n　それもノワールが取りやすいところに送っていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　仔细一看，肉放到了没有火力的网边。\n　都在诺瓦容易夹到的地方。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 764,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント5_b",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 765,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ひょいパクひょいパクうまー。",
                  "",
                  "02_karuha/kar0564.ogg",
                  "MessageWindow",
                  "一小口一小口好美味<dash=2>",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 766,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんか構わず近くにきたからって\n　食っちゃってるやつもいるが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过也有个家伙毫不顾忌，\n　将花江手边的东西都给吃掉了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 767,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あれはいいんすか。",
                  "",
                  "",
                  "MessageWindow",
                  "她那样没事吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 768,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どれを取るかはその人の自由だろう。",
                  "",
                  "05_hanae/han0127.ogg",
                  "MessageWindow",
                  "要取多少肉吃是个人的自由吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 769,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "（ひょいひょい）",
                  "",
                  "05_hanae/han0128.ogg",
                  "MessageWindow",
                  "（轻轻地轻轻地）",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 770,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　言いながら、気にせず肉の配置を変えて\n　右へ左へ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她一边说着一边毫不在意地改变着肉的位置，\n　一会往左移一会往右移。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 771,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "（ひょいパク）",
                  "",
                  "05_hanae/han0129.ogg",
                  "MessageWindow",
                  "（一口）",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 772,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　途中ちゃんと自分でも食べてる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　夹的时候自己也会吃一点。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 773,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　で、ノワールのほうへ送る理由は分かったが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　至此我已经知道她为什么往诺瓦那边送肉了，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 774,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　もう片方は……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而另一边……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 775,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ひょっとして、俺用？",
                  "",
                  "",
                  "MessageWindow",
                  "难道是给我的？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 776,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お奉行様はどうしても食うのが遅れるだろう。",
                  "",
                  "05_hanae/han0130.ogg",
                  "MessageWindow",
                  "负责烤肉的应该没什么时间吃吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 777,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はは、ども。",
                  "",
                  "",
                  "MessageWindow",
                  "哈哈，谢谢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 778,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　気配り上手だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真体贴啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 779,
