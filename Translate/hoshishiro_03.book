            },
            {
              "rowIndex": 479,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目困惑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "２０年前に潰れたはずのお店が。",
                  "",
                  "06_takase/tak0457.ogg",
                  "MessageWindow",
                  "尽管这店应该二十年前就关门了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
