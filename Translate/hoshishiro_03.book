              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 757,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まあ仕方ありません。\n目的地もない、ただの夜汽車ツアーですからね。",
                  "",
                  "06_takase/tak0015.ogg",
                  "MessageWindow",
                  "这也没办法啦。\n毕竟这趟夜间火车旅行并没有明确的目的地。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 758,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
