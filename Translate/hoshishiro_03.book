            {
              "rowIndex": 2178,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あはっ、やっぱりやってたんだ。",
                  "",
                  "02_karuha/kar0462.ogg",
                  "MessageWindow",
                  "啊哈，果然弄过啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2179,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
