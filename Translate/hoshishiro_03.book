              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 912,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それより、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　先不谈这个。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 913,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
