            },
            {
              "rowIndex": 2707,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　海といいコレといい、\n　こいつが一番このツアー楽しんでないか。",
