                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ、そ、そうなんですか。",
                  "",
                  "01_noir/noi1148.ogg",
                  "MessageWindow",
                  "啊，这、这样啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1083,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1084,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　経費として認められるかもまちまちだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是否将其看做必要经费支出也因人而异。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1085,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常",
                  "",
                  "",
                  "",
                  "",
