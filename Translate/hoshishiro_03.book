              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 759,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
