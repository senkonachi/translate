                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　やっぱダメだ。\n　この身体の腕力じゃコードは抜けそうにない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　果然还是不行。\n　以这身体的力气，实在无法拔掉插头。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1469,
              "strings": {
                "Array": [
                  "",
                  "真白大",
                  "閉じ目悩み",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1470,
              "strings": {
                "Array": [
                  "Tween",
                  "真白大",
                  "PunchPosition",
                  "x=15 time=0.6",
                  "easeInQuad",
                  "",
