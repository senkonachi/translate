                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　はは、と苦笑する。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他哈哈苦笑起来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
