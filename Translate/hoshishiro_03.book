              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2194,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なうっ！",
                  "",
                  "02_karuha/kar0826.ogg",
                  "MessageWindow",
                  "什么！"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2195,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　荷物を積んである棚のうえを指さした。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她指向堆着行李的架子上方。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2196,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2197,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　確かにカーテンがある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那里放着一条窗帘。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2198,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　棚にはよくある収納だな。\n　汚したくないものを置いておくやつ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　好像经常在书架上能看到。\n　为了防尘而盖在上面。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2199,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　現代ならガラス戸とかがつくんだろうが、\n　この汽車のアンティークならカーテンが似合う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　到了现代多用玻璃窗幕代替，\n　不过在古董火车上还是窗帘更合适。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2200,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　で、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那么，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
