            },
            {
              "rowIndex": 1195,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "さっきのスケッチブック、どうなった？",
                  "",
                  "05_hanae/han0054.ogg",
                  "MessageWindow",
                  "刚才那本写生本最后怎么样了？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1196,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん、いえ、どうということも。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯，到最后也没讨论出个所以然。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1197,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そういえばこの人はここで話が止まってるんだっけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对了，她和我们的对话到那就终止了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1198,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっきのやつを改めて見せる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她重新看了看那个本子。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
