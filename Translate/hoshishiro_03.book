              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1546,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……でも。",
                  "",
                  "01_noir/noi0992.ogg",
                  "MessageWindow",
                  "……可是"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
