                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2122,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なあノワール。",
                  "",
                  "",
                  "MessageWindow",
                  "我说诺瓦。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2123,
              "strings": {
                "Array": [
                  "Tween",
                  "Graphics",
                  "PunchPosition",
                  "x=15 time=1",
                  "easeInQuad",
