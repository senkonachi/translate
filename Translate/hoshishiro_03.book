              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 325,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まだ外はずいぶんと暗い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　外面已经变得相当暗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 326,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ星は見えないし、\n　うっすらと紫にくすぶりだしているのが分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽说看不见星星，\n　却能明白它被挡在了紫色天空的后面。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 327,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あっちが東かな？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那边是东方吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 328,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まだ眠気が残ってる。まどろみに揺られる俺。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我的睡意尚未褪去，跟着火车的节奏摇晃。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
