                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　突如カルハが駆け出してしまった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶突然跑走了。"
                ]
              },
              "isEmpty": 0,
