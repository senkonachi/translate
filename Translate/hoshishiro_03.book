              "isCommentOut": 0
            },
            {
              "rowIndex": 939,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はふぅ。",
                  "",
                  "01_noir/noi0806.ogg",
                  "MessageWindow",
                  "哈呜。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 940,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　しばらくしてノワールと外に出た。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　过了一会儿，我和诺瓦从里面走了出来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 941,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　花江さんは中に残ったままだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过花江小姐还留在里面。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 942,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　１人にすると危ないかと思ったが、\n　照れてしまったのかどうしてもノワールとは\n　離れたいみたいだし、無理には誘えない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然让她一个人有点危险，\n　或许是因为害羞，她无论如何都想和诺瓦\n　分开一下，实在不好叫她跟着出来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 943,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "照れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
