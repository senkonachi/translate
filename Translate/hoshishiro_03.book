              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あう、でもこれじゃシロさんが。",
                  "",
                  "04_jibie/jib0416.ogg",
                  "MessageWindow",
                  "啊呜，但这样的话白先生。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 764,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "俺は寒くないからへーき。",
                  "",
                  "",
                  "MessageWindow",
                  "没事，我不冷。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 765,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　涼しいけど、夏は夏だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然挺凉快，但夏天还是夏天。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 766,
              "strings": {
