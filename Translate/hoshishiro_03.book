                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2701,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ベストな提案をしたつもりだが、\n　カルハは口をへの字にして何も答えなかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　原以为做出了最佳的提议，\n　狩叶却站在原地，一言不发。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2702,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……お姉さんが消えたままというのはイヤ、か。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……不想发现姐姐消失后什么都不做就离开吗。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2703,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "涙C",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
