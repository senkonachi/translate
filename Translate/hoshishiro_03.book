            {
              "rowIndex": 1431,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なんか扱いっていうか、手慣れてない？",
                  "",
                  "02_karuha/kar0324.ogg",
                  "MessageWindow",
                  "看你用起来好像得心应手的？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1432,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1433,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そりゃスケブはよく使ってたよ。昔な。",
                  "",
                  "",
                  "MessageWindow",
                  "写生本这东西在以前本来就很常用啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1434,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1435,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　懐かしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　有点怀念。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1436,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　美大のときはよく仲間とコレ持って\n　色んなとこ旅行したっけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　上艺校的时候，\n　经常和朋友一起带着它去各种各样的地方旅行。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1437,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
