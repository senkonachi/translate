                  "",
                  "",
                  "",
                  "でも、ダイジョーブ、楽になってきマシタ。",
                  "",
                  "04_jibie/jib0462.ogg",
                  "MessageWindow",
                  "不过没关系，已经感觉好起来了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1044,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　やや力なく笑う彼女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她笑得有些无力。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
