              "rowIndex": 675,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　とか聞くと、傷つけるかも。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　如果直接问出口的话，可能会伤害到她。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
