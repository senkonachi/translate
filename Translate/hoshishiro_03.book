                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "元の駅に戻るというのが、少々億劫で。",
                  "",
                  "06_takase/tak0311.ogg",
                  "MessageWindow",
                  "只是觉得不愿回到起点站。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1024,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
