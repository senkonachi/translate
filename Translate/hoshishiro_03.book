            },
            {
              "rowIndex": 1038,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はいはい、やってやるって。",
                  "",
                  "",
                  "MessageWindow",
                  "行啦行啦，我帮你开。"
                ]
              },
              "isEmpty": 0,
