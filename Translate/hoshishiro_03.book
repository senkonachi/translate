                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 773,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ジビエさん、休んでたほうがいいよ。",
                  "",
                  "",
                  "MessageWindow",
                  "野鸟小姐，你去休息一下吧",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 774,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　話題をここで終わらせるのは困るが、\n　怖がってる人には聞かせたくない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽说我不想让这个话题就此结束，\n　但也不希望让害怕的人听到。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 775,
              "strings": {
                "Array": [
                  "",
                  "ジビエ大",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
