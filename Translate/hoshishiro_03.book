                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　改めて感嘆の息をつく。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她再次发出感叹声。",
                  ""
                ]
              },
