                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここは俺が知りたいことだけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　或许我只想有个答案。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 683,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　つまり、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　换个问法吧，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 684,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "不満そう",
                  "",
                  "",
                  "",
