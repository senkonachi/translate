              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　うお、寒。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　呜喔，好冷。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 922,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ベッドに寝転がって、そのまま寝てた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　倒在床上就这么睡着了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 923,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　掛け布団すらしなかったから、３月の気温はかなり寒い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　连被子都没盖上。三月的气温还是挺冷的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 924,
              "strings": {
