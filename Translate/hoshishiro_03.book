            },
            {
              "rowIndex": 1587,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "転んでしまいそうな子供を受けとめてあげる大人。",
                  "",
                  "06_takase/tak0421.ogg",
                  "MessageWindow",
                  "扶起跌倒的孩子的大人。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1588,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "中学のころは、この主人公に実に移入しました。\n僕もそういう存在になりたいと思ったものです。",
                  "",
                  "06_takase/tak0422.ogg",
                  "MessageWindow",
                  "中学时候，我真的是与这小说的主人公感同身受。\n想着自己也要成为这样的人。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1589,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1590,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-30 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
