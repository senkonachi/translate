              "isCommentOut": 0
            },
            {
              "rowIndex": 1199,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　よろしいお店って感じはしない。\n　乗り込むなら、女よりは男だろう。",
                  "",
