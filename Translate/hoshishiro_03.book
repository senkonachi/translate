                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3020,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "様子を窺う",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3021,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3022,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "は、はい。\n子供はなんでも食べるべきだと。",
                  "",
                  "01_noir/noi0358.ogg",
                  "MessageWindow",
                  "是、是的。\n他说孩子什么都要吃。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3023,
