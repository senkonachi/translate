              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1024,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　変化といえば、人の変化だけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　要说变化，那也只有人的变化而已。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1025,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お飲み物、どうですか。",
                  "",
                  "01_noir/noi0874.ogg",
                  "MessageWindow",
                  "要来点饮料么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1026,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ、サンキュ。",
                  "",
                  "",
                  "MessageWindow",
                  "喔，谢了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1027,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お茶を持ってきてくれたようだ。\n　受け取る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看来是给我端茶来了。\n　我接了过来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1028,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールも向かいの席に座って、\n　自分の分の缶ココアに指をかけた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦坐在我对面，\n　准备用手指打开罐装可可。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
