            },
            {
              "rowIndex": 2122,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "一緒に食べたかったんだろ？",
                  "",
                  "",
                  "MessageWindow",
                  "你也想一起吃吧？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2123,
              "strings": {
                "Array": [
                  "",
