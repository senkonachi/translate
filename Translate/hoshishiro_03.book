                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　髪をくしゃりといじるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　开始摆弄起自己的头发。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1936,
              "strings": {
                "Array": [
