              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　外に向き直る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我转身朝外。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1651,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いつもの俺の家の近く。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　来到了我家的附近。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1652,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　３月のものとはいえ、見慣れた光景なのに……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽说还只是三月，这景象也已经十分熟悉……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1653,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なぜだろう。\n　ひどく懐かしいような気がした。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　究竟是为什么呢。\n　总觉得有种非常怀念的感觉。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
