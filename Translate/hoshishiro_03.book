            },
            {
              "rowIndex": 2171,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……悪いな、俺の自己満で。",
                  "",
                  "",
                  "MessageWindow",
                  "……抱歉啊，都是我的自我满足罢了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
