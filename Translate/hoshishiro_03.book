              "strings": {
                "Array": [
                  "",
                  "花江",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "不思議なことをほじくり返すなら、\nまずあの子の耳からじゃない。",
                  "",
                  "05_hanae/han0167.ogg",
                  "MessageWindow",
                  "要对这件怪事追根究底的话，\n先从她的耳朵开始调查比较好吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 450,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ……ですね。",
                  "",
                  "",
                  "MessageWindow",
                  "啊……这话没错。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 451,
