            },
            {
              "rowIndex": 2029,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "言っとくが似顔絵はあんまり自信ないからな。",
                  "",
                  "",
                  "MessageWindow",
                  "打个预防针，我对肖像画可没什么自信。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2030,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　仲は……よかったよな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　关系……真的很好啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2031,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　アニメーター。\n　アニメを描く仕事、なんてのが新鮮に映ったんだろう。\n　たぶん気に入られていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　动画师。\n　画动画的工作，在她看来很新鲜吧。\n　她大概很感兴趣。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
