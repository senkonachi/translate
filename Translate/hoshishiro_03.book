            {
              "rowIndex": 2179,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あれか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那个么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
