            },
            {
              "rowIndex": 1652,
              "strings": {
                "Array": [
                  "",
                  "看護師",
                  "<Character=猫村姉>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "真白さん！？　真白さん！",
                  "",
                  "99_mob/nan/nan0032.ogg",
                  "MessageWindow",
                  "真白小姐！？　真白小姐！",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1653,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お姉さんの呼ぶ声が遠い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我快要听不见护士姐姐呼唤我的声音了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1654,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　すいません。もう返事できません。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对不起。我已经无法回答了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1655,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　身体のほう、なんとか生かしといてください。\n　ノワールの大事な身体なんで。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　希望你能让这副身体存活下来。\n　因为这是诺瓦重要的身体。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1656,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　すぐに、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我这就，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
