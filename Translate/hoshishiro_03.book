              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　低く、感情の読めない声で言い、目をそらす彼女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她撇开视线，用听不出感情的声音低喃着。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 876,
              "strings": {
                "Array": [
                  "",
                  "花江",
