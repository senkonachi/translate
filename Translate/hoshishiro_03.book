            {
              "rowIndex": 958,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うお。\nこ、これ汽車用のボイラー？",
                  "",
                  "",
                  "MessageWindow",
                  "喔。\n这、这就是火车用的锅炉？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 959,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
