            },
            {
              "rowIndex": 1836,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あは。",
                  "",
                  "01_noir/noi0055.ogg",
                  "MessageWindow",
                  "哇。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1837,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "空のほうなら安心だろ。",
                  "",
                  "",
                  "MessageWindow",
                  "还是天空更让人放心吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1838,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi0056.ogg",
                  "MessageWindow",
                  "是的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1839,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こちらはただ綺麗なだけだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　天空美得纯粹。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1840,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それからまたおっかなびっくり湖をのぞき込み、\n　また空を見上げて。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然后，她战战兢兢地看向湖面，\n　又望向天空。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1841,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　世界の美しさに対応できない感じの彼女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　面对万千美景，却又不知道该如何表达感想。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1842,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
