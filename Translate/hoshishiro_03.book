            },
            {
              "rowIndex": 1294,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ですね。こちらへ。",
                  "",
                  "06_takase/tak0053.ogg",
                  "MessageWindow",
                  "说得对。走这边。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1295,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ガサガサと茂みをかき分けて、来た道へ戻るタカセ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世拨开茂密的树丛，带我返回来时的那条路。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1296,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　汽車に積み込む石炭を１つ持ってきたらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他好像拿了一块火车上载的煤炭。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
