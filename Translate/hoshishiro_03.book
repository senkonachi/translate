              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1269,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "先ほどジビエさんとすれちがいました。",
                  "",
                  "06_takase/tak0049.ogg",
                  "MessageWindow",
                  "刚才我和野鸟小姐她们碰过面了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1270,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お２人は僕がいると困るそうなのでこちらの補佐に。\n服は見付かりました？",
                  "",
                  "06_takase/tak0050.ogg",
                  "MessageWindow",
                  "如果我在场她们两个也不太方便，所以到这来帮忙了。\n衣服找到了吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1271,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いや、えと。",
                  "",
                  "",
                  "MessageWindow",
                  "还没有……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1272,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ大",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1273,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>少し驚き",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ、あれですね。",
                  "",
                  "06_takase/tak0051.ogg",
                  "MessageWindow",
                  "啊，是那个吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1274,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　見ると、すぐ側の木々に白いものが引っかかっている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我扭头一看，发现附近的树杈上挂着些白色的东西。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1275,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　カルハが羽織ってた車掌服だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　是狩叶披的那件乘务员制服。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1276,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ大",
                  "MoveBy",
                  "y=10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1277,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ふふ、お化けが出る、と聞きましたが、\n確かにこうして見ると不気味ですね。",
                  "",
                  "06_takase/tak0052.ogg",
                  "MessageWindow",
                  "哈哈，听说有妖怪出来什么的，\n这么一看还真是挺阴森的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1278,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だな……。",
                  "",
                  "",
                  "MessageWindow",
                  "是啊……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1279,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　木に引っかかって揺れる服。\n　確かに不気味だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　衣物在树上随风飘扬。\n　令人不寒而栗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1280,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お化けっぽい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　像被妖怪附体一般。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1281,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつが声は出さないだろうか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　应该不会突然开口说话吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1282,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "んと……あった、ノワールの服もこっちに。",
                  "",
                  "",
                  "MessageWindow",
                  "还有……找到了，诺瓦的衣服也在这边。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1283,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ワンピースが綺麗に折りたたんでおいてある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　连衣裙叠好了落在那。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1284,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その近くにカルハの服……あった、懐中時計も。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　旁边还有狩叶的衣服……怀表也在。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1285,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1286,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　２人は建物のなかで脱いだって言ってたよな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她们不是说是在建筑物里脱衣服的吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1287,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　建物なんてどこにもない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这里连个建筑物的影子也没有。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1288,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　けど、いまはそんなこと気にしてられない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过现在也管不了那么多了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1289,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "とっとと行こうぜ。今度は俺たちが遭難しちまう。",
                  "",
                  "",
                  "MessageWindow",
                  "赶快回去吧。别到时候轮到我们遇难了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1290,
