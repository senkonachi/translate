              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1821,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "な、なんですかこれ、すごい。",
                  "",
                  "01_noir/noi0051.ogg",
                  "MessageWindow",
                  "这、这是什么啊，好漂亮。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1822,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "星の海……ってところかな。\n夜汽車の旅の醍醐味さ。",
                  "",
                  "",
                  "MessageWindow",
                  "这就是……所谓的星海吧。\n可以说是夜间火车旅行的点睛之笔。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1823,
              "strings": {
                "Array": [
                  "",
                  "",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　といってもここまでいいロケーションは俺も初だが。",
                  "",
                  "",
                  "MessageWindow",
                  "　实际上我也是初次看到此番瑰丽的美景。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1824,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ふわああ。",
                  "",
                  "01_noir/noi0052.ogg",
