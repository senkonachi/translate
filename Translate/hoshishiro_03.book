                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 727,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "ドヤ真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ｍｎ……ワタシ一度寝たら起きないし、\n起こされると暴れマース。",
                  "",
                  "04_jibie/jib0052.ogg",
                  "MessageWindow",
                  "mn……我只要睡了中途就不会醒，\n而且起床气非常重！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 728,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　怖い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　好可怕。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 729,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 730,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあ内容はともかくとして、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　先不管行程如何，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 731,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　森林浴というのは久方ぶりで、楽しかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我很久没体验过森林浴了，还挺舒心的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 732,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　最近働き過ぎてたからな。\n　夜汽車もいいけど、こっちもリフレッシュにちょうどいい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　最近的工作太累人了。\n　夜间火车是一种享受，大自然又是另一种放松。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 733,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 734,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ジビエさんとの会話も、良い具合に弾むから楽しいし。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　和野鸟小姐聊得也很投入。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 735,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただ……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只是……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 736,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なにもないな。",
                  "",
                  "",
                  "MessageWindow",
                  "什么都没有啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 737,
              "strings": {
