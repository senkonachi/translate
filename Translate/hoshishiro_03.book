            },
            {
              "rowIndex": 315,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あれ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　奇怪。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 316,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ああ、寝ちゃってたか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　啊，我睡着了啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 317,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　花火のあと、汽車に戻って、\n　そのままうとうとしてしまったらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　放完烟花之后我们回到了火车上，\n　似乎就那样迷迷糊糊地睡过去了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 318,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "閉じ目",
