            },
            {
              "rowIndex": 2192,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "シロさんが、わたしの似顔絵を描いてくれる。",
                  "",
                  "01_noir/noi1102.ogg",
                  "MessageWindow",
                  "到时候，白先生就会给我画我的肖像。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
