              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 316,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>閉じ目笑顔2",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "滞在時間は６時間。\nどうか出発の際は早めの集合をお願いいたします。",
                  "",
                  "02_karuha/kar0099.ogg",
                  "MessageWindow",
                  "停车时间为六小时。\n请务必在启程前尽早集合。",
                  ""
