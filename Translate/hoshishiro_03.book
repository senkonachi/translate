                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これだけでここに来た価値がある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　光是这点就不虚此行。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1999,
