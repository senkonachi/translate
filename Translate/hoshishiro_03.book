                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 253,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　車掌さんが、あまり車掌らしくないことを言いつつ\n　飛び出していった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　乘务员说着不像是乘务员该说的话，\n　快步跑出了车厢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 254,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　外……そういえばもう日が出てる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　外面……这么一说，太阳已经露头了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 255,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　泊まりのツアーとはいえ、一晩ここですごしたのか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一晚上都花在这里了，虽说本身就是车宿型的旅行。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 256,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 257,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　うん、たぶんミスってるなあの子。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　嗯，她估计是出失误了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 258,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ベッドもないところで客を寝かせるツアーは多くない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一般很少有旅行会让客人睡在连床都没有的地方。",
                  ""
                ]
