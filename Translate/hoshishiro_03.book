            },
            {
              "rowIndex": 1881,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　かすかな声がした。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　传来微弱的声音。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1882,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どこからかは分からないが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然不知道在哪里，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1883,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺は知ってる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是我认识那个声音。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1884,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "下りてこい。今日はねりちゃんがいない。",
                  "",
                  "",
                  "MessageWindow",
                  "下来吧。今天小音不在。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1885,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　近くの植木に向かって声を掛けた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我对附近的绿化树木说。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1886,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　前にねりちゃんと２人で猫を助けた木<dash=2>。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那是之前我和小音一起救了小猫的树<dash=2>"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1887,
              "strings": {
                "Array": [
                  "",
                  "黒猫",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……ニィ。",
                  "",
                  "99_mob/kur/kur0014.ogg",
                  "MessageWindow",
                  "……咪。",
                  "",
                  ""
                ]
