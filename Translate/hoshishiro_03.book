              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 172,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　見覚えのある部屋。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这房间我有印象。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 173,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　前も確か夢で……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　之前也在梦里……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 174,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　身体を起こした。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我坐起身。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 175,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ひどくだるい……し、眠い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　好累……而且好困。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 176,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　気分が悪い。\n　お腹がキリキリと痛む。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　好难受。\n　肚子疼得不行。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 177,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　意識が飛ぶほど気持ち悪くて、痛い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　又恶心又痛，感觉要昏过去了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
