              "rowIndex": 527,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どこを通っているか、は、分かりませんが。",
                  "",
                  "06_takase/tak0466.ogg",
                  "MessageWindow",
                  "虽然不清楚到底是往哪开的。",
