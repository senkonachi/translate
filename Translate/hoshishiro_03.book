              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　しれっと重い方を客に担当させるなよ。\n　別にいいけど。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　能不能别这么若无其事地让客人拿重物啊。\n　算了，不计较了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2734,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　荷物を受け取る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我顺手接了过来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
