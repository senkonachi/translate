            },
            {
              "rowIndex": 660,
              "strings": {
                "Array": [
                  "",
                  "男",
                  "<Character=タカセ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ふぅ。（ぽりぽり）",
                  "",
                  "06_takase/tak0003.ogg",
                  "MessageWindow",
                  "呼。（揉）",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 661,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いやルーズとはちがうか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　啊，看来不是天生的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 662,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　後頭部に手をやって、自分で自分の髪を\n　くしゃくしゃとかきまぜていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他随手将手伸向脑后，\n　把头发揉得乱糟糟的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 663,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 664,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ大",
                  "MoveBy",
                  "y=10 time=1.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 665,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いるよな。こういうクセの人。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　确实有人会有这种习惯。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 666,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　おかげで髪がちょっとくしゃけて、頼りない印象を受けた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不经意地把头发搞得如一团乱麻，从而给人一种不靠谱的印象。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
