              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 194,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ……一緒に見たな。",
                  "",
                  "",
                  "MessageWindow",
                  "记得呢……一起看了星空吧。",
