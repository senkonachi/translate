                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3018,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "通常_口開き",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おじいさまは食べてよいと？",
                  "",
                  "04_jibie/jib0225.ogg",
                  "MessageWindow",
                  "爷爷说可以吃？",
                  ""
                ]
              },
              "isEmpty": 0,
