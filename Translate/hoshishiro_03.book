            {
              "rowIndex": 1478,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi0965.ogg",
                  "MessageWindow",
                  "好的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1479,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　肩を抱く手で、背中や二の腕をさする。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我用抱住她双肩的手，抚摸着她的后背与手臂。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1480,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d_大",
                  "",
                  "",
                  "400",
                  "-100",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1481,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　温かいんだろう。ノワールは気持ちよさそうに目を細めた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　应该是感觉很温暖吧。诺瓦舒适地半眯着眼。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1482,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こういう反応、マジで猫っぽいと思ってたんだが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这种反应看上去真的像猫咪一样，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1483,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　夜羽真白……か。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　夜羽真白……啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1484,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_b_大",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1485,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi0966.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1486,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "わたしの名前は……夜羽真白です。",
                  "",
                  "01_noir/noi0967.ogg",
                  "MessageWindow",
                  "我的名字……叫夜羽真白。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1487,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "小さいころはシロちゃんって呼ばれてました。\nあだ名がシロでした。",
                  "",
                  "01_noir/noi0968.ogg",
                  "MessageWindow",
                  "小时候被叫做小白。\n外号叫白。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1488,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_a_大",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1489,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "奇遇だな。",
                  "",
                  "",
                  "MessageWindow",
                  "真巧啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1490,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d_大",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1491,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "えへ、そうですね。\nシロさんのあだ名もシロにできるって気付いて、\n嬉しかった。",
                  "",
                  "01_noir/noi0969.ogg",
                  "MessageWindow",
                  "哎嘿，是这样的。\n发现白先生的外号也叫白，\n就很开心。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1492,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そういや最初のとき、なんか笑ってたっけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　说起来一开始好像还笑过的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1493,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ちょっと羨ましいんです。",
                  "",
                  "01_noir/noi0970.ogg",
                  "MessageWindow",
                  "稍微有点羡慕。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1494,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "わたしのこと、シロちゃんって呼んでくれる人は\nもういないから。",
                  "",
                  "01_noir/noi0971.ogg",
                  "MessageWindow",
                  "毕竟会叫我小白的人，\n已经不在了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1495,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どうして？",
                  "",
                  "",
                  "MessageWindow",
                  "为什么？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1496,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_b_大",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1497,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "シロ、と呼ぶのは差別的だとか、病気をからかっているとか\n大人の人たちが怒るので、誰も呼んでくれなくなりました。",
                  "",
                  "01_noir/noi0972.ogg",
                  "MessageWindow",
                  "称呼白是差别对待、拿疾病来调侃之类的，这样做大人们会生气，所以谁都不再这么叫了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1498,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "わたしは髪も肌も真っ白なので。",
                  "",
                  "01_noir/noi0973.ogg",
                  "MessageWindow",
                  "因为我头发和皮肤都是纯白的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1499,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……アルビノなのか？",
                  "",
                  "",
                  "MessageWindow",
                  "……白化病吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1500,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi0974.ogg",
                  "MessageWindow",
                  "是的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1501,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "生まれたときから髪も肌も白くて、目は赤で、\nお医者さまによく見ていただきました。",
                  "",
                  "01_noir/noi0975.ogg",
                  "MessageWindow",
                  "生下来的时候头发和皮肤是白色的，眼睛通红，经常去看医生。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1502,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まぶしいのが苦手で、\nお天気の良い日は外にも出られなくて。",
                  "",
                  "01_noir/noi0976.ogg",
                  "MessageWindow",
                  "不适应耀眼的阳光，连在天气好的时候出去散步也做不到。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1503,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "学校にもあまり行けなくて……。",
                  "",
                  "01_noir/noi0977.ogg",
                  "MessageWindow",
                  "学校也没怎么去过……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1504,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1505,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　口数が減っていく。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　话开始少了起来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1506,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　先天的に、日常生活が送りにくい障害。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　先天性的，让人无法正常生活的障碍。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1507,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　見た目にも明確な違いが出る。\n　本人の望む望まざるに限らず目立ってしまう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而且从外表来看也很不一样。\n　无论本人到底愿不愿意，都会变得瞩目。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1508,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "辛かったな。",
                  "",
                  "",
                  "MessageWindow",
                  "生活很难过吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1509,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……いえ。",
                  "",
                  "01_noir/noi0978.ogg",
                  "MessageWindow",
                  "……没有的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1510,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_a_大",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1511,
              "strings": {
                "Array": [
                  "Tween",
                  "Graphics",
                  "PunchPosition",
                  "y=-15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
