            },
            {
              "rowIndex": 1198,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "怒鳴りこむなら男の方が良いでしょう。",
