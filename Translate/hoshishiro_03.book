              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　追いついた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　追上了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1978,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　追いついたというか、汽車がほとんど動いてない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　与其说是追上了，倒不如说火车几乎就没动。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1979,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まだかろうじてのろのろと揺れてはいるが……。\n　おそらくもうエンジンは停止しているのだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然还勉强在晃动……\n　估计引擎已经熄火了吧。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
