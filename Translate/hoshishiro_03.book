                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺のことばっかり？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　说我？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
