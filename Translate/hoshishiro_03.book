            },
            {
              "rowIndex": 1847,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールは、話をふられると毎度たじたじである。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　每次把话题抛给诺瓦的时候，她都会畏畏缩缩的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1848,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "閉じ目悩み",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
