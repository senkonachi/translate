              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1442,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　しばらくこうして、背中を撫でてやった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我暂时保持这样抚摸着她的后背。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
