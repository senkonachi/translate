            {
              "rowIndex": 1721,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "楽しいです。",
                  "",
                  "01_noir/noi1029.ogg",
                  "MessageWindow",
                  "很开心。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1722,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　返事はすぐだった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　几乎是秒答。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1723,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "閉じ目",
                  "",
                  "",
