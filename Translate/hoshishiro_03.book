              "rowIndex": 2738,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。\n……？",
                  "",
                  "",
                  "MessageWindow",
                  "好的。\n……？",
                  ""
