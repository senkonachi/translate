                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 342,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　たぶんこれから、この子をもっと傷つけることが起きる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　今后大概会发生更令她伤心的事。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 343,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いまのままじゃダメだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　所以不能继续维持现状了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 344,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お母さんの言葉に従うのでも、\n　俺の言葉に従うのでもない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　并非遵从母亲的话，\n　也并非遵从我的话。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 345,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　この子自身が、自分のなかにある命を受けとめないと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她必须接受存在于自己身体内的另一个生命。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 346,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワール自身が生きようとしないと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦自己必须有活下去的欲望。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 347,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント3_a_大",
                  "",
                  "",
                  "-200",
                  "-100",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 348,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "シロさん……？",
                  "",
                  "01_noir/noi1293.ogg",
                  "MessageWindow",
                  "白先生……？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 349,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ、うん。",
                  "",
                  "",
                  "MessageWindow",
                  "啊，嗯。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 350,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 351,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "綺麗だな。",
                  "",
                  "",
                  "MessageWindow",
                  "真美啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 352,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ……はい。",
                  "",
                  "01_noir/noi1294.ogg",
                  "MessageWindow",
                  "啊…是的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 353,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　また話が戻って、星空へ向きなおるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　又回到了刚才的话题。诺瓦再次仰头望向星空。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 354,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　吸い込まれそうな闇の中に、煌めく星々。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　在那仿佛要将人吸入的黑暗之中，闪耀的群星。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 355,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そこにはないもののはずなのに、\n　いまにも手が届きそうなところで瞬いていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那些闪闪发亮的星星看上去有如近在眼前，\n　感觉只要伸出手就能触摸得到。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 356,
              "strings": {
                "Array": [
                  "BgEventOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 357,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "0",
                  "0",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 358,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　手が届くことなんて決してないのに。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但实际上根本不可能摸到。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 359,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント3_a_大",
                  "",
                  "",
                  "-200",
