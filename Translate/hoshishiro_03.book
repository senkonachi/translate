                  "",
                  "",
                  "3",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1155,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　宝石はもう、俺の手の中には残っていない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我的手心里已经，没有宝石了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
