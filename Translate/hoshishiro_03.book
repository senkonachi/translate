            },
            {
              "rowIndex": 1971,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　よっぽど驚いたんだろう……でも、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看样子她吓得不轻……不过，",
                  ""
