            },
            {
              "rowIndex": 2140,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント1_d",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
