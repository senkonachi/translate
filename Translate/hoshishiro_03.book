                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　よし。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　很好。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1149,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　慰めは出来ないけど、空気を変えるくらいなら。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然没法安慰，但至少能改变一下气氛。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1150,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ大",
                  "PunchPosition",
                  "y=15 time=1",
