                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お兄ちゃん、起きて。",
                  "",
                  "03_neri/ner0022.ogg",
                  "MessageWindow",
                  "哥哥，快起来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 39,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　確か……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我记得……",
                  ""
                ]
              },
              "isEmpty": 0,
