            },
            {
              "rowIndex": 2662,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　知らない顔だが、カルハとは気さくに話してる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　之前没见过他，不过他和狩叶聊得很自然。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2663,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　主催側の人間。ってことかな。\n　いまもエンジンをメンテしてるんだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　估计是主办方的人吧。\n　看不到他可能是在维护引擎。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2664,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "逸らし目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2665,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ大",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2666,
              "strings": {
                "Array": [
                  "",
                  "駅員",
                  "<Character=院長>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お肉は冷蔵庫に。\n道具はいま持ってきますので。",
                  "",
                  "99_mob/inc/inc0008",
                  "MessageWindow",
                  "肉在冰箱里。\n工具我现在就去拿。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2667,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "閉じ目笑顔2",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ういーっす。",
                  "",
                  "02_karuha/kar0508.ogg",
                  "MessageWindow",
                  "好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2668,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ大",
                  "PunchPosition",
                  "y=10 time=2",
