                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　入り口を隠すかたちでついているカーテンを",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦摊开那面"
                ]
              },
              "isEmpty": 0,
