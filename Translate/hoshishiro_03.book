              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2115,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi1083.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2116,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただノワールにとっては、そこが憧れみたいだった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是对诺瓦来说，这应该是值得憧憬的关系。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2117,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2118,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ならそれは叶って欲しいけど……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那我也想帮助她完成这个愿望……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2119,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　カルハが相手じゃ簡単すぎるな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对象是狩叶的话就简单多了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2120,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2121,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_a",
                  "",
                  "",
                  "0",
                  "0",
                  "1",
                  "",
