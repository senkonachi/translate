              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……悪かったわよ。テンション上がってたのよ。",
                  "",
                  "02_karuha/kar0418.ogg",
                  "MessageWindow",
                  "……我错啦。怪我情绪太高涨了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1918,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "逸らし目照れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
