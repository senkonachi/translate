                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1062,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　実際には会ったことないので聞きかじりだが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我没有亲眼见过，也只是道听途说，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1063,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　アルビノ種の人が日光にあたるのは、\n　ガチで命に関わるそうな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但白化病人碰到日光，\n　或许真的会危及性命。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1064,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　肌もだが、それ以上に、目だ。\n　サングラスしないでアスファルトに反射した日光を見て、\n　それだけで失明した人もいるとか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　肌肤如此，眼睛更甚。\n　不戴太阳镜直视柏油路上反射的日光，\n　因此失明的也大有人在。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1065,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
