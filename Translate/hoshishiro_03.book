            },
            {
              "rowIndex": 2182,
              "strings": {
                "Array": [
                  "Wait",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
