              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いるかな。",
                  "",
                  "02_karuha/kar1084.ogg",
                  "MessageWindow",
                  "会不会在呢。"
                ]
