              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 921,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
