              "rowIndex": 1225,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　終点についたら、俺たちは戻れるのか？",
                  "",
                  "",
                  "MessageWindowMono",
