                  "ジビエ",
                  "ドヤ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ハイ、家の周りずっとコーデス。",
                  "",
                  "04_jibie/jib0044.ogg",
                  "MessageWindow",
                  "是的，我家附近都是这样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 690,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はは、羨ましいな。",
                  "",
                  "",
                  "MessageWindow",
                  "哈哈，真羡慕。",
                  ""
