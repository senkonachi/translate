              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2515,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>虚ろ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "肴にはなりマセンネ。",
                  "",
                  "04_jibie/jib0145.ogg",
                  "MessageWindow",
                  "不适合当下酒菜呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2516,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ですね。",
                  "",
                  "",
                  "MessageWindow",
                  "是吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2517,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　酒と合わせるには、上品すぎてちょっと物足りない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　作为下酒菜来说太清淡了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2518,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　酒の肴はやはり塩と油がガツンとこないとな。\n　ピーナッツを渡した。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　下酒菜突出的就是个油盐味。\n　我转手便递给她一包花生下酒。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
