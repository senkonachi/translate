                  "MessageWindow",
                  "……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1068,
              "strings": {
                "Array": [
                  "",
                  "男の声１",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "暑いな。クーラーなしで閉め切ったままか。",
                  "",
                  "99_mob/ota/ota0006.ogg",
                  "MessageWindow",
                  "好热啊。因为没开空调就把门关上了吗。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1069,
              "strings": {
                "Array": [
                  "",
                  "男の声２",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "こりゃダメでしょうな。",
                  "",
                  "99_mob/otb/otb0001.ogg",
                  "MessageWindow",
                  "这看来是不行了吧。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1070,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1071,
              "strings": {
                "Array": [
                  "",
                  "男の声１",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "鐘城さん、鐘城さーん、聞こえますかー？",
                  "",
                  "99_mob/ota/ota0007.ogg",
                  "MessageWindow",
                  "钟城先生，钟城先生，听得到我说话吗？",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1072,
              "strings": {
                "Array": [
                  "",
                  "男の声２",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "意識がありますか？　鐘城さーん。",
                  "",
                  "99_mob/otb/otb0002.ogg",
                  "MessageWindow",
                  "你还醒着吗？　钟城先生。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1073,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1074,
              "strings": {
                "Array": [
                  "",
                  "男の声１",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "意識なし。呼吸も……なし。",
                  "",
                  "99_mob/ota/ota0008.ogg",
                  "MessageWindow",
                  "没有意识……也没有呼吸。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1075,
              "strings": {
                "Array": [
                  "",
                  "男の声１",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "熱中症でしょう。\n一応病院には運びますが、もう脈もないので……。",
                  "",
                  "99_mob/ota/ota0009.ogg",
                  "MessageWindow",
                  "应该是因为中暑吧。\n姑且还是送到医院去，不过已经没有脉搏了……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1076,
              "strings": {
                "Array": [
                  "",
                  "大家さん",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……そうですか。",
                  "",
                  "99_mob/ooy/ooy0013.ogg",
                  "MessageWindow",
                  "……是吗。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1077,
              "strings": {
                "Array": [
                  "",
                  "男の声２",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "よくあるんですよこの季節には。",
                  "",
                  "99_mob/otb/otb0003.ogg",
                  "MessageWindow",
                  "现在这季节，还挺经常发生这种事的。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1078,
              "strings": {
                "Array": [
                  "",
                  "男の声１",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "昨日も閉め切った部屋で、\nこちらは扇風機は回していたんですがね。\n煙草の不始末で小火がでたみたいで。",
                  "",
                  "99_mob/ota/ota0010.ogg",
                  "MessageWindow",
                  "昨天也发生了，\n这样一个密闭的房间，还开着电风扇呢。\n似乎是因为没处理好烟头，起了一点小火。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1079,
              "strings": {
                "Array": [
                  "",
                  "男の声１",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "役者の女性が一酸化炭素中毒で……。\nありゃ可哀想だったな。",
                  "",
                  "99_mob/ota/ota0011.ogg",
                  "MessageWindow",
                  "好好的女演员，因为一氧化碳中毒……\n真可怜。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1080,
              "strings": {
                "Array": [
                  "",
                  "大家さん",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "99_mob/ooy/ooy0014.ogg",
                  "MessageWindow",
                  "……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1081,
              "strings": {
                "Array": [
                  "",
                  "男の声２",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "この人、ずいぶんとお酒を飲んでいたようだし、\n脱水症状で進行が早まったんでしょう。",
                  "",
                  "99_mob/otb/otb0004.ogg",
                  "MessageWindow",
                  "这个人似乎喝了不少酒，\n加剧脱水了吧。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1082,
              "strings": {
                "Array": [
                  "",
                  "大家さん",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ……。",
                  "",
                  "99_mob/ooy/ooy0015.ogg",
                  "MessageWindow",
                  "是啊……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1083,
              "strings": {
                "Array": [
                  "",
                  "大家さん",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "春頃からずっと……なんです。\nうちの娘が死んで、よほどショックだったみたいで、\nずっとお酒ばかり。",
                  "",
                  "99_mob/ooy/ooy0016.ogg",
                  "MessageWindow",
                  "从春季的时候起……就一直这样。\n似乎因为我家女儿去世而大受打击，\n从此就整天酗酒。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1084,
              "strings": {
                "Array": [
                  "",
                  "男の声１",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そりゃ……またなんとも。",
                  "",
                  "99_mob/ota/ota0012.ogg",
                  "MessageWindow",
                  "这真是……一言难尽。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1085,
              "strings": {
                "Array": [
                  "",
                  "男の声１",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ですがまあ、運がいいと思いましょう。",
                  "",
                  "99_mob/ota/ota0013.ogg",
                  "MessageWindow",
                  "不过，这已经算是运气好的了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1086,
              "strings": {
                "Array": [
                  "",
                  "男の声２",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "この時期、とくに熱中症だと、遺体の傷みが早いので。\nこんなに早く見つけてもらったなら。",
                  "",
                  "99_mob/otb/otb0005.ogg",
                  "MessageWindow",
                  "这个季节，特别是中暑的话，遗体腐烂得特别快。\n现在能这么早发现，是好事。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1087,
              "strings": {
                "Array": [
                  "",
                  "大家さん",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
