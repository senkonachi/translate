            },
            {
              "rowIndex": 2177,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2178,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ねりちゃんが今でも生きてたら……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　如果小音现在还活着的话……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2179,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　たぶん暑いから旅行に連れてけって言い出して、\n　このツアーにもついて来て、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　肯定会嚷嚷我带她去旅行消暑，\n　跟我踏上这场旅行，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2180,
              "strings": {
                "Array": [
                  "",
