              "rowIndex": 1234,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　分かってない模様。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　两人一头雾水。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
