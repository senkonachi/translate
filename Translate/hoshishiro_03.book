            },
            {
              "rowIndex": 189,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "心臓の中に……私が隠してある。探して。",
                  "",
                  "03_neri/ner0019.ogg",
                  "MessageWindow",
                  "我就藏在……心脏里面。去寻找。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 190,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "翼の下を……。",
                  "",
                  "03_neri/ner0020.ogg",
                  "MessageWindow",
                  "就在翅膀之下……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 191,
              "strings": {
                "Array": [
