              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1031,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "せっかく少ないんだし、みんなに紹介しましょうか。",
                  "",
                  "02_karuha/kar0030.ogg",
                  "MessageWindow",
                  "既然乘客不多，就给其他人介绍一下你吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1032,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1033,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん、\nああでも、タカセはもう挨拶済ませたし、\n１人寝てる子いたよね。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯，\n不过我已经和鹰世打过招呼了，\n还碰见了一个在睡觉的女孩子。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1034,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1035,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1036,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ジビエさんまだ寝てた？",
                  "",
                  "02_karuha/kar0031.ogg",
                  "MessageWindow",
                  "野鸟小姐还在睡啊？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1037,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1038,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "じび……は？",
                  "",
                  "",
                  "MessageWindow",
                  "野……什么？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1039,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ジビエさんでしょ。２つめの車両の人。",
                  "",
                  "02_karuha/kar0032.ogg",
                  "MessageWindow",
                  "不是在说野鸟小姐吗。第二节车厢里的那个人。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1040,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1041,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1042,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　確かに外国の人っぽかったけど……、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她确实像个外国人……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1043,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんちゅー名前だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可这名字也太个性了吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1044,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1045,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "閉じ目笑顔3",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もちろん本名じゃないわよ。\nただ本人がジビエって呼んでくれっていうから。",
                  "",
                  "02_karuha/kar0033.ogg",
                  "MessageWindow",
                  "当然这不是真名哦。\n不过她本人让我这么叫她。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1046,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "閉じ目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1047,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そ、そう。",
                  "",
                  "",
                  "MessageWindow",
                  "这、这样啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1048,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　世の中変わった人が多いな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这世界上怪人真不少。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1049,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "んで鷹世さんは知ってるのね。\nじゃああとは、花江さんか。",
                  "",
                  "02_karuha/kar0034.ogg",
                  "MessageWindow",
                  "鹰世先生你已经认识了对吧。\n那就剩花江小姐了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1050,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1051,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あのタバコ吸ってた人？",
                  "",
                  "",
                  "MessageWindow",
                  "是抽烟的那位吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1052,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1053,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "逸らし目照れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "また吸ってた？\nはあ、この列車、禁煙なのに。",
                  "",
                  "02_karuha/kar0035.ogg",
                  "MessageWindow",
                  "她还在抽烟？　\n唉，本车可是禁烟的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1054,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1055,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "え、禁煙なのか？",
                  "",
                  "",
                  "MessageWindow",
                  "哎，是禁烟的吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1056,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うん？\n列車って普通禁煙でしょ。",
                  "",
                  "02_karuha/kar0036.ogg",
                  "MessageWindow",
                  "嗯？\n火车一般不都禁烟吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1057,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1058,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あー……、どっちなんだろ。",
                  "",
                  "",
                  "MessageWindow",
                  "啊……不一定吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1059,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "x=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1060,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "普通そうじゃない。",
                  "",
                  "02_karuha/kar0037.ogg",
                  "MessageWindow",
                  "难道不是么。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1061,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1062,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "２１世紀はそうだけど、昔はスパスパだったそうだぞ。\nこの汽車はそっちにあわせてるかも。",
                  "",
                  "",
                  "MessageWindow",
                  "二十一世纪是这样的，但听说以前可都是烟雾缭绕的。\n我还以为这趟车是不是也模仿了那种感觉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1063,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　日本でも昭和のころは、電車ってのは床もソファも\n　タバコの焼け跡だらけだったんだとか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　哪怕是在日本，昭和年间的电车上，\n　地板和坐席好像也都布满了被烟头烧焦的痕迹。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1064,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "x=15 time=1.5",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1065,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "えー……。\n昔の人って危ないわね。火事とか考えないのかしら。",
                  "",
                  "02_karuha/kar0038.ogg",
                  "MessageWindow",
                  "哎……\n以前的人也太没安全意识了吧。都不注意火灾的危险性吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1066,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まあ……な。",
                  "",
                  "",
                  "MessageWindow",
                  "说得……也是。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1067,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こういう現代っ子の感想を言われると、\n　なんか自分がオッサンになったみたいでイヤだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　听到当今时代的女生对我说出这种感想，\n　好像自己是个大叔一样，心里有点抵触。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1068,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1069,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　火事は心配だが、この列車、座席にはきちんと\n　灰皿が用意されていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　火灾确实是个隐患，\n　好在这趟列车的座位上都安装了烟灰缸。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1070,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
