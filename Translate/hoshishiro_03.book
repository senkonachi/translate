                  "",
                  "",
                  "",
                  "",
                  "",
                  "はあ？",
                  "",
                  "05_hanae/han0011.ogg",
                  "MessageWindow",
                  "什么？",
                  ""
                ]
              },
              "isEmpty": 0,
