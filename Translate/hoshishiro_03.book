                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1763,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1764,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ま、旅は楽しいに越したことないからな。",
                  "",
                  "",
                  "MessageWindow",
                  "不过，旅游当然是越开心越好嘛。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1765,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール大",
                  "PunchPosition",
                  "y=-15 time=1.5",
