                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　三者三様に読み出す。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　三人读着各种各样的书。"
                ]
              },
              "isEmpty": 0,
