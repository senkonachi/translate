                  "",
                  "ふぅ。",
                  "",
                  "",
                  "MessageWindow",
                  "呼。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1954,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　聞かなくても分かるか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　答案已然揭晓。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1955,
              "strings": {
