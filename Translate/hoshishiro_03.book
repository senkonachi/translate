                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それを見て、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一边看着它……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 26,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常目少し困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "わたしの部屋です。",
                  "",
                  "01_noir/noi1208.ogg",
                  "MessageWindow",
                  "这就是我的房间。",
                  ""
                ]
