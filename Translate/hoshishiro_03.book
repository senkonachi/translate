            },
            {
              "rowIndex": 1894,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それに当てはめると、自分には悩みがあるって\n　証拠なわけで。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦之所以会把自己代入进去，\n　是因为她也是有心事的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
