                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1845,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　言ってることは分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我很能理解诺瓦说的话。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
