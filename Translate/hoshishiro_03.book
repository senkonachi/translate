              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1153,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>閉じ目笑顔3",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "学校のあと遊ぶのに集まるときは、\n男子みぃんなうちに来たいうちに来たいって言うの。",
                  "",
                  "02_karuha/kar1193.ogg",
                  "MessageWindow",
                  "放学后聚集起来一起玩的时候，\n男生总是说要到我家来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1154,
              "strings": {
