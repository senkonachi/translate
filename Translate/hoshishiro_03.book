              "rowIndex": 2313,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　助け船には素直に礼を言え。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　既然有人帮你就老实点道谢嘛。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
