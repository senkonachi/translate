              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "センキュ。……はあ。",
                  "",
                  "04_jibie/jib0417.ogg",
                  "MessageWindow",
                  "谢谢……唉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 769,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　寒さよりも精神的なもののほうが大きいだろうな。\n　怖いと寒さもくるから。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　想必比起身体上的寒冷，精神上的问题更加严重吧。\n　害怕的话也会感觉到寒冷。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 770,
              "strings": {
                "Array": [
                  "",
                  "ジビエ大",
                  "悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
