            },
            {
              "rowIndex": 1021,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　出発まではまだ何時間もあるはずだし、\n　そっちと合流したほうがいいか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　离出发还有几小时，\n　跟他们汇合比较好吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1022,
              "strings": {
                "Array": [
                  "",
