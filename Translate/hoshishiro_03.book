            },
            {
              "rowIndex": 7,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ねえねえお兄ちゃん。",
                  "",
                  "03_neri/ner0105.ogg",
                  "MessageWindow",
                  "我说啊，哥哥。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 8,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_自室_昼",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
