              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1943,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　アルビニズムは難病だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　白化病是疑难杂症。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1944,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　生活の制限が大きく、飲まなきゃならない薬も多い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　很大程度地影响了生活，还必须服用多种药物。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1945,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　だがそうした生活よりも、本人たちが一番辛いのは、\n『見た目』のことだと言う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可是更加让他们难以忍受的，\n　却是“外貌”。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1946,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人間って究極的には、外見で判断する生き物だからな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　人类，究其本性，是一种依靠外貌判断他人的生物。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1947,
              "strings": {
                "Array": [
                  "Wait",
