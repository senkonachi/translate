                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1860,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "逸らし目照れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1861,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いまもジビエさんが相手してるけど、\n　砂で山を作ったり、トンネルを通したり、楽しそうだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦现在正和野鸟小姐一起玩耍，\n　堆堆沙山，挖挖隧道，玩得不亦乐乎。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1862,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あたしはなんか上手くいかないのよねー。",
                  "",
                  "02_karuha/kar0408.ogg",
                  "MessageWindow",
                  "我就不能顺利和她相处呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1863,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "昨日は仲良くやれてたじゃんか。",
                  "",
                  "",
                  "MessageWindow",
                  "昨天你们不是相处得挺好的吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1864,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あれはアンタから逃げただけ。",
                  "",
                  "02_karuha/kar0409.ogg",
                  "MessageWindow",
                  "那只是她从你身边逃走了而已。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1865,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　森の中へ２人で入っていって。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　还一起走进森林了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1866,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ひどい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真过分。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1867,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
