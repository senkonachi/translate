              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1247,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　嬉しそうに頷くノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦开心地点着头。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1248,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここまでいい反応されると、こっちも気分がいい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这个反应，让我心情也舒畅了起来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1249,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　気合い入れて描いてやろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　提起劲画吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
