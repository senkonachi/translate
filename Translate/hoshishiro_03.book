                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ねりさん……ですか。",
                  "",
                  "01_noir/noi0517.ogg",
                  "MessageWindow",
                  "她叫做音理……吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
