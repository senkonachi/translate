                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　何事か考えてるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦在思索着什么。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
