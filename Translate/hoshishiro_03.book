                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1691,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ、すまん。",
                  "",
                  "",
                  "MessageWindow",
                  "喔，抱歉。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1692,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ジロジロ見過ぎた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看入神了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1693,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1694,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールの言うことを疑う理由はない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　没有必要怀疑诺瓦所说的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1695,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　思ってることが態度に出やすいからな。\n　嘘だったらすぐ分かると思う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　因为她心中所想的都已经刻在表情上面了。　　 \n  若是谎言一眼就能看出。"
                ]
