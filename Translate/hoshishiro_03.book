              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ほんとなんなのこれ。ドッキリ？",
                  "",
                  "02_karuha/kar1098.ogg",
                  "MessageWindow",
                  "这到底是怎么回事啊。整人节目？"
                ]
              },
