                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1266,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　照れくさそうに笑うノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦害羞地笑着。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1267,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　恥ずかしがりなこいつのことだから難題かもだが……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　因为她是个害羞鬼，想必实践起来很难吧……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1268,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "照れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1269,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつ、単純に顔が可愛いからな。\n　声さえかければ友達なんて簡単に作れるだろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过这家伙，长得相当可爱啊。\n　只要跟别人搭话应该简简单单就能交到朋友吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1270,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1271,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺は絵の準備……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我开始了画画的准备……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1272,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "んと、なんか描くものないかな。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯，好像没有用来画画的材料啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1273,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ペンとかは用意できたけど、画用紙がない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然准备了笔，但没有绘画用纸。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1274,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　最近の作業には紙なんて使わないからな。\n　えっと……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　毕竟最近的工作很少用到。\n　我想想……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
