            },
            {
              "rowIndex": 2137,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　落ち着かなそうにタバコに火をつける。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她有些局促地点上了烟。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2138,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　思ってはいたがチェーンスモーカーだな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　初次见面时我就觉得这人是个老烟枪。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2139,
              "strings": {
