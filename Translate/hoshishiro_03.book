            },
            {
              "rowIndex": 1484,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ベッドに横たわりなおす。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我重新躺回床上。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1485,
              "strings": {
                "Array": [
                  "Tween",
                  "真白",
                  "PunchPosition",
                  "x=15 time=0.6",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
