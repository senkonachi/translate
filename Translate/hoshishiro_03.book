              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちがうか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　原来不是么。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 700,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あの猫が化けて出て……とかなら\n　ドラマティックだったけどな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　如果当时的那只猫……化身成人的话，\n　那可就太巧了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 701,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　てか、その前に、そうだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　话说回来，在此之前有个疑问。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 702,
              "strings": {
                "Array": [
