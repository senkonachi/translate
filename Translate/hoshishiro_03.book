              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　<dash=2>ガチャ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　<dash=2>咔嚓。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1178,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　冷蔵庫を開けた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我打开了冰箱。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1179,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　酒が飲みたい。ビールかチューハイか……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　想喝酒。啤酒或者碳酸酒什么的……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1180,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……あれ？　冷やしてない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……咦，没冷藏起来么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1181,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　おかしいな。最近は欠かさないように\n　買い足してたのに。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　好奇怪呀。最近为了不会喝光\n　我明明去买了充足的量的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1182,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あ、そうかこの部屋はいま３月。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　啊，对了，这是三月份的我的房间。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1183,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　当時は自室に、酒は置いてなかったっけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　当时我的房间里还没放酒。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1184,
              "strings": {
