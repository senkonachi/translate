              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "ギャグほっこり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お肉オイシーデスよネ～\nワタシ大学でこっちへ来て、初めて食べて、\n以来モーやみつきデス。",
                  "",
                  "04_jibie/jib0079.ogg",
                  "MessageWindow",
                  "肉可是极品美味~\n我上大学时第一次吃到肉，\n就沉沦其中了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
