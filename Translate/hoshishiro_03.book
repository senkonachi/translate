              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "その人が何よりも可哀想なのは……。",
                  "",
                  "03_neri/ner0333.ogg",
                  "MessageWindow",
                  "那个人最可怜的地方是……"
