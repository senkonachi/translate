                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 797,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "～",
                  "",
                  "05_hanae/han0262.ogg",
                  "MessageWindow",
                  "～"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 798,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　本人は言われるの好きじゃなさそうだけどさ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然看来她本人不怎么喜欢被别人这样说。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 799,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　照れてるのが可愛いので、\n　ここは褒め殺されるのをまったり見守ろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过这样害羞的花江小姐也挺可爱的，\n　就这样看着她被捧杀也不错。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 800,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "目逸らし_困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 801,
              "strings": {
                "Array": [
                  "Tween",
                  "花江",
                  "PunchPosition",
                  "x=15 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
