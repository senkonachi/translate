            {
              "rowIndex": 2054,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　気に入られてたよな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她很中意我啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2055,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　特別扱い……だったよな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对我很……特别吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2056,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょっと自信はない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　其实我也不确定。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2057,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　世話好きっていうかなんていうか。\n　よくご飯に呼んでくれたり、\n　部屋の掃除に押しかけてきたり。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　该说她是热心肠还是什么好呢。\n　她经常叫我去吃饭，\n　也会帮我打扫房间。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2058,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも俺が特別ってほどではなかったかも。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然而我或许也没那么特别。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2059,
              "strings": {
                "Array": [
