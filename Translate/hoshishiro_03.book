            {
              "rowIndex": 2609,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>通常目「えっと…」",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ、でもおじい様にお会いしたとき、\n出されたおやつに\nこんなのがあった気がします。",
                  "",
                  "01_noir/noi0229.ogg",
                  "MessageWindow",
                  "啊，但是我去见爷爷的时候，\n端上桌的零食里好像有类似的东西。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2610,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お、おう、そうか。",
                  "",
                  "",
                  "MessageWindow",
                  "哦，喔，这样啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2611,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　おじいさんはいるのか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　原来有爷爷的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2612,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "通常",
                  "",
                  "",
                  "",
