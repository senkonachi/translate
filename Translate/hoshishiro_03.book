                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 261,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "んえっ？！",
                  "",
                  "02_karuha/kar1163.ogg",
                  "MessageWindow",
                  "哎？！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 262,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　だがそこに見えた人の形は、触れようとすると\n　霧のように透き通ってしまう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然而，眼前的人却摸不到，\n　伸出的手仿佛碰到薄雾一般穿了过去。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 263,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 264,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ大",
                  "PunchPosition",
                  "y=30 time=1",
