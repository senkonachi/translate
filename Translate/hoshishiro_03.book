                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　たぶんルール違反なんだろうけど\n　車掌がイイ感じに話が分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚才怕是违反规定了。\n　倒是乘务员还挺好说话的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1000,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それで何か用だった？",
                  "",
                  "02_karuha/kar0024.ogg",
                  "MessageWindow",
                  "还有什么问题吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1001,
              "strings": {
