            },
            {
              "rowIndex": 1359,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "真白はわたしです。",
                  "",
                  "01_noir/noi0948.ogg",
                  "MessageWindow",
                  "真白就是我。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1360,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1361,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　はい？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　什么？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1362,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "様子を窺う",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "夜羽真白、それがわたしの本名です。",
                  "",
                  "01_noir/noi0949.ogg",
                  "MessageWindow",
                  "夜羽真白，这是我的本名。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1363,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1364,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワール……ってのは。",
                  "",
                  "",
                  "MessageWindow",
                  "诺瓦……是。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1365,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "閉じ目悩み",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "よく分かりません。\nこの汽車に乗ったときからみなさんにそう呼ばれて、\nじゃあわたしはそうなのかなって。",
                  "",
                  "01_noir/noi0950.ogg",
                  "MessageWindow",
                  "不是很清楚。\n只是一坐上这列火车大家就都这么叫我，\n所以我就以为诺瓦是自己的名字了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1366,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "諦観",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
