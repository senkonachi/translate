              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1291,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1292,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　またさっきの声が聞こえ出さないうちに\n　逃げた方がよさそうだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　趁刚才不明的人声没有再次出现，\n　赶紧逃离这里比较好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
