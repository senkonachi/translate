                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 698,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょっと緊張してたが、\n　こういう感じでいけるお客もいるなら、こっちも助かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽说一开始有点紧张，\n　多亏他善于交流，紧张感也随之消除了。\n",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 699,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "感激",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
