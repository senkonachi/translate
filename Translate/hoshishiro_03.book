              "rowIndex": 1794,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあ……『手に持った筒から火が飛び出る』。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过……要说从字面意思来看。",
                  ""
                ]
