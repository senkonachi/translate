              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "タカセ、うるさい。",
                  "",
                  "",
                  "MessageWindow",
                  "鹰世，你好啰嗦。",
