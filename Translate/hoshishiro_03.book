            {
              "rowIndex": 168,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うー、なにこれ、なんでアンタと寝てんのよ。",
                  "",
                  "02_karuha/kar0343.ogg",
                  "MessageWindow",
                  "呜，什么嘛，为什么和你睡在一起。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 169,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
