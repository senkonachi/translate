            {
              "rowIndex": 117,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "世界一ステキな……。",
                  "",
                  "07_mashiro/mas0279.ogg",
                  "MessageWindow",
                  "这世界上最最帅气的……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 118,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "大好きな人が乗ってるんです。",
                  "",
                  "07_mashiro/mas0280.ogg",
                  "MessageWindow",
                  "我最喜欢的人也坐在上面。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 119,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント1_c",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 120,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 121,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さわやかな風が吹いている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　清风吹拂。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 122,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　吹いているというか……。\n　清爽な風のド真ん中に、弾丸の速度で飛び込んでいる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　与其说是风在吹。\n　不如说我正以子弹般的速度在清风里穿梭。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 123,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　夜汽車の旅。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　深夜火车之旅。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 124,
              "strings": {
                "Array": [
                  "BgEventOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 125,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_列車内",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 126,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　旅は続いている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　旅行仍在继续。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 127,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　綺麗な星空と涼しい風のなか、のんびり気楽な旅は。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　美丽星空之下，凉风之中，悠闲而又安逸。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 128,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　乗客はちょっと変わったけどな。\n　ノワールはああして、日々リハビリをがんばっており、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就是里面的乘客有些奇怪。\n　诺瓦每天都像那样努力复健，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 129,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント1_c_大",
                  "",
                  "",
                  "-200",
                  "250",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 130,
              "strings": {
                "Array": [
                  "",
                  "黒猫",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ふにぃ。",
                  "",
                  "99_mob/kur/kur0023.ogg",
                  "MessageWindow",
                  "呜咪。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 131,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　別のノワールが乗客に。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　另一个诺瓦也是乘客。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 132,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあこいつは時々ふっと現れて、\n　またふっといなくなってしまう。きままなやつだ。\n　乗客とは言えないかも。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过它总是突然出现，\n　又突然消失。真是随心所欲的家伙。\n　也许不能称为乘客吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 133,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント1_e",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 134,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こっちは紛れもなく乗客。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而毫无疑问，我们可是乘客。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 135,
