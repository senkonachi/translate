              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　笑いながら肩をすくめる男。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他笑着耸了耸肩。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
