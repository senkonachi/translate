            {
              "rowIndex": 60,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　旅の前の日<dash=2>。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　旅行前一天<dash=2>。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 61,
              "strings": {
                "Array": [
                  "Se",
