                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつの頭の良さには助けられてる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　脑子这么聪明真是帮大忙了。"
                ]
              },
              "isEmpty": 0,
