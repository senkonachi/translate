              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2301,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ッ！",
                  "",
                  "",
                  "MessageWindow",
                  "！",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2302,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ビビった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　吓了一跳。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2303,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　振り向いた瞬間、誰もいなかったはずの真後ろに\n　彼女は立っていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　回过头的瞬间，她就已经站在那里了\n　站在我的身后。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2304,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "不満そう",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2305,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　誰だ？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　谁？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2306,
              "strings": {
                "Array": [
                  "",
                  "暁",
