                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2124,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あう。",
                  "",
                  "01_noir/noi1084.ogg",
                  "MessageWindow",
                  "啊呜。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2125,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　せっかく近くに来たので、改めて肩を撫でてやった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　难得诺瓦坐在了旁边，我又继续抚摸起她的肩膀。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2126,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2127,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi1085.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2128,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょっとびっくりしてるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦稍显惊讶。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2129,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも緊張した様子はなく、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但并没有紧张，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2130,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_d_大",
                  "",
                  "",
                  "400",
                  "-100",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2131,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　むしろ体重を俺に預けてくる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而是将身体靠了过来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2132,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ひとつ、約束をしないか。",
                  "",
                  "",
                  "MessageWindow",
                  "能跟我作个约定么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2133,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_c_大",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2134,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "約束……？",
                  "",
                  "01_noir/noi1086.ogg",
                  "MessageWindow",
                  "约定……？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2135,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ。\nこの旅で、この耳以外にもお前に変化を残そう。",
                  "",
                  "",
                  "MessageWindow",
                  "没错。\n我希望你能在这趟旅途中，除了那双耳朵以外，还能留下别的变化。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2136,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "今度は自分から、友達が作れるように。",
                  "",
                  "",
                  "MessageWindow",
                  "然后，以后就自己主动去交朋友。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2137,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント10_b_大",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2138,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……。",
                  "",
                  "01_noir/noi1087.ogg",
                  "MessageWindow",
                  "嗯……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2139,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "旅が終わったあと、誰でもいい。\nそうだな。まずは歳の近い誰かいいやつと出会ったら。",
                  "",
                  "",
                  "MessageWindow",
                  "这趟旅行结束后，找谁都可以。\n对了，如果你遇到了和你年纪相仿、性格不错的人的话。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2140,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お前から率先して、そいつと仲良くなるんだ。",
                  "",
                  "",
                  "MessageWindow",
                  "你就主动去和他交朋友吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2141,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "01_noir/noi1088.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2142,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "カルハみたいにぐいぐい行ってみろ。",
                  "",
                  "",
                  "MessageWindow",
                  "就学着狩叶那样毫无畏惧地上吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2143,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でも……。",
                  "",
                  "01_noir/noi1089.ogg",
                  "MessageWindow",
                  "但是……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2144,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "恥ずかしい？",
                  "",
                  "",
                  "MessageWindow",
                  "害羞吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2145,
              "strings": {
                "Array": [
