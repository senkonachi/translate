            },
            {
              "rowIndex": 428,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……友達。",
                  "",
                  "01_noir/noi1307.ogg",
                  "MessageWindow",
                  "……朋友。"
                ]
