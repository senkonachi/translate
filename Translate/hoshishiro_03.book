              "rowIndex": 1563,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……ん、うん。",
                  "",
                  "02_karuha/kar1216.ogg",
                  "MessageWindow",
                  "……嗯、嗯。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1564,
              "strings": {
                "Array": [
