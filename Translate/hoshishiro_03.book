              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2182,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "y=30 time=1",
                  "easeInQuad",
