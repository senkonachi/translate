            },
            {
              "rowIndex": 2282,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_プラネタリウム",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
