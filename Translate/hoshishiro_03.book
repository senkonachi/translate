                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　作業台を見てるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦看着工作台。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
