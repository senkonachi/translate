            },
            {
              "rowIndex": 5,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あなたと一緒に、旅を。",
                  "",
