                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なにかをこぼした痕だとして、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　如果真是泼了什么东西，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 30,
              "strings": {
