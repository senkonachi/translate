            {
              "rowIndex": 705,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "かもね。",
                  "",
                  "03_neri/ner0286.ogg",
                  "MessageWindow",
                  "大概吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 706,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　夢……か。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　梦……么。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 707,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　何度か汽車の中で眠り、見ていたものだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就是数次在火车里睡着，然后做的那个梦。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 708,
