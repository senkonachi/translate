                  "真白",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "07_mashiro/mas0213.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1085,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "海……函館、スウェーデン。",
                  "",
                  "07_mashiro/mas0214.ogg",
                  "MessageWindow",
                  "大海……函馆、瑞典。"
