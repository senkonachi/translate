            {
              "rowIndex": 1820,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　<dash=2>ガコン。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　<dash=2>哐当。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1821,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　だがもう汽車は動き始めている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是蒸汽机车已经开始运行。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1822,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　このまま行くしかない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只能继续前进了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1823,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1824,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　終点を目指して、真っ暗な闇の中へ……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　向着终点，闯入无边的黑暗之中……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1825,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こうして俺たちの、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就这样，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
