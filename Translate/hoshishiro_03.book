                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　今すべきはそうじゃない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但现在该做的并不是否定。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1784,
              "strings": {
