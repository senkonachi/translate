                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだよ急に。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　冷不丁干什么啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
