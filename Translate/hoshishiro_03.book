            },
            {
              "rowIndex": 1439,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　目を閉じれば……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　闭上眼睛……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1440,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ああ、そう、聞こえる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　啊，没错，听到了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1441,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　聞いたことを思い出せる。\n　聞いた記憶をたどれる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这样就能回忆起听到过的事。\n　就能回溯那些听过的记忆。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1442,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　夜羽真白が知っていることを思い出せる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　就能回想起夜羽真白所知的事。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1443,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_病院内",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1444,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "絶対に無理です。\n真白さんの身体にこれ以上の……なんて。",
                  "",
                  "99_mob/nan/nan0016.ogg",
                  "MessageWindow",
                  "绝对不行。\n真白小姐的身体已经没法再……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1445,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "これ以外に方法はない。",
                  "",
                  "99_mob/inc/inc0039.ogg",
                  "MessageWindow",
                  "但已经没有其他办法了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1446,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "心臓は強く生きていてくれておる。\nだが、真白本人にはそれが出来ん。",
                  "",
                  "99_mob/inc/inc0040.ogg",
                  "MessageWindow",
                  "心脏还在坚强地活着。\n但是真白本人却不一样。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1447,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "心臓以外の臓器が生きておらん。",
                  "",
                  "99_mob/inc/inc0041.ogg",
                  "MessageWindow",
                  "心脏以外的器官已经衰竭了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1448,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "取り替えるほかあるまい。\n偶然にも、４人もの提供者が現れたばかりだ。",
                  "",
                  "99_mob/inc/inc0042.ogg",
                  "MessageWindow",
                  "只能全部换掉。\n出于偶然，现在刚好出现了四个器官捐献者。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1449,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "むちゃくちゃです！\nいまでさえこんなに拒絶反応に苦しんでいるのに！",
                  "",
                  "99_mob/nan/nan0017.ogg",
                  "MessageWindow",
                  "太乱来了！\n她现在已经在遭受排异反应的折磨了！",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1450,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いまのままなら真白は１００％死ぬ。",
                  "",
                  "99_mob/inc/inc0043.ogg",
                  "MessageWindow",
                  "要是保持原状，真白百分百会死。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1451,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もしそれを９９％に下げられるなら……、\nわしは迷わん。",
                  "",
                  "99_mob/inc/inc0044.ogg",
                  "MessageWindow",
                  "哪怕概率只有1％……，\n我也不会犹豫。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1452,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "院長……。",
                  "",
                  "99_mob/nan/nan0018.ogg",
                  "MessageWindow",
                  "院长……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1453,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "前のことがもう警察にしっぽを掴まれておる。\nわしがこの病院にいられるのもあとわずかだ。",
                  "",
                  "99_mob/inc/inc0045.ogg",
                  "MessageWindow",
                  "上次那件事，警察已经查到了线索。\n我能待在这所医院的时间已经不多了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
