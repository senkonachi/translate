              "rowIndex": 833,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人がいない……そうか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　没有人在……对啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
