            },
            {
              "rowIndex": 2019,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワール。",
                  "",
                  "",
                  "MessageWindow",
                  "诺瓦。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2020,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "閉じ目悩み",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "07_mashiro/mas0084.ogg",
                  "MessageWindow",
                  "……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2021,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　イエスともノーとも言わない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她没有说是，也没有说不是。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2022,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールだ。俺たちの知る少女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这就是诺瓦。我们认识的那个少女。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2023,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あの、生きることを憎悪する少女は消えている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那个憎恨活着的少女消失了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2024,
