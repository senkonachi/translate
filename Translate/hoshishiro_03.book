              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょっと困ったことも分かった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这件事也让人感到头大。"
                ]
              },
              "isEmpty": 0,
