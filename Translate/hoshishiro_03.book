            },
            {
              "rowIndex": 682,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おいしいです。",
                  "",
                  "01_noir/noi0410.ogg",
                  "MessageWindow",
                  "很好吃。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 683,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　新鮮さ半分、まだ戸惑ってるの半分って感じに言う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她的语气中疑惑和新鲜参半。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 684,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあ慣れないものを食べるんだから\n　こんな感じだわな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　毕竟吃了不经常吃的食物，\n　可以理解。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 685,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それでいい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　情况看起来还不错。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 686,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　自分の食うものくらい自分で決めたほうがいい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　自己的食谱还是要由自己决定。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 687,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "肉にも色んな種類があるからな。\n色々食べて行けよ。",
                  "",
                  "",
                  "MessageWindow",
                  "肉也分很多种类。\n都尝尝看吧。",
