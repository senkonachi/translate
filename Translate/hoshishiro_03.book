            {
              "rowIndex": 1027,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あたしは言われた案内役の仕事だけやって、\n言われた報酬をもらえればそれで満足。",
                  "",
                  "02_karuha/kar0029.ogg",
                  "MessageWindow",
                  "我只要把导游的工作做好，\n拿到说好的薪水就行了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1028,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　正直でよろしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她还真实诚啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1029,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目笑顔",
