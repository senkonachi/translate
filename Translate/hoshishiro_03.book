                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ふー……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　呼……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 377,
              "strings": {
