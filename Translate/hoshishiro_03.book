            },
            {
              "rowIndex": 1187,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>ウインク",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なーいしょっ♪",
                  "",
                  "02_karuha/kar1021.ogg",
                  "MessageWindow",
                  "保密哦～♪"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1188,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　鼻の頭で人差し指を立てて、ウインクする。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她把食指放在鼻子前，眨了眨眼。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1189,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　可愛いけどイラッとするのは何故だろう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　明明挺可爱的却莫名让人这么火大。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1190,
              "strings": {
                "Array": [
                  "CharacterOff",
