              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 922,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "不満そう",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
