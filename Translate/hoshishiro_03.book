              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1846,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "困り目逸らし",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
