              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 858,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "<Character=ねり大>閉じ目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うんっ。",
                  "",
                  "03_neri/ner0316.ogg",
                  "MessageWindow",
                  "嗯。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 859,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ようやくニッコリ笑ってくれる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她终于重新绽放出了笑容。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 860,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ったく、俺は弱い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真是的，我也太容易被搞定了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 861,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　この笑顔のためなら、\n　どんなことだってしたくなるんだから。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　为了这个笑容，\n　不管什么事我都肯去做。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 862,
