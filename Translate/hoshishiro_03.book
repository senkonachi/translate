                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 850,
              "strings": {
                "Array": [
                  "",
                  "ジビエ大",
                  "ドヤ真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だから地元にはいられて２週間デスネ。\nそれ以上離れてるともう、お肉食べたくて食べたくて。",
                  "",
                  "04_jibie/jib0077.ogg",
                  "MessageWindow",
                  "因此我在家最多只能待两周，\n不然就会想肉想到不行。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 851,
              "strings": {
                "Array": [
