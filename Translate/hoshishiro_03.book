            },
            {
              "rowIndex": 2288,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっき描いてやった絵だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚才帮她画的画。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2289,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんか……高い場所に、立てかけてある。",
