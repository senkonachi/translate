              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1781,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺の後ろに隠れるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦躲到了我的身后。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1782,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "悲しみ伏目",
