              "strings": {
                "Array": [
                  "",
                  "花江",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "や、平気。",
                  "",
                  "05_hanae/han0053.ogg",
                  "MessageWindow",
                  "没、没什么事。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1184,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　手をさすって見せる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她搓了搓手。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1185,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　指や足、服を焼いた形跡はない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看似手指、腿上、衣服上都没有烧痕。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1186,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "目逸らし",
                  "",
