                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ねりちゃんの夢。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　小音的梦。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 334,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　久しぶりに見たな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　久违地做了有关她的梦。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 335,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いや、最近は夢自体見なかったか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不，最近其实连梦都没怎么做过。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 336,
              "strings": {
