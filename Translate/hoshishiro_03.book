            },
            {
              "rowIndex": 400,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ケンカでもした？",
                  "",
                  "02_karuha/kar0106.ogg",
                  "MessageWindow",
                  "吵架了吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
