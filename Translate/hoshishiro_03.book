            },
            {
              "rowIndex": 1831,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだかんだ年齢が近いってのは大きい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但果然年龄相仿这点在她心目中占据的分量最大。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1832,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>様子を窺う",
