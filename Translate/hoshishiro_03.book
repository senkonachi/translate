                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　おーおー照れてる照れてる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　哦～哦～害羞了害羞了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 816,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　思ったが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　正当我这么想的时候。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 817,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　彼女の反応は、予想とは少しちがった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但她的反应，与我所想的不太一样。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
