            {
              "rowIndex": 1277,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "出所を探るために、まずご自分でエンジンの形状を\n描いてみよう、と。",
                  "",
                  "06_takase/tak0161.ogg",
                  "MessageWindow",
                  "看起来你是为了抓住头绪，\n自己先实际画一画发动机吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1278,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そんなところだ。",
                  "",
                  "",
                  "MessageWindow",
                  "就是这样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
