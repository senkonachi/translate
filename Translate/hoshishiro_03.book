              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 792,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつは……つまり『そういうタイプ』なんだろうな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他想必就是“那一类人”。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 793,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ＳＬマニアとか、鉄ちゃんとか、そういうの。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　俗称SL迷，又称作阿铁。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
