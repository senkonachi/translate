                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　嘘だろ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不会吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1520,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　薬使って、これなのかよ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　用了药还这样吗。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1521,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　病院できちんと処置してもらって\n　この生き地獄なのか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　明明在医院接受了正规的治疗。\n　却还是这么生不如死吗。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1522,
              "strings": {
