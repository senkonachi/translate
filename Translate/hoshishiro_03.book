            },
            {
              "rowIndex": 2296,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うお。",
                  "",
                  "",
                  "MessageWindow",
                  "呜啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2297,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　強烈な寒気が肌を走る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　感到一股强烈的恶寒。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2298,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いまなら分かる。これは夜羽真白が感じてる苦しみ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　现在明白了。这就是夜羽真白所感到的痛苦。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2299,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　拒絶反応だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　所谓排异反应。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2300,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "涙伏せ目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2301,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　彼女が俺に何かしてるわけじゃない。\n『俺が彼女に触れる』ということが、拒絶反応の原因なんだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　并不是她对我做了什么。\n　“我碰到了她”便是发生排异反应的原因。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2302,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "涙",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2303,
              "strings": {
                "Array": [
                  "Tween",
                  "真白",
                  "PunchPosition",
                  "x=15 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2304,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "し、シロさん、手を放して。",
                  "",
                  "07_mashiro/mas0118.ogg",
                  "MessageWindow",
                  "白，白先生，请放手。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2305,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2306,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でもラッキーなことに、この反応は俺だけに起きる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但幸运的是，这个反应只在我身上发生。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2307,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールを苦しめるわけじゃないらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　似乎诺瓦自己并不会感到痛苦。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2308,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ならいい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那就好。"
                ]
              },
