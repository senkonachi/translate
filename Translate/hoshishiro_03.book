              "rowIndex": 1825,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　欄干を掴んで、下をのぞき込む彼女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她抓住栏杆朝水面望去。",
