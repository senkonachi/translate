            {
              "rowIndex": 1263,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はあ、はあ、良かった、見付かりました。",
                  "",
                  "06_takase/tak0048.ogg",
                  "MessageWindow",
                  "哈，哈，太好了，终于找到你了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1264,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ。",
                  "",
                  "",
                  "MessageWindow",
                  "噢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1265,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "少し怒り",
