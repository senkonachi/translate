              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　出会えた人に順序をつけるのは躊躇ったみたいだけど、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然看起来给相遇的人排名次有点踌躇，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1830,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール大",
