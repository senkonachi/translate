              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2965,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　マジメな話をしたがってると悟り、語調を落とすタカセ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　见我谈到了认真的话题，鹰世也把语调压了下来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2966,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2967,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それで、だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那么该说正事了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2968,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "さっき、森の中でさ。",
                  "",
                  "",
                  "MessageWindow",
                  "刚才在森林里。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2969,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ぶっちゃけ言うと、お前、なにか見た、もしくは聞いた？",
                  "",
                  "",
                  "MessageWindow",
                  "我就直接问了。你有没有看到，或者听到什么？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2970,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なにかとは？",
                  "",
                  "06_takase/tak0067.ogg",
                  "MessageWindow",
                  "具体是指？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2971,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "俺と、森と、服以外のもの。",
                  "",
                  "",
                  "MessageWindow",
                  "除了我、森林、衣服以外的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2972,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "06_takase/tak0068.ogg",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
