                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　この点も、確かに。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这点也确实如此。",
                  ""
                ]
              },
              "isEmpty": 0,
