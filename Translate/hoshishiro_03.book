              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1394,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目困惑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "とくに目がね。\n見るだけで威圧的と思われるのはダメなんです。",
                  "",
                  "06_takase/tak0540.ogg",
                  "MessageWindow",
                  "特别是眼睛。\n不能让人一眼看上去就有威圧感。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
