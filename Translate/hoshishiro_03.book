                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1240,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これは……コミュニケーション無理なやつだな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看来……想要交流没那么容易啊。",
                  ""
