              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　カルハが向かってるのは、\n　さっきノワールの反応してた天の川総合病院。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶跑向的地方，\n　是诺瓦刚才所说的天河综合医院。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2545,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……天の川？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……天河？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2546,
              "strings": {
                "Array": [
                  "",
                  "暁",
