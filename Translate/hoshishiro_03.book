            },
            {
              "rowIndex": 1639,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょうどその方向へ砂浜に足跡が伸びていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚好有一排的脚印朝那边延伸。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1640,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　森よりもＳＬ。海よりも灯台か。\n　好みの偏ってるやつだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　比森林更喜欢SL，比大海更喜欢灯塔么。\n　这位的爱好可真别致。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
