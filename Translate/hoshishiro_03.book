            },
            {
              "rowIndex": 326,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ばっと手を広げてみせる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他伸展双臂。",
                  ""
                ]
              },
              "isEmpty": 0,
