                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　遠くの灯台を指さす。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她指向远方的灯塔。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1638,
              "strings": {
