                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ぐらっ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　当啷。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 446,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "っと、動いた。",
                  "",
                  "",
                  "MessageWindow",
                  "噢，动了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 447,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さすが蒸気機関車。\n　止まるのも一苦労だけど、動くのも時間がかかる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真不愧是蒸汽机车。\n　不但停车时颇费工夫，启动也要花很久。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 448,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　現代社会では忌避されるだろうこのタルさ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　如果放到外面，这么低下的效率一定会饱受诟病吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 449,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノスタルジックでイイ感じだった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　还挺怀念这种感觉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
