                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2141,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "さっきの話の続きですけど、機関車が時速１４５キロを\n出す方法がですね。",
                  "",
                  "01_noir/noi0092.ogg",
                  "MessageWindow",
                  "回到刚才话题，\n要怎么才能让机车开到145公里的时速。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2142,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そんな話はしてなかったけど、なに？",
                  "",
                  "",
                  "MessageWindow",
                  "刚才好像也没聊这个，你接着说吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2143,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "例えばエンジンを地獄の窯のように熱くすれば、\n機関車にはトーマスもびっくりするほどの。",
                  "",
                  "01_noir/noi0093.ogg",
                  "MessageWindow",
                  "比如说，要是把引擎烧到地狱锅炉那么热，\n机车就能开出让托马斯都大吃一惊的<dash=2>。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2144,
              "strings": {
                "Array": [
                  "Tween",
                  "Graphics",
                  "PunchPosition",
                  "x=15 time=0.6",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2145,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ぷちゅん。",
                  "",
                  "01_noir/noi0094.ogg",
                  "MessageWindow",
                  "噗嗤。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2146,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　は？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　啥？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2147,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "失礼しました。",
                  "",
                  "01_noir/noi0095.ogg",
                  "MessageWindow",
                  "不好意思。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2148,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そもそもえすえるのスピードというのは、\nエンジンの熱さと因果関係が。",
                  "",
                  "01_noir/noi0096.ogg",
                  "MessageWindow",
                  "说到底，SL的速度和发动机的热量有没有关<dash=2>。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
