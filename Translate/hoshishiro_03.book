                  "<Character=ジビエ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ワタシみたいな思い、させたくナイデス。",
                  "",
                  "04_jibie/jib0231.ogg",
                  "MessageWindow",
                  "不想让她有和我一样的体验。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3165,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "？",
                  "",
                  "",
                  "",
                  "？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3166,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ふと、ジビエさんが寂しそうに言う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐突然寂寞地说道。",
                  ""
                ]
