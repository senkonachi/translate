                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1500,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　病室の扉が開いて、看護師が１人入ってきた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　病房的门被打开，一位护士走了进来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1501,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　機械のビービー音は止めてくれる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她关掉了机器的哔哔声。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
