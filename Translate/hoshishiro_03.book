                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1731,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人間ってのは基本、\n『いる』より『いない』ほうが怖い。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　通常来说，\n　人类会对未知保持更多的恐惧感。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1732,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1733,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ホラー映画なんかでも、\n　ゾンビなんかをばんばん出す海外のホラーより\n　気配だけを描く日本ホラーの方が怖いあれだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　以电影为例。\n　比起国外那种满屏僵尸的飚浆片，\n　日本特有的烘托气氛的恐怖片更吓人。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1734,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "困り目逸らし",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1735,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "無気力",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
