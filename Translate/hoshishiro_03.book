            },
            {
              "rowIndex": 2724,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ、はい。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯，够了。",
