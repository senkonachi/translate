            },
            {
              "rowIndex": 265,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あーでも猫いいなあ。いいなあ猫。",
                  "",
                  "03_neri/ner0091.ogg",
                  "MessageWindow",
                  "啊<dash=2>但是猫真好啊。猫真好啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 266,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "猫、好きなんだ。",
                  "",
                  "",
                  "MessageWindow",
                  "你喜欢猫啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 267,
