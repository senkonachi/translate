              "isCommentOut": 0
            },
            {
              "rowIndex": 739,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　もう駅が見えないくらいの距離を歩いてるんだが、\n　他の建物がなにもなかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我们离开车站后走了很长一段距离，\n　却没见到其它建筑。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
