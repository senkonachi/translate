            },
            {
              "rowIndex": 3168,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだ？\n　思ったが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她怎么了？\n　正当我纳闷的时候，",
                  ""
