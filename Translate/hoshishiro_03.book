              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi0236.ogg",
                  "MessageWindow",
                  "好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2651,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　朗らかに首を縦に振るノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦兴致勃勃地点了点头。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2652,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんだかんだで、さっきのあの森の\n　不気味な体験は頭から離れたようだった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　像这样有一句没一句地聊了一会，\n　想必她在森林里的不好记忆也能淡化一些了吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2653,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
