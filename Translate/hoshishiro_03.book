                  "イベント10_c_大",
                  "",
                  "",
                  "400",
                  "-100",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2184,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どう……ですか？",
                  "",
                  "01_noir/noi1100.ogg",
                  "MessageWindow",
                  "可以……吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2185,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "まあ、あれくらいなら。",
                  "",
                  "",
                  "MessageWindow",
                  "也行，小事一桩。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2186,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　てかあんなもんご褒美と言わずとも、\n　言ってくれれば今すぐにでも描いてやるのに。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不如说这种根本算不上奖励，\n　只要诺瓦想要，我现在都可以帮她画。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2187,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ま、いいか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过，就这样吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2188,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "わかった。じゃあ交換条件だノワール。",
                  "",
                  "",
                  "MessageWindow",
                  "明白了。诺瓦，那交换条件是。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2189,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お前が次に、誰か、新しい友達を作れたら。",
                  "",
                  "",
                  "MessageWindow",
                  "要是你下次交到别的朋友。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2190,
              "strings": {
                "Array": [
