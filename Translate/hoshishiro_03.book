            },
            {
              "rowIndex": 2658,
              "strings": {
                "Array": [
                  "",
                  "駅員",
                  "<Character=院長>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "バーベキュー、お肉ですか。",
                  "",
                  "99_mob/inc/inc0007",
                  "MessageWindow",
                  "烤肉，肉吗。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2659,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "逸らし目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "02_karuha/kar0507.ogg",
                  "MessageWindow",
                  "嗯。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2660,
              "strings": {
                "Array": [
                  "",
