            },
            {
              "rowIndex": 1953,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "カルハさん、わたしの髪が普通じゃなかったら\n仲良くしてくれたでしょうか。",
                  "",
                  "01_noir/noi1059.ogg",
                  "MessageWindow",
                  "要是我的头发不同寻常，\n狩叶小姐还会和我当朋友吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1954,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ん……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　嗯……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1955,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　話の流れで向いた話で、声のトーンを落とすノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦因为话题的走向而变得失落了起来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1956,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　やれやれ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真是的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1957,
              "strings": {
                "Array": [
                  "",
