              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1919,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　気持ちは分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我能明白她的心情。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1920,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも海が初めてのノワールは、まず水がしょっぱいっていう\n　海の存在そのものにも慣れてないわけで。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过对于第一次看到大海的诺瓦来说，\n　毕竟连海水的咸味都还没适应。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1921,
              "strings": {
