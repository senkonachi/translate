              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1850,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　３人以上になると、聞き手にまわるタイプ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但到了三人以上的场合就成为了倾听方。"
                ]
