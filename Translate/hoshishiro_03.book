                  "01_noir/noi0181.ogg",
                  "MessageWindow",
                  "这么一说，好像真有点像猫咪。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1937,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　目撃者２人によると、お化けは猫っぽかった模様。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　据目击者所言，妖怪似乎是猫的外貌。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1938,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "不満そう",
