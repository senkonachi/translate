                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いまはまだその最中で……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而现在还在冷静的过程中。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
