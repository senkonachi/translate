            },
            {
              "rowIndex": 782,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "がふがふがふ。",
                  "",
                  "02_karuha/kar0565.ogg",
                  "MessageWindow",
                  "吧唧吧唧吧唧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 783,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あっ、こっちにたくさんある。がふがふがふ。",
                  "",
                  "02_karuha/kar0566.ogg",
                  "MessageWindow",
                  "啊，这边还有很多。吧唧吧唧吧唧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 784,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そしてそんな温けぇ心の交流を、気づきもせず\n横から食っちまうやつもいるんだな。",
                  "",
                  "",
                  "MessageWindow",
                  "还有这种丝毫不顾及我们暖人心田的对话，\n横刀夺食的家伙。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 785,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なにが？",
                  "",
                  "02_karuha/kar0567.ogg",
                  "MessageWindow",
                  "你说什么？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 786,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いやいいさ。どれを取るかは自由だ。",
                  "",
                  "",
                  "MessageWindow",
                  "不，算了。拿多少是你的自由。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 787,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント5_b",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 788,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　花江さんと肩をすくめ合った。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我和花江小姐一并耸了耸肩。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 789,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　子供がいっぱい食べるのを見守りながら、\n　大人サイドもマイペースに箸を進め……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我们一边守望着孩子们的吃相，\n　一边也按照我们大人自己的节奏动着筷子……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 790,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あむあむ。",
                  "",
                  "01_noir/noi0427.ogg",
                  "MessageWindow",
                  "啊姆啊姆。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 791,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……んぷ。",
                  "",
                  "01_noir/noi0428.ogg",
                  "MessageWindow",
                  "……嗯唔。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 792,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん。",
                  "",
                  "04_jibie/jib0247.ogg",
                  "MessageWindow",
                  "嗯。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 793,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ふとジビエさんが箸を止めた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐突然停下了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 794,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント5_b_大",
                  "",
                  "",
                  "500",
                  "-150",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 795,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はふぅ。",
                  "",
                  "01_noir/noi0429.ogg",
                  "MessageWindow",
                  "哈呼唔。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 796,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "04_jibie/jib0248.ogg",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 797,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワール、このくらいにしまショーカ。",
                  "",
                  "04_jibie/jib0249.ogg",
                  "MessageWindow",
                  "诺瓦，差不多吃到这里吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 798,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "え、でも。",
                  "",
                  "01_noir/noi0430.ogg",
                  "MessageWindow",
                  "哎，但是。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 799,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もう？\n全然食べてないよ？",
                  "",
                  "02_karuha/kar0568.ogg",
                  "MessageWindow",
                  "已经吃饱了？\n你还没吃多少喔？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 800,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まだ美味しそうに食べてるノワールに、\n　急にストップがかかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦吃得正香，\n　突然被野鸟小姐叫停了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 801,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ワタシ、トーモコロシにキョーミありマス。\nノワール一緒に食べてくだサイ。",
                  "",
                  "04_jibie/jib0250.ogg",
                  "MessageWindow",
                  "我想吃吃玉米。\n诺瓦也和我一起吃吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 802,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ、はい。とうもろこし、好きです。",
                  "",
                  "01_noir/noi0431.ogg",
                  "MessageWindow",
                  "啊，好的。我喜欢、玉米。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 803,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どうしよう。って顔だったノワールだが、\n　別のを食べようと言われれば素直に従う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦一时露出了犹豫不决的表情，\n　不过听到让她去吃别的东西便坦率地答应了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 804,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "バーベキューだから一応焼いてるけど、\nこれ生でも食えるやつだから、\n好きなタイミングでいっちゃっていいぞ。",
                  "",
                  "",
                  "MessageWindow",
                  "因为今天是烤肉聚餐所以烤了一下，\n其实玉米生吃也行，\n烤到想要的火候跟我说一声就好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 805,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ハイ。",
                  "",
                  "04_jibie/jib0251.ogg",
                  "MessageWindow",
                  "好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 806,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ありがとうございます。",
                  "",
                  "01_noir/noi0432.ogg",
                  "MessageWindow",
                  "非常感谢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 807,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　網の端っこで転がしてたやつを２人に渡す。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我将网边的东西取给她们二人。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 808,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まだ焦げ目もついてないけど、熱は入ってるはず。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　没有烤焦的地方，不过熟应该是熟了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 809,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はむ。",
                  "",
                  "01_noir/noi0433.ogg",
                  "MessageWindow",
                  "哈姆。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 810,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どーだ？",
                  "",
                  "",
                  "MessageWindow",
                  "怎么样？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 811,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "甘いです。",
                  "",
                  "01_noir/noi0434.ogg",
                  "MessageWindow",
                  "很甜。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 812,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　シンプルに女の子が好きなやつである。\n　にへーっと笑う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看来是女孩子喜欢的味道。\n　诺瓦露出了甜甜的微笑。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 813,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "トーモコロシ、マヨネーズとショーユどばーで\n食べるのもイーケド、そのままで美味しいデスネー。",
                  "",
                  "04_jibie/jib0252.ogg",
                  "MessageWindow",
                  "用玉米蘸着蛋黄酱和酱油吃挺不错，\n直接吃也很好吃。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 814,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワール。ゆっくり食べてネ。",
                  "",
                  "04_jibie/jib0253.ogg",
                  "MessageWindow",
                  "诺瓦。慢慢吃吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 815,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi0435.ogg",
                  "MessageWindow",
                  "好的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 816,
              "strings": {
                "Array": [
                  "BgEvent",
                  "イベント5_b",
                  "",
                  "",
                  "0",
                  "0",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 817,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 818,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なんか急にノワールに構いだしたジビエさん。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐好像突然关照起了诺瓦。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 819,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これって……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这是……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 820,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "慣れない食べ物は、ゆっくり慣らさないと\n危険と聞きますね。",
                  "",
                  "06_takase/tak0260.ogg",
                  "MessageWindow",
                  "我听说吃太多没习惯的食物是很危险的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 821,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……そういうことだろうな。",
                  "",
                  "",
                  "MessageWindow",
                  "……是啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 822,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　見ればジビエさんも、身体は大きいのに\n　食った肉の量は花江さんより少ない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　仔细一看，野鸟小姐明明体态比较大，\n　但是吃的肉却比花江小姐还少。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 823,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　元ベジタリアン。\n　いまはお肉大好きとのことだが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐是原素食主义者。\n　现在非常喜欢吃肉，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 824,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　食える身体にはなってないらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然而身体还没有习惯肉类。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 825,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はふぅ。",
                  "",
                  "01_noir/noi0436.ogg",
                  "MessageWindow",
                  "哈呼。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 826,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　同じくノワールも、とうもろこしが終わると\n　一仕事終えたって感じのため息。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦吃完了手上的玉米，\n　像工作完成了一般长长地舒了一口气。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 827,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　これはつまり、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这也就是说，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 828,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "04_jibie/jib0254.ogg",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 829,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ごちそーサマしましょうか。",
                  "",
                  "04_jibie/jib0255.ogg",
                  "MessageWindow",
                  "就吃到这里吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 830,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi0437.ogg",
                  "MessageWindow",
                  "好的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 831,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　上手い具合にノワールを誘導してやり、\n　満腹が来る前に終わらせた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　各位全程巧妙地引导着诺瓦，\n　在吃撑前及时制止她继续用餐。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 832,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あまり食べて気持ち悪くしたら可哀想だからな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　要是她吃撑了肠胃不舒服就太可怜了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 833,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　バーベキューは初体験なんだ。\n　大人がうまくコントロールしてやる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　毕竟是第一次吃烤肉，\n　需要大人们多多关照。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 834,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "えー、まだ全然食べてなくない？",
                  "",
                  "02_karuha/kar0569.ogg",
                  "MessageWindow",
                  "哎<dash=2>还没吃多少吧？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 835,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そこら辺読めてないやつが１人。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　现场也有一个不明白大家用意的人。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 836,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お前の取り分が多くなったって考えればいいだろ。",
                  "",
                  "",
                  "MessageWindow",
                  "你就当自己能多吃点不就行了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 837,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それもそっか。\nいえーい３人分食べちゃうぞー。",
                  "",
                  "02_karuha/kar0570.ogg",
                  "MessageWindow",
                  "确实啊。\nyeah，我要把3人份都给吃了<dash=2>",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 838,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　話が通じやすい子で助かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　还好狩叶通情达理。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 839,
              "strings": {
                "Array": [
