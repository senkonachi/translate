            {
              "rowIndex": 2702,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "見てみて、でも美味しそ～",
                  "",
                  "02_karuha/kar0512.ogg",
                  "MessageWindow",
                  "快看快看，好好吃的样子～",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2703,
              "strings": {
