              "strings": {
                "Array": [
                  "",
                  "駅員",
                  "<Character=院長>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どうぞお楽しみください。",
                  "",
                  "99_mob/inc/inc0013.ogg",
                  "MessageWindow",
                  "请各位好好享受吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2737,
              "strings": {
                "Array": [
                  "",
                  "駅員",
                  "<Character=院長>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ヤケド等には気をつけてくださいね。",
                  "",
                  "99_mob/inc/inc0014.ogg",
                  "MessageWindow",
                  "也要注意别烫伤咯。",
                  ""
