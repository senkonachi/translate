              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でも危ない思いをして、焦ったってところだろうか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　恐怕是出事前的危机感令她慌乱了吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1188,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあ怪我がないならなによりだ。",
                  "",
                  "",
                  "MessageWindowMono",
