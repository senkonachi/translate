            },
            {
              "rowIndex": 783,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "その鍵は？",
                  "",
                  "",
                  "MessageWindow",
                  "这钥匙是？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 784,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "この列車のマスターキーみたいなもんよ。\n全部同じ南京錠だからこれ１つで全部あけられるの。",
                  "",
                  "02_karuha/kar0853.ogg",
                  "MessageWindow",
                  "相当于列车的万能钥匙。\n因为所有挂锁都一样，所以可以用这一把钥匙打开"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 785,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 786,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "へー。",
                  "",
                  "",
                  "MessageWindow",
                  "是吗～",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 787,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "逸らし目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
