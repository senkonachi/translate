                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2015,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そうだ。この汽車での俺はシロ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对了。在这火车上我就是白。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2016,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そしてコイツの名前は、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然后这家伙的名字是，",
                  "",
                  ""
                ]
