                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "らしい。",
                  "",
                  "",
                  "MessageWindow",
                  "好像是。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 902,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　グネった道が一本だったので、右も左も関係なく\n　適当に歩いていたが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　路只有那么一条，也没有分岔口。\n　我们就顺着路走了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 903,
              "strings": {
                "Array": [
                  "",
                  "ジビエ大",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 904,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そのせいでぐるっと一回りしてたことに\n　気付かなかったようだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　结果谁都没注意到，\n　转了一圈居然又回来了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 905,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　でもそれはそれで妙だな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　有几分蹊跷。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 906,
              "strings": {
