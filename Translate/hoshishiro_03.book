              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺としては、景色よりそんな彼女をガン見していた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但比起风景，少女的身姿更加吸引我的目光。",
                  ""
                ]
