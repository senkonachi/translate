              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　別に……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　也不是……"
                ]
              },
