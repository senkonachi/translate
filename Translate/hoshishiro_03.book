                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 198,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なにを描くつもりだったのでしょう。",
                  "",
                  "06_takase/tak0128.ogg",
                  "MessageWindow",
                  "本来是打算画什么的呢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 199,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ、そこだよな。",
                  "",
                  "",
                  "MessageWindow",
                  "对啊，问题在这。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 200,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "呆れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ＳＬのボイラーは古いモノですが機械産業の根幹であり、\nその精緻さは、ぱっと見ての印象で書き表せるものでは\nありません、写真というなら分かりますが、絵では……。",
                  "",
                  "06_takase/tak0129.ogg",
                  "MessageWindow",
                  "SL的锅炉再怎么古老，也是重工业的基础，\n里面那种精密的设计，不是能靠看几眼就还原在纸面上的，\n要是照片还能解释，可是画……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 201,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 202,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "別に描いた出来自体は精密じゃなくてもいいだろ。",
                  "",
                  "",
                  "MessageWindow",
                  "画出来的东西也没必要追求那么精密吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 203,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き気だるい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
