              "rowIndex": 871,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "アリです。言いたくなければ無視してください。",
                  "",
                  "06_takase/tak0196.ogg",
                  "MessageWindow",
                  "没问题。不想回答的问题就直接无视我吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
