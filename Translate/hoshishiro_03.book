              "isCommentOut": 0
            },
            {
              "rowIndex": 2916,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "怖いわけじゃないわよ別に。",
                  "",
                  "02_karuha/kar1096.ogg",
                  "MessageWindow",
                  "我可没害怕。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2917,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2918,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　口と行動が軽くなってるカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　语气和行动都变得轻松起来了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2919,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　行動基準が緩んでるのは、\n『この病院にお姉さんがいない』という\n　俺の話を信じてくれてるってことだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　之所以会有这样的改变，\n　是因为相信了我“你姐姐不在这所医院里”\n　这句话。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2920,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　冷静になれてる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　所以冷静了下来。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2921,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "じゃあ行こう。",
                  "",
                  "",
                  "MessageWindow",
                  "那就走吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
