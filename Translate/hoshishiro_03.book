            },
            {
              "rowIndex": 1888,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　えへへと笑うジビエさん。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　野鸟小姐傻笑了几声。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1889,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まあたぶん、悩み事をしながら<dash=2>、\n　つまりよそ事を考えながら森に入ると危ないですよーって\n　逸話なんだろうが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过她所说的意思应该就是\n　带着烦恼，或者一边想事情一边在森林里漫步是很危险的事情。\n　大概是这个道理吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1890,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1891,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "諦観",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はあ。",
                  "",
                  "01_noir/noi0175.ogg",
                  "MessageWindow",
                  "唉。",
                  ""
                ]
