                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　カーブ……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　转弯……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 989,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　したっけ？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　转弯了？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 990,
              "strings": {
