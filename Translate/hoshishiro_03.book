                  "通常目少し困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あうん。",
                  "",
                  "01_noir/noi0235.ogg",
                  "MessageWindow",
                  "啊呜。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2648,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "残念だったな。\nま、旅が終わったら食べてみろ。",
                  "",
                  "",
                  "MessageWindow",
                  "有点遗憾呢。\n等旅行结束了有机会去尝尝吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2649,
              "strings": {
                "Array": [
                  "Tween",
                  "ノワール",
