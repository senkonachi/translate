            },
            {
              "rowIndex": 1912,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ひとまず時間あけましょ。\nあとでもう１回チャレンジよ。",
                  "",
                  "02_karuha/kar0417.ogg",
                  "MessageWindow",
                  "先给她点时间吧。\n之后再挑战一次找她搭话吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1913,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺の隣に座るカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶坐到我身旁。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1914,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "挑戦はいいけど、いきなり水かけるのはちがうぞ。",
                  "",
                  "",
                  "MessageWindow",
                  "勇于挑战是好事，不过突然泼水可算不上挑战喔。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1915,
