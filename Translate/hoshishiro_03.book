            {
              "rowIndex": 2490,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　通りに面してる病院を指さすノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦指着前方的一家医院说道。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2491,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　天の川病院？\n　っていうと、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　天河医院？\n　也就是说……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2492,
              "strings": {
