            },
            {
              "rowIndex": 336,
              "strings": {
                "Array": [
                  "",
                  "ねり",
                  "心配",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "一番辛いことに耐えられない。",
                  "",
                  "03_neri/ner0340.ogg",
                  "MessageWindow",
                  "她会忍受不住最令人痛苦的事。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 337,
              "strings": {
