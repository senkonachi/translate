              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目笑顔",
                  "レイヤー_キャラ２人右",
                  "80",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1260,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ひとまずその白髪の、あるびの？　の子を探すわよ。\nもし乗ってるなら無賃乗車だわ。取り締まらなくちゃ。",
                  "",
                  "02_karuha/kar0730.ogg",
                  "MessageWindow",
                  "首先寻找那个白毛妹，也就是“白化”的女孩吧。\n在车上的话就是无票乘车。要管教一番"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1261,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "微笑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1262,
              "strings": {
