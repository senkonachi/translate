              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "06_takase/tak0066.ogg",
                  "MessageWindow",
                  "好。",
                  ""
