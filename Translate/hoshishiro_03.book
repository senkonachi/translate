            },
            {
              "rowIndex": 2541,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "やあ。",
                  "",
                  "",
                  "MessageWindow",
                  "你好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2542,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょうど車掌さんも来て、この汽車の乗員が\n　全員集まることに。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　此时乘务员走了进来，\n　这样火车上的全员都凑齐了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2543,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2544,
              "strings": {
