            {
              "rowIndex": 1013,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "<Character=タカセ大>流し目微笑困り眉",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "二度と思い出したくない。",
                  "",
                  "06_takase/tak0224.ogg",
                  "MessageWindow",
                  "再也不想回忆起来了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1014,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ大",
                  "PunchPosition",
                  "x=10 time=2",
