              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　駅のあった場所へ駆け出した。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我冲向车站所在的方位。",
                  "",
                  ""
