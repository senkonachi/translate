                  "っ<dash=2>。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯<dash=2>"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1880,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_病院前大通り_夜ライト",
                  "",
                  "",
                  "",
                  "",
