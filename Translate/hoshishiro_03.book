              "rowIndex": 1095,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺たちはそれで充分だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我们就满足了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1096,
              "strings": {
                "Array": [
