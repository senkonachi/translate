            },
            {
              "rowIndex": 1059,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "アルビノの人は……もっとでショーネ。",
                  "",
                  "04_jibie/jib0326.ogg",
                  "MessageWindow",
                  "白化病人……应该更辛苦吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1060,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1061,
              "strings": {
