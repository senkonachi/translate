                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 291,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　案内してくれる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她在引导乘客。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 292,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　このツアーのコンダクターらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看来是这趟旅行的导游了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 293,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "微笑",
                  "",
