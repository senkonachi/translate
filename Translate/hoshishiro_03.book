            {
              "rowIndex": 2197,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はああ。",
                  "",
                  "02_karuha/kar0463.ogg",
                  "MessageWindow",
                  "唉……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2198,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それで、えと、大学はもう出てるのよね。",
                  "",
                  "02_karuha/kar0464.ogg",
                  "MessageWindow",
                  "话说，那个，你已经毕业了吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2199,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2200,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ。もうとっくに。",
                  "",
                  "",
                  "MessageWindow",
                  "是啊。早就毕业了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2201,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そんなに若くない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我已经不年轻了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
