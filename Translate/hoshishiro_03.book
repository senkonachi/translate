            },
            {
              "rowIndex": 1956,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺たちと一緒。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　你的心情和我们的一样。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1957,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　だよな、ノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对吧，诺瓦。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1958,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちがうとは言わせないぜ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　你可别说不一样哦。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1959,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　世界は辛くて、生きづらいものだったけど。\n　この旅の間だけは。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然这个世界很残酷，很难活下去。\n　但是，在这段旅途中。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1960,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺たちとの旅が、楽しくなかったわけがない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　和我们的一起的旅途，你一定很开心吧。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1961,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　だろう？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　没错吧？",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
