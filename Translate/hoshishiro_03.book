            },
            {
              "rowIndex": 3187,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はえー、ひとつ勉強になった。",
                  "",
                  "02_karuha/kar1129.ogg",
                  "MessageWindow",
                  "哇，学到新知识了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3188,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こいつ、わりと余裕あるな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这家伙，还挺轻松的嘛。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3189,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……ま、いまがまるで都市伝説みたいな\n異常な状況ってのは認めるけど。",
                  "",
                  "",
                  "MessageWindow",
                  "……不过，\n现在关于这艘船的事件确实变得好像都市传说一样了。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3190,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3191,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　入院患者も含めて人はいない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　包括住院患者，这里一个人都没有。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
