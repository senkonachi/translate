              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "事故に遭った子というのは。",
                  "",
                  "99_mob/inc/inc0020.ogg",
                  "MessageWindow",
                  "遇到事故的孩子是。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 27,
              "strings": {
                "Array": [
                  "",
                  "？？？",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "風又……ねりちゃん。女の子です。",
                  "",
                  "99_mob/nan/nan0006.ogg",
                  "MessageWindow",
                  "风又……音理，是个女孩子。"
