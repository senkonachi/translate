            {
              "rowIndex": 3265,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "知ってるのか？",
                  "",
                  "",
                  "MessageWindow",
                  "你知道吗？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3266,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お姉ちゃんが話してた。\n夜羽さんって言って、この病院の院長先生の、\nお孫さんなんだって。",
                  "",
                  "02_karuha/kar1140.ogg",
                  "MessageWindow",
                  "姐姐跟我说过。\n这个叫夜羽小姐的，\n是这所医院院长的孙女。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3267,
              "strings": {
