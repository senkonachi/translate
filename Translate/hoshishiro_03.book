            },
            {
              "rowIndex": 2579,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。はじめてです。",
                  "",
                  "01_noir/noi0225.ogg",
                  "MessageWindow",
                  "是的。第一次吃。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2580,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
