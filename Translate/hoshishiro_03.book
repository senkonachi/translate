                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1052,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ",
                  "PunchPosition",
                  "x=15 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
