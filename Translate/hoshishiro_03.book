              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1843,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "こんなの、見たことないです。",
                  "",
                  "01_noir/noi0058.ogg",
                  "MessageWindow",
                  "从来没有见过这种景色。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1844,
              "strings": {
