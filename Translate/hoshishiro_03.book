                  "カルハ",
                  "<Character=大カルハ>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でしょ。先にニャクルト回収しといてよかった。",
                  "",
                  "02_karuha/kar0329.ogg",
                  "MessageWindow",
                  "对吧。好在趁早把妙乐多回收过来了",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1474,
              "strings": {
