            },
            {
              "rowIndex": 82,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ガチでくらっときた。\n　これは立ち止まってると貧血を起こすやつだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　突如其来一阵眩晕感。\n　再站着就要贫血了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 83,
              "strings": {
                "Array": [
