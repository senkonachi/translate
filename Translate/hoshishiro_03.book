              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2536,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっき飛び出した俺がいうのもなんだが、\n　１人だと危険かもしれない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　虽然刚才也突然跑开的我没资格说这话，\n　但狩叶她独自行动可能会有危险的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2537,
              "strings": {
                "Array": [
