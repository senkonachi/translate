              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1438,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それに、いまの仕事についてからも……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　包括有了现在这份工作之后也……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
