              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　森を抜けたかと思った瞬間、別の場所にいた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　以为自己穿过森林的瞬间，到达了别的地方。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
