                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 958,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いえ、それはすでに資料として知っていますし、\nさっき停車しているとき、\n自分の手で車輪をなで回して確かめました。",
                  "",
                  "06_takase/tak0297.ogg",
                  "MessageWindow",
                  "不，那我已经通过查资料知道了，\n而且刚才停车的时候，\n我也用自己的手比着车轮确认过了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 959,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 960,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そんなことしてたのか。キモいな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这么狂热的嘛。真令人生厌……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 961,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "計りたい円は、線路。",
                  "",
                  "06_takase/tak0298.ogg",
                  "MessageWindow",
                  "我想测量的圆是线路上的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 962,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "少し怒り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "この汽車の進行範囲を計りたいのです。",
                  "",
                  "06_takase/tak0299.ogg",
                  "MessageWindow",
                  "我想测量这辆火车的行驶范围。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 963,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
