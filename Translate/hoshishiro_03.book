              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　<dash=2>ゴッッ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　——轰隆。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1468,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　トンネルに入ったのか、一気に暗闇に包まれる室内。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　似乎是进了隧道，室内突然笼罩在昏暗之中。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1469,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ゴゥゴゥとボイラーの焼ける音が聞こえる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只能听到锅炉的隆隆声。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1470,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "結構暗いな。",
                  "",
                  "",
                  "MessageWindow",
                  "还真暗啊。",
                  ""
                ]
