              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1766,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。",
                  "",
                  "01_noir/noi1033.ogg",
                  "MessageWindow",
                  "嗯。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1767,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　今はそう言っておこう。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　现在就这么说吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1768,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　全てが分かるまで、ノワールには今を楽しんで欲しい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一切真相大白之前，我都希望诺瓦能享受当下的旅行。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1769,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "旅の楽しみ……。",
                  "",
                  "",
                  "MessageWindow",
                  "旅途的乐趣……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1770,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "通常目少し驚き",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
