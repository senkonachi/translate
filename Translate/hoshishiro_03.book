            },
            {
              "rowIndex": 1439,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なにやってたんだ？　盛り上がってるのは聞こえたけど。",
                  "",
                  "",
                  "MessageWindow",
                  "你们在做什么啊？　听你们兴致怪高的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1440,
              "strings": {
                "Array": [
                  "Tween",
                  "カルハ",
                  "PunchPosition",
                  "y=30 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
