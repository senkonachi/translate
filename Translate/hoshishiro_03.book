                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2980,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……何か聞いたので？",
                  "",
                  "06_takase/tak0071.ogg",
                  "MessageWindow",
                  "……是听到什么了吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2981,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……お化けだったのかな。",
                  "",
                  "",
                  "MessageWindow",
                  "……也许是妖怪吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2982,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2983,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールたちは『見た』と言っていたが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦她们说的是“看到了”。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2984,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺は『聞いた』。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而我是“听到了”。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2985,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あっちは化け物。\n　なにか大きなものに食べられそうと言っていたが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她们看到了妖怪。\n　还说差点被巨大的妖怪吃掉，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2986,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2987,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺が聞いたのは、たぶん子供の声だった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而我这边听到的是，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2988,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　女の子の。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　小女孩的声音。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2989,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2990,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ノワールやカルハとは違う……けど。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过……跟诺瓦和狩叶说的不一样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2991,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　聞き覚えがあったような？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这声音好像有些耳熟？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2992,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=15 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2993,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ふむ。",
                  "",
                  "06_takase/tak0072.ogg",
                  "MessageWindow",
                  "唔。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2994,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2995,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "幽霊……まあ幽霊を否定する材料は、\n少なくとも僕は持ち合わせていませんが。",
                  "",
                  "06_takase/tak0073.ogg",
                  "MessageWindow",
                  "幽灵……唔，\n我手里确实没有什么依据能否认幽灵这种说法。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2996,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　のどに手をやりながら言う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他摸着自己的喉结说道。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2997,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2998,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ここは山奥とは言っても、道がぐるっと一周する。\nつまり遊歩道が整備されています。",
                  "",
                  "06_takase/tak0074.ogg",
                  "MessageWindow",
                  "即使这里是深山，道路却能绕一圈转回来。\n证明这是为游客修缮的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2999,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "呆れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "幽霊の類いが出る環境ではないかと。\nしかもいまは昼なのに。",
                  "",
                  "06_takase/tak0075.ogg",
                  "MessageWindow",
                  "那么这就不该是幽灵之类出现的地方。\n况且现在还是白天。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3000,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "だよなあ。",
                  "",
                  "",
                  "MessageWindow",
                  "也是。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3001,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3002,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　心霊現象については、信じても疑ってもいない派である。\n　あるならあるでいいと思う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我属于既不相信也不怀疑心灵现象的那种人。\n　若是真的存在倒也没什么问题。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3003,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3004,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただいきなり出てこられても……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可是，当自己突然遇到这种情况的话……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3005,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　怖がるべきか、お祓いを考えるべきかすら分からない。\n　戸惑うばかりだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　应该连该感到害怕还是该找人除魔都无法正常判断了吧。\n　充斥于心中的仅有迷惑之情。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3006,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=15 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3007,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "現実的に考えるなら、いわゆる『森の妖精』が\n考えられますね。",
                  "",
                  "06_takase/tak0076.ogg",
                  "MessageWindow",
                  "如果考虑得现实一点，\n“森林的妖精”可以一提。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3008,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……現実的？",
                  "",
                  "",
                  "MessageWindow",
                  "……现实？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3009,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　妖精て、メルヘンそのものだぞ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　妖精可是典型的虚构产物啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3010,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3011,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目微笑困り眉",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "現実的な尺度での妖精ですよ。",
                  "",
                  "06_takase/tak0077.ogg",
                  "MessageWindow",
                  "是在现实意义上能够存在的妖精啦。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3012,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　分かってますとばかり苦笑するタカセ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　“这我当然知道了”鹰世苦笑道。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3013,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3014,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "森の空気というのは、普段我々が吸うものとは\n大きく違っている。と言う話はご存じで？",
                  "",
                  "06_takase/tak0078.ogg",
                  "MessageWindow",
                  "森林的空气和我们平时呼吸的空气有很大差异。\n你听过这种说法吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3015,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "フィトンチットとかいう？",
                  "",
                  "",
                  "MessageWindow",
                  "是说芬多精吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3016,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3017,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ええ。人間のストレス軽減に役立つフィトンチットは\n有名ですね。",
                  "",
                  "06_takase/tak0079.ogg",
                  "MessageWindow",
                  "是的。\n芬多精以能缓解人类的压力而出名。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3018,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ただ森の木々が、都合良く人間のストレスを\n取り除こうとしているわけがない。",
                  "",
                  "06_takase/tak0080.ogg",
                  "MessageWindow",
                  "但是森林里的树木可不是为了帮人缓解压力而存在的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3019,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目通常",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "木々にとって侵入者は、そのまま侵略者。\n警戒すべき相手です。\n当然そんな相手に吐きかけるものは……。",
                  "",
                  "06_takase/tak0081.ogg",
                  "MessageWindow",
                  "进入到森林里的入侵者，就是树木的敌人。\n是需要戒备的对象。\n自然，它们对入侵者释放出来的……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3020,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "毒？",
                  "",
                  "",
                  "MessageWindow",
                  "毒物？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3021,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3022,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "フィトンチットも本来は、木々が害虫避けのため\n出す物質だそうですよ。",
                  "",
                  "06_takase/tak0082.ogg",
                  "MessageWindow",
                  "据说芬多精原本是树木为了驱赶害虫而分泌的物质。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3023,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なるほど。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　原来如此。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3024,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "その『森の空気』ってやつに、なんかこう、\n幻覚を見せる空気が含まれてる、的な。",
                  "",
                  "",
                  "MessageWindow",
                  "就是说，所谓“森林的空气”，\n里面其实含有致幻剂一类的成分？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3025,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3026,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "呆れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それもあります。\n幻覚作用のあるキノコの胞子がいくらでも充満しているのが、\n森という空間ですので。",
                  "",
                  "06_takase/tak0083.ogg",
                  "MessageWindow",
                  "这是一方面。\n毕竟，森林里说不准充满了可能致幻的菌菇孢子。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3027,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "もしくは過度にストレスが軽減されたことで、\nリラックスのしすぎで、起きたまま夢を見ているような\n状態になっていることも。",
                  "",
                  "06_takase/tak0084.ogg",
                  "MessageWindow",
                  "另一方面，\n可能是芬多精减缓压力的效果过强，\n精神过于放松导致出现了类似做白日梦的现象。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3028,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "普段とはちがう空間で、ちがう空気に触れ、\n結果普段とはちがう精神状態になる。",
                  "",
                  "06_takase/tak0085.ogg",
                  "MessageWindow",
                  "在与平时不同的空间里，呼吸着不同的空气，\n结果产生了与平时不同的精神状态。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3029,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "こうしたとき人が見てしまうものを、\n古くから『森の妖精』と言うのでは。\nなんてレポートを、少し前に読みました。",
                  "",
                  "06_takase/tak0086.ogg",
                  "MessageWindow",
                  "或许，这种情况下遭遇的情景正是传说中的“森林的妖精”。\n这是我之前在学术报告上看到的论述.",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3030,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "は～",
                  "",
                  "",
                  "MessageWindow",
                  "哈～",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3031,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なるほど。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　原来如此。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3032,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それなら俺が聞いた声の正体は分かる。夢だと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　按此说法我之前听到的声音就是白日梦啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3033,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "でもノワールたちは？\n２人してやべーモンに襲われたっぽいけど。",
                  "",
                  "",
                  "MessageWindow",
                  "可是诺瓦她们呢？\n她们两个人都说被可怕的东西袭击了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3034,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3035,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "それもいわゆる『妖精を見た』の典型ですよ。\nおしゃべりしながら歩いている子供というのは、\n空想を共有しやすいものです。",
                  "",
                  "06_takase/tak0087.ogg",
                  "MessageWindow",
                  "这也是“看到妖精”的典型现象。\n边走边聊天的孩子们很容易共享相同的幻想。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3036,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なるほどなあ。",
                  "",
                  "",
                  "MessageWindow",
                  "原来是这样。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3037,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3038,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "06_takase/tak0088.ogg",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3039,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3040,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "本当にお化けだった。\nって可能性と、どっちが高いかな。",
                  "",
                  "",
                  "MessageWindow",
                  "和真有妖怪出现相比，\n哪边几率更大呢？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3041,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "x=10 time=2",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3042,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "難しいですね。",
                  "",
                  "06_takase/tak0089.ogg",
                  "MessageWindow",
                  "这就难说了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3043,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　苦笑するタカセ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　鹰世苦笑着。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3044,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3045,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　森の空気にあてられた。\n　面白い仮説ではある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　受到森林空气的影响。\n　确实是个有趣的假说。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3046,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3047,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ただそんな話は、例えば心霊現象をむきになって\n　否定したがる大学教授とかが唱えそうなもの。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不过就这个假说而言，\n　颇有一番大学教授对心灵现象感到不爽从而强行否定的感觉。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3048,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　幽霊とやらにこだわりのない俺としては、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　对于我这个对幽灵之类并不抵触的人来说，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3049,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　素直に幽霊だったってほうがピンと来る。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　幽灵真实存在反倒更容易接受。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3050,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3051,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ま、でも面白い話ではあったよ。\nサンキュータカセ。",
                  "",
                  "",
                  "MessageWindow",
                  "总之这个说法挺有趣的。\n多谢了鹰世。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3052,
              "strings": {
                "Array": [
                  "StopBgm",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "3",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3053,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "PunchPosition",
                  "x=10 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3054,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "通常営業スマイル",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いえ。",
                  "",
                  "06_takase/tak0090.ogg",
                  "MessageWindow",
                  "没关系。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3055,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=-10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3056,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目閉じ笑顔",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "個人的には、幽霊だった。のほうがロマンを感じて\nよいとは思うのですがね。",
                  "",
                  "06_takase/tak0091.ogg",
                  "MessageWindow",
                  "从我个人的角度出发，\n真有幽灵反倒是更具有浪漫主义气息一些。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3057,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ",
                  "MoveBy",
                  "y=10 time=0.5",
                  "",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3058,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "目開き悲しい",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "誰かに出会いたがっている魂の残り香が、\n我々に会いに来てくれた、と考える方が。",
                  "",
                  "06_takase/tak0092.ogg",
                  "MessageWindow",
                  "不禁令我想象到，\n渴望与人相遇的灵魂的余香寻到了我们面前。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3059,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目困惑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "人は死んだあとも、なにかを残せる生き物だと\n考えられたほうが。",
                  "",
                  "06_takase/tak0093.ogg",
                  "MessageWindow",
                  "人这种生物，死后还希望在后世留下点什么。\n真是感慨万千。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3060,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
