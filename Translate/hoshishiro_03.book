            },
            {
              "rowIndex": 283,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ねえ、シロさん。",
                  "",
                  "01_noir/noi1281.ogg",
                  "MessageWindow",
                  "白先生啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 284,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うん？",
                  "",
                  "",
                  "MessageWindow",
                  "嗯？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 285,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "言ってくれませんか？\nわたしに、ねりさんの分まで生きろって。",
                  "",
                  "01_noir/noi1282.ogg",
                  "MessageWindow",
                  "你不肯对我说吗？\n要我连着音理小姐那份一起活下去。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 286,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ねりさんを奪ってしまったぶん、わたしにも生きろって。",
                  "",
                  "01_noir/noi1283.ogg",
                  "MessageWindow",
                  "说既然夺走了音理小姐，那就要活下去。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 287,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "シロさんが言ってくれたら、がんばれる気がする。",
                  "",
                  "01_noir/noi1284.ogg",
                  "MessageWindow",
                  "如果你肯这么说的话，那我大概就能继续努力了。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 288,
              "strings": {
                "Array": [
