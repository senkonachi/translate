                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "うん。",
                  "",
                  "02_karuha/kar0122.ogg",
                  "MessageWindow",
                  "嗯。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1172,
              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "服……置いて来ちゃいました。",
                  "",
                  "01_noir/noi0136.ogg",
                  "MessageWindow",
                  "衣服……放在那里没有拿。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1173,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ふむ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　让我思考一下。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1174,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　お化けはともかく……女の子２人を招いておいて、\n　服を脱げ？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　先不说妖怪什么的……招待两个女孩子进去，\n　上来就脱衣服？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1175,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どういう店だよ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这什么店啊。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1176,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いかがわしいやつじゃないだろうな。\n　こんな山奥で。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　还开在这种深山老林里，\n　也太可疑了吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1177,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　どっちにしろ、近づかないほうがいいのは確かだろうが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　总之，不要接近为妙。",
                  ""
