              "rowIndex": 602,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　てかそもそも俺みたいな職業だと歩くの自体が……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　从事我这份职业的人，本身走路的机会就很少……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
