              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　１人はあの白の少女。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　一个是那个纯白的少女",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 211,
              "strings": {
