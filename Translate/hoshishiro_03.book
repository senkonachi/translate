            },
            {
              "rowIndex": 724,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "ギャグほっこり",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "いートコロです。\nお昼寝したくなりマスネ。",
                  "",
                  "04_jibie/jib0051.ogg",
                  "MessageWindow",
                  "是个好地方。\n都想躺下睡一觉了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 725,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "駅の近くでなら、６時間したら起こしますよ。",
                  "",
                  "",
                  "MessageWindow",
                  "离车站不远的话，过六个小时我可以叫你起来。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 726,
              "strings": {
                "Array": [
                  "Tween",
                  "ジビエ",
                  "PunchPosition",
                  "x=30 time=1",
                  "easeInQuad",
                  "",
                  "",
                  "PageWaitSkippable",
                  "",
                  "",
                  "",
                  "",
