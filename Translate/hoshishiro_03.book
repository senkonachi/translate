              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1305,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　アンティークだけあって窓も手動になっている。\n　自由に開け閉めしていいはずだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真不愧是古董，连窗户都是手动的。\n　应该是让乘客可以自由开关。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
