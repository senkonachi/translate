                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ぽふぽふ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　沙沙。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 768,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　頭を撫でてやった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我摸了摸她的头。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 769,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　申し訳なさそうに顔を伏せてるノワール。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦略带歉意地低下了头。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 770,
              "strings": {
                "Array": [
                  "",
                  "ノワール大",
                  "閉じ目悩み",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 771,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　初めて会ったときから思ってたけど、コイツ……、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　刚和她见面的时候我就隐约有所察觉，",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 772,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　人間付き合い、みたいのが、苦手っぽいな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她好像不太擅长跟人交流。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 773,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　苦手というか、分かってない。\n　人と人の会話の空気みたいのを知らない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　与其说是不擅长，不如说是理解不足。\n　她很难读懂人与人交流时的说话氛围。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 774,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　……本当に猫だから。とかじゃないだろうな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　……该不会真的是猫吧。",
                  ""
                ]
