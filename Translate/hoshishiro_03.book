            },
            {
              "rowIndex": 2975,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "流し目困惑",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お化けを見た気はしませんが。",
                  "",
                  "06_takase/tak0069.ogg",
                  "MessageWindow",
                  "我并没有觉得见到了妖怪。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2976,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "声は？",
                  "",
                  "",
                  "MessageWindow",
                  "那声音呢？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2977,
              "strings": {
                "Array": [
