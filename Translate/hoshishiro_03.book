            {
              "rowIndex": 1991,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　やべ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不好。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
