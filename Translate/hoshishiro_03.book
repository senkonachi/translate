            },
            {
              "rowIndex": 2676,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "看護師さん……してる。",
                  "",
                  "02_karuha/kar1079.ogg",
                  "MessageWindow",
                  "在这里……当护士。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2677,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　沈み込んでるカルハ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶看上去消沉不已。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2678,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　シスコンっぽいというか、お姉さんのことが大好きなのは\n　これまでの態度で分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　从之前的态度就看得出来，\n　她非常喜欢自己的姐姐，几乎到了可以说是姐控的程度。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2679,
              "strings": {
                "Array": [
                  "",
                  "カルハ大",
                  "逸らし目照れ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2680,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そんな人が、本来いるはずの場所にいない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　而这个姐姐，却不在原本该在的地方。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
