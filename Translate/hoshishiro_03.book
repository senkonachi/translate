                  "",
                  "ノワール",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "そ、そうですか……けふん。",
                  "",
                  "01_noir/noi0414.ogg",
                  "MessageWindow",
                  "是、是吗……咳咳。",
                  ""
