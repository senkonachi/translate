            },
            {
              "rowIndex": 203,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ああ……だな。",
                  "",
                  "",
                  "MessageWindow",
