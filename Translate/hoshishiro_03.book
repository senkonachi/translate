                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 957,
              "strings": {
                "Array": [
                  "",
                  "タカセ大",
                  "通常やや困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 958,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "失敗したときの責任はこっちだけにくるんだから……。\n共同って言い方は引っかかるけど。",
                  "",
                  "",
                  "MessageWindow",
                  "不过出问题的时候，锅都在我们头上……\n我其实挺不爽“合作”这个词的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 959,
              "strings": {
                "Array": [
                  "Tween",
                  "タカセ大",
                  "PunchPosition",
                  "y=-10 time=1",
                  "easeInQuad",
