                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2670,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2671,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　言われた通りカルハはボイラーの奥の貯蔵庫へ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶向他说的锅炉里间的储藏库走去。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2672,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　駅員さんは作業を中断して、近くの棚を開けた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　站务员先生停下了手上的活，打开了附近的架子。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2673,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　段ボールがいくつか並んでおり、そのひとつを開ける。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　顺手打开了上面并排几个箱子中的一个。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2674,
              "strings": {
                "Array": [
                  "",
                  "駅員",
                  "<Character=院長>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "良質な炭を使っていますので問題ないでしょうが、\n湿気ていたらまた取りに来てください。",
                  "",
                  "99_mob/inc/inc0009",
                  "MessageWindow",
                  "用上等的炭应该没问题吧，\n要是弄湿了就再来取吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2675,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "は、はい。",
                  "",
                  "",
                  "MessageWindow",
                  "好、好的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2676,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　手頃なブリキのバケツに段ボールの中身……。\n　炭を移していった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他取过一个适当大小的白色铁皮水桶，\n　把炭装到了里面。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2677,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "こんなところに炭が。",
                  "",
                  "",
                  "MessageWindow",
                  "这种地方竟然有炭。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2678,
              "strings": {
                "Array": [
                  "",
                  "駅員",
                  "<Character=院長>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "エンジンの着火用です。\n強めの喝を入れないと働かないもので。",
                  "",
                  "99_mob/inc/inc0010",
                  "MessageWindow",
                  "这是用来给引擎点火的。\n如果火势不猛，是没法正常启动的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2679,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ボイラーを指さす。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他指着锅炉说道。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2680,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　石炭に火を入れるためのものらしい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　似乎煤炭就是在这里面烧起来的。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2681,
              "strings": {
                "Array": [
                  "",
                  "駅員",
                  "<Character=院長>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "どうぞ。\n他の道具を取りにいってきます。",
                  "",
                  "99_mob/inc/inc0011",
                  "MessageWindow",
                  "拿着吧。\n我去取别的东西。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2682,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ど、ども。",
                  "",
                  "",
                  "MessageWindow",
                  "谢、谢谢。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2683,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　バケツを渡される。\n　マッチやなんかはすでに入っていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他将水桶递给我。\n　里面已经装着火柴之类的小物件了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2684,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ジイさんはそのまま、のそりと外へ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　随后老爷爷慢悠悠地走到外面。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
