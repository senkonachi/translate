              "strings": {
                "Array": [
                  "",
                  "ノワール",
                  "<Character=ノワール大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "はい。あと、目の色。",
                  "",
                  "01_noir/noi1057.ogg",
                  "MessageWindow",
