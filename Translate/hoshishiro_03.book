                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2577,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目口明け小",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "てか、食べたことなかったのねノワール。",
                  "",
                  "02_karuha/kar0190.ogg",
                  "MessageWindow",
                  "话说，诺瓦你以前没吃过这个啊？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2578,
              "strings": {
                "Array": [
