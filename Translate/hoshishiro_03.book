              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　２人いたら……、……更にうるさかったろうな。",
                  "",
                  "",
                  "MessageWindowMono",
