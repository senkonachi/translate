                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 765,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "んー？\nああ、そっか、そんな話してたわね。",
                  "",
                  "02_karuha/kar0852.ogg",
                  "MessageWindow",
                  "嗯～？\n喔对了，还有这回事来着。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 766,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "逸らし目",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 767,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　さっきまでの名探偵熱はすっかり冷めてるっぽいな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看来刚刚还在的名侦探的热度消了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 768,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　白髪の侵入者とやらがいる可能性が\n　１％くらいはあるので、後ろの貨物を点検することに。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　因为还是有可能存在白发的入侵者，\n　狩叶就开始清点起了货物。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 769,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 770,
              "strings": {
                "Array": [
                  "Bg",
                  "背景大_駅列車_昼",
                  "",
                  "",
                  "-500",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 771,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　客車の真後ろは薪だけが乗せられた貨物置が２両。\n　ここに隠れるスペースはない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　客运车厢后面紧接着两节装有木柴的货运车厢。\n　这里没有容人藏身的空间。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 772,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　隠れようとしたら、重い薪に潰される。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　藏在这里只会被沉重的木柴压扁。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 773,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その後ろは、木製のコンテナ型。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　再往后则是木制的集装箱型车厢。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 774,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここなら隠れやすい。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　藏身在这里倒是挺方便的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 775,
              "strings": {
                "Array": [
