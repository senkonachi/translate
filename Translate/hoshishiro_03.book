                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　こっちは現代っ子の模様。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这位就是典型的现代小孩了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
