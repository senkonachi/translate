                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　思ってると。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　正在这时。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
