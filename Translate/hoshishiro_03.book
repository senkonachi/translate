                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1508,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Character=真白大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ……ぅ……あ。",
                  "",
                  "07_mashiro/mas0070.ogg",
                  "MessageWindow",
                  "啊……呜……啊。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1509,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　助けて。目で訴える。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　救救我。我在用眼神求救。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1510,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なにか薬はないのか。痛みや吐き気を抑える何か。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　有没有什么药。缓解疼痛和呕吐感的药。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1511,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　訴えるのだが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　但是……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
