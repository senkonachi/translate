              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　持ってきてあったウインドブレーカーを貸してあげた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　于是我把自己带来的外套借给了她。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
