                  "02_karuha/kar0510.ogg",
                  "MessageWindow",
                  "是吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2695,
              "strings": {
