            },
            {
              "rowIndex": 3274,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なんでもね、最近すごく大きな手術を受けたとかで。",
                  "",
                  "02_karuha/kar1142.ogg",
                  "MessageWindow",
                  "听说最近刚刚接受过一次超大的手术。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3275,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ん……。",
                  "",
                  "",
                  "MessageWindow",
                  "嗯……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3276,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　そういえば、手術をしたとも言ってたな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　说起来，她确实说过手术的事。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3277,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それでお母さんとの間柄がぎくしゃくしたとも。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　还因此和母亲闹了不愉快。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 3278,
              "strings": {
