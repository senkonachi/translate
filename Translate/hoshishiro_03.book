                "Array": [
                  "Bg",
                  "背景_病院フロント_暗",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2584,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ここだけが開いている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　只有这里是可以入内的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2585,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ちょっと待て、ルールを確認だ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　等等，再确认一下规则。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2586,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　コンビニやうちのアパートには鍵が掛かってたけど、\n　どうしてここだけ？",
                  "",
                  "",
                  "MessageWindowMono",
                  "　便利店和我租的公寓都锁上了，\n　为什么只有这里没锁？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2587,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お姉ちゃんっ、お姉ちゃんいる！？",
                  "",
                  "02_karuha/kar1068.ogg",
                  "MessageWindow",
                  "姐姐，姐姐你在吗！？"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2588,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "っと。",
                  "",
                  "",
                  "MessageWindow",
                  "啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2589,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　思案してる場合じゃなかった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　现在不是思考这些的时候。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2590,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　中に入ったカルハは、人が居ないのを良いことに\n　フロントにある受け付けに入り込んでいる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　狩叶见里面空无一人，\n　直接就闯入了前台里。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2591,
              "strings": {
                "Array": [
                  "Se",
                  "SE046",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2592,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ガチャガチャとテーブルを荒らしていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然后在桌子上翻找东西，弄得一团糟。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2593,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "おい、なにやってんだ。",
                  "",
                  "",
                  "MessageWindow",
                  "喂，你在干什么啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2594,
              "strings": {
                "Array": [
                  "StopBgm",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "2",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2595,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "通常目困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "あ……。",
                  "",
                  "02_karuha/kar1069.ogg",
                  "MessageWindow",
                  "啊……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2596,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺が追ってきたのを見て、少し落ち着く。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　看到追上来的我，她稍微冷静了一点"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2597,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　落ち着くっていうか、戸惑ってる感じ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不，与其说冷静，不如说是陷入困惑了吧。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2598,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
