                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2662,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　握りしめてくしゃけた書類……勤務表を見せてくれる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她将一直捏在手里的文件……排班表举到我面前。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2663,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　知らない名前がいくつか並んでおり、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　上面写着一些陌生的名字……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
