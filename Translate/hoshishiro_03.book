            {
              "rowIndex": 1946,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ノワール、お前お化けが猫のパターンでも怖いのか？",
                  "",
                  "",
                  "MessageWindow",
                  "诺瓦，妖怪是猫你都怕的吗？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1947,
