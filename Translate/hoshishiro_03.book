                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 711,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "にしても薪って、こんな時代に運ばないだろうし……。\nイミテーション？",
                  "",
                  "",
                  "MessageWindow",
                  "话说这个时代已经不运输木柴了吧……\n这是模型？",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
