              "rowIndex": 23,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "これ自体はごくごくありふれたものなんだ。",
                  "",
                  "",
                  "MessageWindow",
                  "本来就是随处可见的东西。",
                  ""
                ]
              },
