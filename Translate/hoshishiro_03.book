              "strings": {
                "Array": [
                  "",
                  "花江",
                  "<Character=花江大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "05_hanae/han0178.ogg",
                  "MessageWindow",
                  "……"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1200,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　と、花江さんの視線に気付く。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这时我觉察到花江小姐的视线。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1201,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　せっかく景色のいい、物見台にいるのに、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　明明身处风景优美的瞭望台，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1202,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　その目線は街のほうでなく、山の下のほうへ向いていた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　她的视线却不是朝向市区，而是往山上看。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1203,
              "strings": {
                "Array": [
                  "CharacterOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
