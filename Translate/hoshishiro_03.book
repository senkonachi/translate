            {
              "rowIndex": 745,
              "strings": {
                "Array": [
                  "",
                  "ジビエ",
                  "<Character=ジビエ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "04_jibie/jib0413.ogg",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 746,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　なるべく軽い調子で言った。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我尽可能用轻快的口吻说道。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 747,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　時間も空間もルールが分からない状況で\n　楽観的すぎるが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　在这种时间、空间以及运行法则都一无所知的状况下\n　说这种话过于乐观，"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
