            },
            {
              "rowIndex": 2722,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Character=カルハ大>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "ルールってなによ。",
                  "",
                  "02_karuha/kar1085.ogg",
                  "MessageWindow",
                  "规则是什么意思啊。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2723,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "お前がニャクルト片手に化け物の絵を描いてる間に\n大人は大人で色々考えてたんだよ。",
                  "",
                  "",
                  "MessageWindow",
                  "在你一边喝妙乐多一边画怪物的时候，\n我们大人对现状可是做了不少思考的。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
