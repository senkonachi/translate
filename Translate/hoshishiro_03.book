                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あの３人はすっかり仲良しになったな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　那三人已经这么要好了啊。",
                  ""
                ]
