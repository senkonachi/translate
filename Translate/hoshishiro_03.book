            },
            {
              "rowIndex": 38,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 39,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺が窓の外に目線を戻すと、\n　つられたように旅仲間も、その金色の瞳を外へ向けた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我再次望向窗外。\n　它金色的眼瞳也随我的视线转向外边。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 40,
              "strings": {
                "Array": [
                  "BgEventOff",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 41,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_空_夜",
                  "",
                  "",
                  "",
                  "",
                  "3",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 42,
              "strings": {
                "Array": [
                  "Wait",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 43,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　綺麗な星空が広がっている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　美丽的星空在眼前展开。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 44,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　キラキラして、まるで宝石箱みたいな空が。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　璀璨夺目，犹如熠熠生辉的宝石箱。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 45,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　旅に出て一番の収穫はこれだろうな。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这就是此行最大的收获了吧。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 46,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あれは、そう、小学生のころだったか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　大概，那是我上小学的时候。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 47,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 48,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　校長先生か、担任か、それとももう記憶にもない\n　どこかの誰かだったろうか。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不知道是校长还是班主任，又或是一个遗忘在脑海的人。\n　总之曾有人对我说过这样一句话。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 49,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　世界というのは、大きな宝石箱だと教えてくれた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　“这个世界就是个巨大的宝石箱。”",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 50,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_空_夜",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 51,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　キラキラと輝くもので満ちた宝石箱だと。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　璀璨夺目，犹如熠熠生辉的宝石箱。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 52,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　いま、大人になって思う。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　如今长大成人了的我才意识到。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 53,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_黒",
                  "",
                  "",
                  "",
                  "",
                  "1",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 54,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　あれは本当だ。\n　いつか子供が出来たら同じ話をしてやりたいくらい、\n　世界を的確に表していた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　他说得没有错。\n　这个比喻非常准确，等我有了后代，应该也会把这句话教给他。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 55,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　キラキラ輝く宝石箱。いまならその言葉の意味が分かる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　可讽刺的是，这熠熠生辉的宝石箱究竟蕴含着怎样的“意义”。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 56,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　皮肉なほどに。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我已然了如指掌。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 57,
              "strings": {
                "Array": [
                  "StopBgm",
                  "",
                  "",
                  "",
                  "",
