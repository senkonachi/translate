                  "真剣",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 2025,
              "strings": {
                "Array": [
                  "Tween",
                  "真白",
                  "PunchPosition",
