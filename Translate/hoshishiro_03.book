                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 62,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　・・・・・",
                  "",
                  "",
                  "MessageWindowMono",
                  "　・・・・・",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 63,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……あちぃ。",
                  "",
                  "",
                  "MessageWindow",
                  "……好热。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 64,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　うだるような暑さだった。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　热得快熟透了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 65,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　キラキラどころか、ギラギラの太陽が\n　頭上からひっきりなしに降り注いでいた。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　与其说耀眼，不如说是刺眼的阳光。\n　毫不留情地照射在我身上。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 66,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　うだるって言うのは、漢字で『茹だる』。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这个成语正适合形容现在的气温。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 67,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　茹で上がるように暑い。ってことだそうだが、",
                  "",
                  "",
                  "MessageWindowMono",
                  "　铄石流金。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 68,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　まさにそれ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　真是恰到好处。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 69,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　真上からのお日様に焼かれ、頭の中がぐらぐら言っている。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　在烈日的暴晒下，我甚至感觉脑浆都要沸腾了。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 70,
              "strings": {
                "Array": [
                  "Bgm",
                  "BGM02",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 71,
              "strings": {
                "Array": [
                  "Bg",
                  "背景_街中_昼",
                  "",
                  "",
                  "",
                  "",
                  "0.5",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 72,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　俺の住む街は、岩手県の片田舎。\n　東北地方のかなり山の近くにある。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我住在岩手县的乡下。\n　这里离东北部的山区很近。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 73,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　冬はそのほとんどが雪に覆われるような、\n　日本有数の涼しい地帯にあるのだが。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　冬季里常常白雪皑皑。\n　属于日本少见的寒冷地带。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 74,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　それでこんなに暑いなんて。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　然而现在却热得反常。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 75,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ほんと、温暖化がどうこう、心配になるね。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不禁让人愈发担心起气候变暖的问题。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 76,
              "strings": {
