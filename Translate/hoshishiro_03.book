                  "",
                  "",
                  "",
                  "",
                  "",
                  "キラキラを見てきて欲しい。",
                  "",
                  "",
                  "MessageWindow",
                  "去注视那些光芒。"
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1082,
              "strings": {
                "Array": [
                  "",
                  "真白",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
