              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　く……。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　嗯……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1795,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ダメだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　不行啊。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1796,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　この世界のルールはひとつ。\n『ノワールの望む形』であることだけ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　这个世界的规则只有一条。\n　就是成为“诺瓦所期望的样子”。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1797,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　拒否されたら先へはいけない。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　若被拒绝，就无法前进。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1798,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　拒絶反応の強さは、さっき体験したばかりだ。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　我刚刚才体验过排异反应的强大。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1799,
              "strings": {
                "Array": [
                  "",
                  "暁",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……。",
                  "",
                  "",
                  "MessageWindow",
                  "……",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1800,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　ああ、でも。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　嗯，不过。",
                  "",
                  ""
                ]
              },
              "isEmpty": 0,
