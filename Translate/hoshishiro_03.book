              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1169,
              "strings": {
                "Array": [
                  "",
                  "カルハ",
                  "<Off>",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "なんか引っかかる言い方ね。",
                  "",
                  "02_karuha/kar0121.ogg",
                  "MessageWindow",
                  "怎么感觉你话里有话。",
