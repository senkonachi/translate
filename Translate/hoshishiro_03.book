              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 1793,
              "strings": {
                "Array": [
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "　よっぽど怖いのか、俺の服をぎゅーっと握ってる。",
                  "",
                  "",
                  "MessageWindowMono",
                  "　诺瓦紧紧地攥住了我的衣服，看起来相当害怕。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
