            },
            {
              "rowIndex": 377,
              "strings": {
                "Array": [
                  "",
                  "花江",
                  "困り",
                  "",
                  "",
                  "",
                  "",
                  "",
                  "……幼なじみが毎日管理してるはずなんだけどね。\n姿を見せなかったのは不思議だった。",
                  "",
                  "05_hanae/han0337.ogg",
                  "MessageWindow",
                  "……我的发小本应该每天都在打理那里的。没看见她还有点奇怪。",
                  ""
                ]
              },
              "isEmpty": 0,
              "isCommentOut": 0
            },
            {
              "rowIndex": 378,
              "strings": {
                "Array": [
                  "",
                  "タカセ",
                  "困り",
                  "",
                  "",
                  "",
                  "",
